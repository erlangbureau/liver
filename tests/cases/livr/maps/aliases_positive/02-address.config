#{
    input => #{
        <<"address">> => #{
            <<"city">> => <<"Kyiv">>,
            <<"street">> => <<"My street">>,
            <<"zip">> => 1232131
        },
        <<"address_custom_error">> => #{
            <<"city">> => <<"Kharkiv">>,
            <<"street">> => <<"My street">>,
            <<"zip">> => <<"12312">>
        },
        <<"extra_field">> => 12
    },
    name => address,
    output => #{
        <<"address">> => #{
            <<"city">> => <<"Kyiv">>,
            <<"street">> => <<"My street">>,
            <<"zip">> => 1232131
        },
        <<"address_custom_error">> => #{
            <<"city">> => <<"Kharkiv">>,
            <<"street">> => <<"My street">>,
            <<"zip">> => 12312
        }
    },
    opts => #{
        aliased_rules => [
            #{
                name => address,
                rules => #{
                    nested_object => #{
                        <<"city">> => #{
                            one_of => [<<"Kyiv">>, <<"Kharkiv">>]
                        },
                        <<"street">> => required,
                        <<"zip">> => [required, positive_integer]
                    }
                }
            },
            #{
                error => <<"WRONG_ADDRESS">>,
                name => address_with_custom_error,
                rules => #{
                    nested_object => #{
                        <<"city">> => #{
                            one_of => [<<"Kyiv">>, <<"Kharkiv">>]
                        },
                        <<"street">> => required,
                        <<"zip">> => [required, positive_integer]
                    }
                }
            }
        ]
    },
    rules => #{
        <<"address">> => <<"address">>,
        <<"address_custom_error">> => <<"address_with_custom_error">>
    }
}.
