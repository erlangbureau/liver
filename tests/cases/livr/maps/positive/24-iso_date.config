        <<"iso_date7">> => <<"2000-02-29">>,
        <<"iso_date8">> => <<"1582-10-10">>
    },
    name => iso_date,
    output => #{
        <<"empty_field">> => <<>>,
        <<"iso_date1">> => {2014, 2, 18},
        <<"iso_date2">> => {1930, 3, 30},
        <<"iso_date3">> => {1930, 1, 1},
        <<"iso_date4">> => {1970, 1, 1},
        <<"iso_date5">> => {2015, 10, 10},
        <<"iso_date6">> => {2024, 2, 29},
        <<"iso_date7">> => {2000, 2, 29},
        <<"iso_date8">> => {1582, 10, 10}
    },
    rules => #{
        <<"empty_field">> => iso_date,
        <<"iso_date1">> => iso_date,
        <<"iso_date2">> => #{
            iso_date => []
        },
        <<"iso_date3">> => [
            #{
                iso_date => []
            }
        ],
        <<"iso_date4">> => [
            #{
                iso_date => []
            }
        ],
        <<"iso_date5">> => iso_date,
        <<"iso_date6">> => iso_date,
        <<"iso_date7">> => iso_date,
        <<"iso_date8">> => iso_date
    }
