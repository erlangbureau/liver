%% LIVR positive/05-max_length (case: max_length, form: maps)
%% Source: https://github.com/koorchik/LIVR/tree/4384f09e60d758d5c3ef3c76e8a29eac8ec688a0/test_suite/positive/05-max_length
%% Imported for liver; iso_date outputs use Erlang {Y,M,D} dates.
%% Proplist fixtures preserve JSON key order from json:decode/3.

#{
    input => #{
        <<"decimal">> => 1.2,
        <<"empty_name">> => <<>>,
        <<"extra_name">> => <<"extra_name">>,
        <<"first_name">> => <<"Васек"/utf8>>,
        <<"last_name">> => <<"Pupkin">>,
        <<"middle_name">> => <<"Some name">>,
        <<"number1">> => 1111
    },
    name => max_length,
    output => #{
        <<"decimal">> => <<"1.2">>,
        <<"empty_name">> => <<>>,
        <<"first_name">> => <<"Васек"/utf8>>,
        <<"last_name">> => <<"Pupkin">>,
        <<"middle_name">> => <<"Some name">>,
        <<"number1">> => <<"1111">>
    },
    rules => #{
        <<"decimal">> => #{
            max_length => 3
        },
        <<"empty_name">> => #{
            max_length => 3
        },
        <<"first_name">> => #{
            max_length => 5
        },
        <<"last_name">> => #{
            max_length => [10]
        },
        <<"middle_name">> => [
            #{
                max_length => [10]
            }
        ],
        <<"missed_name">> => #{
            max_length => 3
        },
        <<"number1">> => #{
            max_length => 5
        }
    }
}.
