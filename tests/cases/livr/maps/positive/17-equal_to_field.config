%% LIVR positive/17-equal_to_field (case: equal_to_field, form: maps)
%% Source: https://github.com/koorchik/LIVR/tree/14e5a1b19011d3e9bf6ab5a6a0dd4444bea8b280/test_suite/positive/17-equal_to_field
%% Imported for liver; iso_date outputs use Erlang {Y,M,D} dates.
%% Proplist fixtures preserve JSON key order from json:decode/3.

#{
    input => #{
        <<"empty_field">> => <<>>,
        <<"extra_field">> => <<"some value">>,
        <<"field1">> => <<"some value">>,
        <<"field2">> => <<"some value">>,
        <<"field3">> => <<"some value">>,
        <<"number_as_number">> => 10,
        <<"number_as_string">> => <<"10">>
    },
    name => equal_to_field,
    output => #{
        <<"empty_field">> => <<>>,
        <<"field1">> => <<"some value">>,
        <<"field2">> => <<"some value">>,
        <<"field3">> => <<"some value">>,
        <<"number_as_string">> => <<"10">>
    },
    rules => #{
        <<"empty_field">> => #{
            equal_to_field => <<"field2">>
        },
        <<"field1">> => #{
            equal_to_field => <<"field2">>
        },
        <<"field2">> => #{
            equal_to_field => [<<"field1">>]
        },
        <<"field3">> => #{
            equal_to_field => [<<"field1">>]
        },
        <<"number_as_string">> => #{
            equal_to_field => <<"number_as_number">>
        }
    }
}.
