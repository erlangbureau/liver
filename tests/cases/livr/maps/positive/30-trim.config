    input => #{
        <<"decimal_value">> => 1.2,
        <<"list_of_string_values">> => [
            <<" value1 ">>,
            #{
                <<"key">> => <<"123">>
            },
            <<" value2 ">>
        ],
        <<"object">> => #{
            <<"string_value">> => <<" some value ">>
        },
        <<"string_value">> => <<" value ">>,
        <<"unicode_string">> => <<" Привет "/utf8>>
    },
    name => trim,
    output => #{
        <<"decimal_value">> => <<"1.2">>,
        <<"list_of_string_values">> => [
            <<"value1">>,
            #{
                <<"key">> => <<"123">>
            },
            <<"value2">>
        ],
        <<"object">> => #{
            <<"string_value">> => <<"some value">>
        },
        <<"string_value">> => <<"value">>,
        <<"unicode_string">> => <<"Привет"/utf8>>
    },
    rules => #{
        <<"decimal_value">> => [trim],
        <<"list_of_string_values">> => #{
            list_of => trim
        },
        <<"object">> => #{
            nested_object => #{
                <<"string_value">> => trim
            }
        },
        <<"string_value">> => trim,
        <<"unicode_string">> => trim
    }
