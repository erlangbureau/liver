%% Imported for liver; iso_date outputs use Erlang {Y,M,D} dates.
%% Proplist fixtures preserve JSON key order from json:decode/3.

#{
    input => #{
        <<"empty_name">> => <<>>,
        <<"extra_name">> => <<"extra_name">>,
        <<"first_name">> => <<"Vasya">>,
        <<"last_name">> => <<"Pupkin">>,
        <<"middle_name">> => <<"Some name">>,
        <<"number1">> => 1111
    },
    name => length_equal,
    output => #{
        <<"empty_name">> => <<>>,
        <<"first_name">> => <<"Vasya">>,
        <<"last_name">> => <<"Pupkin">>,
        <<"middle_name">> => <<"Some name">>,
        <<"number1">> => <<"1111">>
    },
    rules => #{
        <<"empty_name">> => #{
            length_equal => 3
        },
        <<"first_name">> => #{
            length_equal => 5
        },
        <<"last_name">> => #{
            length_equal => [6]
        },
        <<"middle_name">> => [
            #{
                length_equal => [9]
            }
        ],
        <<"missed_name">> => #{
            length_equal => 3
        },
        <<"number1">> => #{
            length_equal => 4
        }
    }
}.
