%% Imported for liver; iso_date outputs use Erlang {Y,M,D} dates.
%% Proplist fixtures preserve JSON key order from jsx:decode/1.

#{
    input => #{
        <<"decimal_value">> => 1.2,
        <<"list_of_string_values">> => [
            <<"value1">>,
            #{
                <<"key">> => <<"123">>
            },
            <<"value2">>
        ],
        <<"object">> => #{
            <<"string_value">> => <<"Some Value">>
        },
        <<"string_value">> => <<"Value">>,
        <<"unicode_string">> => <<"привет"/utf8>>
    },
    name => to_uc,
    output => #{
        <<"decimal_value">> => <<"1.2">>,
        <<"list_of_string_values">> => [
            <<"VALUE1">>,
            #{
                <<"key">> => <<"123">>
            },
            <<"VALUE2">>
        ],
        <<"object">> => #{
            <<"string_value">> => <<"SOME VALUE">>
        },
        <<"string_value">> => <<"VALUE">>,
        <<"unicode_string">> => <<"ПРИВЕТ"/utf8>>
    },
    rules => #{
        <<"decimal_value">> => [to_uc],
        <<"list_of_string_values">> => #{
            list_of => to_uc
        },
        <<"object">> => #{
            nested_object => #{
                <<"string_value">> => to_uc
            }
        },
        <<"string_value">> => to_uc,
        <<"unicode_string">> => to_uc
    }
}.
