%% Imported for liver; iso_date outputs use Erlang {Y,M,D} dates.
%% Proplist fixtures preserve JSON key order from json:decode/3.

#{
    input => #{
        <<"age">> => <<"25">>,
        <<"first_name">> => <<"Vasya">>,
        <<"last_name">> => null,
        <<"salary">> => 0
    },
    name => not_empty,
    output => #{
        <<"first_name">> => <<"Vasya">>,
        <<"last_name">> => null,
        <<"salary">> => 0
    },
    rules => #{
        <<"first_name">> => not_empty,
        <<"last_name">> => [not_empty],
        <<"middle_name">> => [
            #{
                not_empty => []
            }
        ],
        <<"salary">> => #{
            required => []
        }
    }
}.
