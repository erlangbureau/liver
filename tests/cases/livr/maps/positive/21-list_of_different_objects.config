                <<"name">> => <<"service1">>,
                <<"product_type">> => <<"service">>
            }
        ]
    },
    name => list_of_different_objects,
    output => #{
        <<"empty_list">> => [],
        <<"order_id">> => 10,
        <<"products">> => [
            #{
                <<"material_id">> => 12,
                <<"product_type">> => <<"material">>,
                <<"quantity">> => 11
            },
            #{
                <<"material_id">> => 100,
