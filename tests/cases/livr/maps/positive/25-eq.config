        <<"city1">> => <<"Lviv">>,
        <<"city2">> => <<"Kyiv">>,
        <<"city3">> => <<"Kyiv">>,
        <<"city4">> => <<"Dnipro">>,
        <<"empty_city">> => <<>>,
        <<"extra_city">> => <<"New York">>,
        <<"number1">> => <<"2">>,
        <<"number2">> => 2
    },
    name => eq,
    output => #{
        <<"city1">> => <<"Lviv">>,
        <<"city2">> => <<"Kyiv">>,
        <<"city3">> => <<"Kyiv">>,
        <<"city4">> => <<"Dnipro">>,
        <<"empty_city">> => <<>>,
        <<"number1">> => 2,
        <<"number2">> => <<"2">>
    },
    rules => #{
        <<"city1">> => #{
            eq => <<"Lviv">>
        },
        <<"city2">> => [
            #{
                eq => <<"Kyiv">>
            }
        ],
        <<"city3">> => #{
            eq => <<"Kyiv">>
        },
        <<"city4">> => [
            #{
                eq => [<<"Dnipro">>]
            }
        ],
        <<"empty_city">> => #{
            eq => <<"Kyiv">>
        },
        <<"number1">> => #{
            eq => 2
        },
        <<"number2">> => #{
            eq => <<"2">>
        }
    }
}.
