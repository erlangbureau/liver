%% Imported for liver; iso_date outputs use Erlang {Y,M,D} dates.
%% Proplist fixtures preserve JSON key order from json:decode/3.

#{
    input => #{
        <<"city1">> => <<"Moscow">>,
        <<"city2">> => <<"Kiev">>,
        <<"city3">> => <<"Kiev">>,
        <<"city4">> => <<"Dnipro">>,
        <<"empty_city">> => <<>>,
        <<"extra_city">> => <<"New York">>,
        <<"number1">> => <<"2">>,
        <<"number2">> => 2
    },
    name => eq,
    output => #{
        <<"city1">> => <<"Moscow">>,
        <<"city2">> => <<"Kiev">>,
        <<"city3">> => <<"Kiev">>,
        <<"city4">> => <<"Dnipro">>,
        <<"empty_city">> => <<>>,
        <<"number1">> => 2,
        <<"number2">> => <<"2">>
    },
    rules => #{
        <<"city1">> => #{
            eq => <<"Moscow">>
        },
        <<"city2">> => [
            #{
                eq => <<"Kiev">>
            }
        ],
        <<"city3">> => #{
            eq => <<"Kiev">>
        },
        <<"city4">> => [
            #{
                eq => [<<"Dnipro">>]
            }
        ],
        <<"empty_city">> => #{
            eq => <<"Kiev">>
        },
        <<"number1">> => #{
            eq => 2
        },
        <<"number2">> => #{
            eq => <<"2">>
        }
    }
}.
