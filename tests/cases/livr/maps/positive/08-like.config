%% LIVR positive/08-like (case: like, form: maps)
%% Source: https://github.com/koorchik/LIVR/tree/4384f09e60d758d5c3ef3c76e8a29eac8ec688a0/test_suite/positive/08-like
%% Imported for liver; iso_date outputs use Erlang {Y,M,D} dates.
%% Proplist fixtures preserve JSON key order from json:decode/3.

#{
    input => #{
        <<"age">> => 35,
        <<"empty_name">> => <<>>,
        <<"extra_name">> => <<"extra_name">>,
        <<"first_name">> => <<"Vasya">>,
        <<"last_name">> => <<"Pupkin">>,
        <<"middle_name">> => <<"Ivanovich">>
    },
    name => like,
    output => #{
        <<"age">> => <<"35">>,
        <<"empty_name">> => <<>>,
        <<"first_name">> => <<"Vasya">>,
        <<"last_name">> => <<"Pupkin">>,
        <<"middle_name">> => <<"Ivanovich">>
    },
    rules => #{
        <<"age">> => [
            #{
                like => <<"^[0-9]+$">>
            }
        ],
        <<"empty_name">> => #{
            like => <<"[A-Za-z]">>
        },
        <<"first_name">> => #{
            like => <<"[A-Za-z]+">>
        },
        <<"last_name">> => #{
            like => [<<"^[A-Za-z]+$">>]
        },
        <<"middle_name">> => #{
            like => [<<"^[a-z]+$">>, <<"i">>]
        },
        <<"missed_name">> => #{
            like => <<"[A-Za-z]">>
        }
    }
}.
