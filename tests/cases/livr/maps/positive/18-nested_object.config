%% LIVR positive/18-nested_object (case: nested_object, form: maps)
%% Source: https://github.com/koorchik/LIVR/tree/14e5a1b19011d3e9bf6ab5a6a0dd4444bea8b280/test_suite/positive/18-nested_object
%% Imported for liver; iso_date outputs use Erlang {Y,M,D} dates.
%% Proplist fixtures preserve JSON key order from json:decode/3.

#{
    input => #{
        <<"address">> => #{
            <<"building">> => <<"10">>,
            <<"country">> => <<"Ukraine">>,
            <<"extra_field">> => <<"will be removed">>,
            <<"street">> => <<"10">>,
            <<"zip">> => <<"12345">>
        },
        <<"builtin_names">> => #{
            <<"constructor">> => <<"Constructor value">>,
            <<"hasOwnProperty">> => <<"will be removed">>,
            <<"toString">> => <<"ToString value">>
        },
        <<"extra_field">> => <<"will be removed">>,
        <<"null_value">> => null,
        <<"should_be_empty">> => #{
            <<"extra_field">> => <<"will be removed">>
        },
        <<"should_not_be_errored">> => <<>>
    },
    name => nested_object,
    output => #{
        <<"address">> => #{
            <<"building">> => 10,
            <<"country">> => <<"Ukraine">>,
            <<"street">> => <<"10">>,
            <<"zip">> => 12345
        },
        <<"builtin_names">> => #{
            <<"constructor">> => <<"Constructor value">>,
            <<"toString">> => <<"ToString value">>
        },
        <<"null_value">> => null,
        <<"should_be_empty">> => #{},
        <<"should_not_be_errored">> => <<>>
    },
    rules => #{
        <<"address">> => [
            required,
            #{
                nested_object => #{
                    <<"building">> => [required, positive_integer],
                    <<"country">> => [
                        required,
                        #{
                            one_of => [
                                [<<"Ukraine">>, <<"USA">>]
                            ]
                        }
                    ],
                    <<"street">> => required,
                    <<"zip">> => positive_integer
                }
            }
        ],
        <<"builtin_names">> => #{
            nested_object => #{
                <<"constructor">> => required,
                <<"toString">> => required
            }
        },
        <<"null_value">> => #{
            nested_object => #{
                <<"zip">> => required
            }
        },
        <<"should_be_empty">> => [
            required,
            #{
                nested_object => #{
                    <<"country">> => [
                        #{
                            one_of => [
                                [<<"Ukraine">>, <<"USA">>]
                            ]
                        }
                    ],
                    <<"zip">> => positive_integer
                }
            }
        ],
        <<"should_not_be_errored">> => #{
            nested_object => #{
                <<"zip">> => positive_integer
            }
        }
    }
}.
