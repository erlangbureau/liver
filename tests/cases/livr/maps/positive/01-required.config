    name => required,
    output => #{
        <<"constructor">> => <<"Constructor value">>,
        <<"first_name">> => <<"Vasya">>,
        <<"hasOwnProperty">> => <<"HasOwnProperty value">>,
        <<"last_name">> => <<"Pupkin">>,
        <<"middle_name">> => <<"Some">>,
        <<"salary">> => 0,
