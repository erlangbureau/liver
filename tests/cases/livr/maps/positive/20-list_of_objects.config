#{
    input => #{
        <<"empty_list">> => [],
        <<"products">> => [
            #{
                <<"product_id">> => 10,
                <<"quantity">> => <<"10">>
            },
            #{
                <<"product_id">> => 20,
                <<"quantity">> => 20
            },
            #{
                <<"product_id">> => 30,
                <<"quantity">> => 30
            }
        ]
    },
    name => list_of_objects,
    output => #{
        <<"empty_list">> => [],
        <<"products">> => [
            #{
                <<"product_id">> => 10,
                <<"quantity">> => 10
            },
            #{
                <<"product_id">> => 20,
                <<"quantity">> => 20
            },
            #{
                <<"product_id">> => 30,
                <<"quantity">> => 30
            }
        ]
    },
    rules => #{
        <<"empty_list">> => [
            #{
                list_of_objects => #{
                    <<"some_field">> => [required]
                }
            }
        ],
        <<"products">> => [
            required,
            #{
                list_of_objects => #{
                    <<"product_id">> => [required, positive_integer],
                    <<"quantity">> => [required, positive_integer]
                }
            }
        ]
    }
}.
