%% LIVR negative/17-equal_to_field (case: equal_to_field, form: maps)
%% Source: https://github.com/koorchik/LIVR/tree/14e5a1b19011d3e9bf6ab5a6a0dd4444bea8b280/test_suite/negative/17-equal_to_field
%% Imported for liver; iso_date outputs use Erlang {Y,M,D} dates.
%% Proplist fixtures preserve JSON key order from json:decode/3.

#{
    input => #{
        <<"empty_field">> => <<>>,
        <<"extra_field">> => <<"some value">>,
        <<"field1">> => <<"some value1">>,
        <<"field2">> => <<"some value">>,
        <<"field3">> => <<"some value">>,
        <<"missing_other_field">> => <<"some value">>,
        <<"number">> => <<"10">>,
        <<"same_number_exponent">> => <<"1e1">>,
        <<"same_number_leading_zero">> => <<"010">>,
        <<"same_number_space">> => <<" 10">>,
        <<"value_is_array">> => [<<"test">>, 1],
        <<"value_is_empty_array">> => [],
        <<"value_is_empty_hash">> => #{},
        <<"value_is_hash">> => #{
            <<"test">> => 1
        }
    },
    name => equal_to_field,
    rules => #{
        <<"empty_field">> => #{
            equal_to_field => <<"field2">>
        },
        <<"field1">> => #{
            equal_to_field => <<"field2">>
        },
        <<"field2">> => #{
            equal_to_field => [<<"field1">>]
        },
        <<"field3">> => #{
            equal_to_field => [<<"field1">>]
        },
        <<"missing_other_field">> => #{
            equal_to_field => <<"missing_field">>
        },
        <<"same_number_exponent">> => #{
            equal_to_field => <<"number">>
        },
        <<"same_number_leading_zero">> => #{
            equal_to_field => <<"number">>
        },
        <<"same_number_space">> => #{
            equal_to_field => <<"number">>
        },
        <<"value_is_array">> => #{
            equal_to_field => <<"field2">>
        },
        <<"value_is_empty_array">> => #{
            equal_to_field => <<"field2">>
        },
        <<"value_is_empty_hash">> => #{
            equal_to_field => <<"field2">>
        },
        <<"value_is_hash">> => #{
            equal_to_field => <<"field2">>
        }
    },
    errors => #{
        <<"field1">> => <<"FIELDS_NOT_EQUAL">>,
        <<"field2">> => <<"FIELDS_NOT_EQUAL">>,
        <<"field3">> => <<"FIELDS_NOT_EQUAL">>,
        <<"missing_other_field">> => <<"FIELDS_NOT_EQUAL">>,
        <<"same_number_exponent">> => <<"FIELDS_NOT_EQUAL">>,
        <<"same_number_leading_zero">> => <<"FIELDS_NOT_EQUAL">>,
        <<"same_number_space">> => <<"FIELDS_NOT_EQUAL">>,
        <<"value_is_array">> => <<"FORMAT_ERROR">>,
        <<"value_is_empty_array">> => <<"FORMAT_ERROR">>,
        <<"value_is_empty_hash">> => <<"FORMAT_ERROR">>,
        <<"value_is_hash">> => <<"FORMAT_ERROR">>
    }
}.
