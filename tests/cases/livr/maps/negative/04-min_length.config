%% LIVR negative/04-min_length (case: min_length, form: maps)
%% Source: https://github.com/koorchik/LIVR/tree/4384f09e60d758d5c3ef3c76e8a29eac8ec688a0/test_suite/negative/04-min_length
%% Imported for liver; iso_date outputs use Erlang {Y,M,D} dates.
%% Proplist fixtures preserve JSON key order from json:decode/3.

#{
    input => #{
        <<"empty_name">> => <<>>,
        <<"extra_name">> => <<"extra_name">>,
        <<"first_name">> => <<"Vasya">>,
        <<"last_name">> => <<"Pupkin">>,
        <<"middle_name">> => <<"Some name">>,
        <<"value_is_array">> => [<<"test">>, 1],
        <<"value_is_empty_array">> => [],
        <<"value_is_empty_hash">> => #{},
        <<"value_is_hash">> => #{
            <<"test">> => 1
        }
    },
    name => min_length,
    rules => #{
        <<"empty_name">> => #{
            min_length => 3
        },
        <<"first_name">> => #{
            min_length => 6
        },
        <<"last_name">> => #{
            min_length => [10]
        },
        <<"middle_name">> => [
            #{
                min_length => [10]
            }
        ],
        <<"value_is_array">> => #{
            min_length => 6
        },
        <<"value_is_empty_array">> => #{
            min_length => 6
        },
        <<"value_is_empty_hash">> => #{
            min_length => 6
        },
        <<"value_is_hash">> => #{
            min_length => 6
        }
    },
    errors => #{
        <<"first_name">> => <<"TOO_SHORT">>,
        <<"last_name">> => <<"TOO_SHORT">>,
        <<"middle_name">> => <<"TOO_SHORT">>,
        <<"value_is_array">> => <<"FORMAT_ERROR">>,
        <<"value_is_empty_array">> => <<"FORMAT_ERROR">>,
        <<"value_is_empty_hash">> => <<"FORMAT_ERROR">>,
        <<"value_is_hash">> => <<"FORMAT_ERROR">>
    }
}.
