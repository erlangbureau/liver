        },
        <<"age">> => <<"25">>,
        <<"first_name">> => <<>>,
        <<"last_name">> => null,
        <<"value_is_array">> => [<<"test">>, 1],
        <<"value_is_empty_array">> => [],
        <<"value_is_empty_hash">> => #{},
        <<"value_is_hash">> => #{
            <<"test">> => 1
        }
    },
    name => required,
    rules => #{
        <<"constructor">> => required,
        <<"first_name">> => required,
        <<"hasOwnProperty">> => required,
        <<"last_name">> => [required],
        <<"middle_name">> => [
            #{
                required => []
            }
        ],
        <<"toString">> => required,
        <<"value_is_array">> => required,
        <<"value_is_empty_array">> => required,
        <<"value_is_empty_hash">> => required,
        <<"value_is_hash">> => required
    },
    errors => #{
        <<"constructor">> => <<"REQUIRED">>,
        <<"first_name">> => <<"REQUIRED">>,
        <<"hasOwnProperty">> => <<"REQUIRED">>,
        <<"last_name">> => <<"REQUIRED">>,
        <<"middle_name">> => <<"REQUIRED">>,
