%% Imported for liver; iso_date outputs use Erlang {Y,M,D} dates.
%% Proplist fixtures preserve JSON key order from json:decode/3.

#{
    input => #{
        <<"products">> => [
            #{
                <<"product_id">> => 0,
                <<"quantity">> => <<>>
            },
            #{
                <<"product_id">> => 100,
                <<"quantity">> => 10
            },
            #{
                <<"product_id">> => -10,
                <<"quantity">> => 10
            },
            <<"Some Wrong Data">>
        ],
        <<"users">> => <<"not an array">>
    },
    name => list_of_objects,
    rules => #{
        <<"products">> => [
            required,
            #{
                list_of_objects => #{
                    <<"product_id">> => [required, positive_integer],
                    <<"quantity">> => [required, positive_integer]
                }
            }
        ],
        <<"users">> => #{
            list_of_objects => #{
                <<"name">> => required
            }
        }
    },
    errors => #{
        <<"products">> => [
            #{
                <<"product_id">> => <<"NOT_POSITIVE_INTEGER">>,
                <<"quantity">> => <<"REQUIRED">>
            },
            null,
            #{
                <<"product_id">> => <<"NOT_POSITIVE_INTEGER">>
            },
            <<"FORMAT_ERROR">>
        ],
        <<"users">> => <<"FORMAT_ERROR">>
    }
}.
