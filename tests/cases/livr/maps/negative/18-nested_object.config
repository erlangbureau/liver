%% LIVR negative/18-nested_object (case: nested_object, form: maps)
%% Source: https://github.com/koorchik/LIVR/tree/14e5a1b19011d3e9bf6ab5a6a0dd4444bea8b280/test_suite/negative/18-nested_object
%% Imported for liver; iso_date outputs use Erlang {Y,M,D} dates.
%% Proplist fixtures preserve JSON key order from json:decode/3.

#{
    input => #{
        <<"address">> => #{
            <<"building">> => <<"-10">>,
            <<"country">> => <<"Poland">>,
            <<"street">> => <<>>,
            <<"zip">> => <<"AAA">>
        },
        <<"address2">> => <<"Should be hash">>
    },
    name => nested_object,
    rules => #{
        <<"address">> => [
            required,
            #{
                nested_object => #{
                    <<"building">> => [required, positive_integer],
                    <<"country">> => [
                        required,
                        #{
                            one_of => [
                                [<<"Ukraine">>, <<"USA">>]
                            ]
                        }
                    ],
                    <<"street">> => required,
                    <<"zip">> => positive_integer
                }
            }
        ],
        <<"address2">> => #{
            nested_object => #{
                <<"country">> => required
            }
        }
    },
    errors => #{
        <<"address">> => #{
            <<"building">> => <<"NOT_POSITIVE_INTEGER">>,
            <<"country">> => <<"NOT_ALLOWED_VALUE">>,
            <<"street">> => <<"REQUIRED">>,
            <<"zip">> => <<"NOT_POSITIVE_INTEGER">>
        },
        <<"address2">> => <<"FORMAT_ERROR">>
    }
}.
