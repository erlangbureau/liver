%% LIVR negative/25-eq (case: eq, form: maps)
%% Source: https://github.com/koorchik/LIVR/tree/4384f09e60d758d5c3ef3c76e8a29eac8ec688a0/test_suite/negative/25-eq
%% Imported for liver; iso_date outputs use Erlang {Y,M,D} dates.
%% Proplist fixtures preserve JSON key order from json:decode/3.

#{
    input => #{
        <<"city1">> => <<"New York">>,
        <<"city2">> => <<"New York">>,
        <<"city3">> => <<"New York">>,
        <<"empty_string">> => <<"      ">>,
        <<"extra_city">> => <<"New York">>,
        <<"number1">> => <<"1.0">>,
        <<"number2">> => <<"asdasd">>,
        <<"number3">> => <<"      _">>,
        <<"value_is_array">> => [<<"test">>, 1],
        <<"value_is_empty_array">> => [],
        <<"value_is_empty_hash">> => #{},
        <<"value_is_hash">> => #{
            <<"test">> => 1
        }
    },
    name => eq,
    rules => #{
        <<"city1">> => #{
            eq => <<"Lviv">>
        },
        <<"city2">> => [
            #{
                eq => <<"Lviv">>
            }
        ],
        <<"city3">> => #{
            eq => <<"Kyiv">>
        },
        <<"empty_string">> => #{
            eq => 1
        },
        <<"number1">> => #{
            eq => 1
        },
        <<"number2">> => #{
            eq => 1
        },
        <<"number3">> => #{
            eq => 1.2
        },
        <<"value_is_array">> => #{
            eq => <<"Lviv">>
        },
        <<"value_is_empty_array">> => #{
            eq => <<"Lviv">>
        },
        <<"value_is_empty_hash">> => #{
            eq => <<"Lviv">>
        },
        <<"value_is_hash">> => #{
            eq => <<"Lviv">>
        }
    },
    errors => #{
        <<"city1">> => <<"NOT_ALLOWED_VALUE">>,
        <<"city2">> => <<"NOT_ALLOWED_VALUE">>,
        <<"city3">> => <<"NOT_ALLOWED_VALUE">>,
        <<"empty_string">> => <<"NOT_ALLOWED_VALUE">>,
        <<"number1">> => <<"NOT_ALLOWED_VALUE">>,
        <<"number2">> => <<"NOT_ALLOWED_VALUE">>,
        <<"number3">> => <<"NOT_ALLOWED_VALUE">>,
        <<"value_is_array">> => <<"FORMAT_ERROR">>,
        <<"value_is_empty_array">> => <<"FORMAT_ERROR">>,
        <<"value_is_empty_hash">> => <<"FORMAT_ERROR">>,
        <<"value_is_hash">> => <<"FORMAT_ERROR">>
    }
}.
