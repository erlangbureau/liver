%% LIVR negative/02-not_empty (case: not_empty, form: maps)
%% Source: https://github.com/koorchik/LIVR/tree/4384f09e60d758d5c3ef3c76e8a29eac8ec688a0/test_suite/negative/02-not_empty
%% Imported for liver; iso_date outputs use Erlang {Y,M,D} dates.
%% Proplist fixtures preserve JSON key order from json:decode/3.

#{
    input => #{
        <<"age">> => <<"25">>,
        <<"first_name">> => <<>>,
        <<"last_name">> => null,
        <<"value_is_array">> => [<<"test">>, 1],
        <<"value_is_empty_array">> => [],
        <<"value_is_empty_hash">> => #{},
        <<"value_is_hash">> => #{
            <<"test">> => 1
        }
    },
    name => not_empty,
    rules => #{
        <<"first_name">> => not_empty,
        <<"last_name">> => [not_empty],
        <<"middle_name">> => [
            #{
                not_empty => []
            }
        ],
        <<"value_is_array">> => not_empty,
        <<"value_is_empty_array">> => not_empty,
        <<"value_is_empty_hash">> => not_empty,
        <<"value_is_hash">> => not_empty
    },
    errors => #{
        <<"first_name">> => <<"CANNOT_BE_EMPTY">>
    }
}.
