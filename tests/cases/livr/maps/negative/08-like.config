%% LIVR negative/08-like (case: like, form: maps)
%% Source: https://github.com/koorchik/LIVR/tree/44f0453b2cff7fdbb23c6cf48abe29fa8c601bf8/test_suite/negative/08-like
%% Imported for liver; iso_date outputs use Erlang {Y,M,D} dates.
%% Proplist fixtures preserve JSON key order from json:decode/3.

#{
    input => #{
        <<"age">> => <<"35">>,
        <<"empty_name">> => <<>>,
        <<"extra_name">> => <<"extra_name">>,
        <<"first_name">> => <<"Vasya">>,
        <<"last_name">> => <<"Pupkin">>,
        <<"middle_name">> => <<"Ivanovich">>,
        <<"value_is_array">> => [<<"test">>, 1],
        <<"value_is_empty_array">> => [],
        <<"value_is_empty_hash">> => #{},
        <<"value_is_hash">> => #{
            <<"test">> => 1
        }
    },
    name => like,
    rules => #{
        <<"age">> => [
            #{
                like => <<"^[a-z]+$">>
            }
        ],
        <<"empty_name">> => #{
            like => <<"[A-Za-z]">>
        },
        <<"first_name">> => #{
            like => <<"[0-9]+">>
        },
        <<"last_name">> => #{
            like => [<<"^[A-Z]+$">>]
        },
        <<"middle_name">> => #{
            like => [<<"^[b-z]+$">>, <<"i">>]
        },
        <<"value_is_array">> => #{
            like => <<"[0-9]+">>
        },
        <<"value_is_empty_array">> => #{
            like => <<"[0-9]+">>
        },
        <<"value_is_empty_hash">> => #{
            like => <<"[0-9]+">>
        },
        <<"value_is_hash">> => #{
            like => <<"[0-9]+">>
        }
    },
    errors => #{
        <<"age">> => <<"WRONG_FORMAT">>,
        <<"first_name">> => <<"WRONG_FORMAT">>,
        <<"last_name">> => <<"WRONG_FORMAT">>,
        <<"middle_name">> => <<"WRONG_FORMAT">>,
        <<"value_is_array">> => <<"FORMAT_ERROR">>,
        <<"value_is_empty_array">> => <<"FORMAT_ERROR">>,
        <<"value_is_empty_hash">> => <<"FORMAT_ERROR">>,
        <<"value_is_hash">> => <<"FORMAT_ERROR">>
    }
}.
