%% LIVR negative/18-nested_object (case: nested_object, form: proplists)
%% Source: https://github.com/koorchik/LIVR/tree/4384f09e60d758d5c3ef3c76e8a29eac8ec688a0/test_suite/negative/18-nested_object
%% Imported for liver; iso_date outputs use Erlang {Y,M,D} dates.
%% Proplist fixtures preserve JSON key order from json:decode/3.

[
    {name, nested_object},
    {rules, [
        {<<"address">>, [
            required,
            [
                {nested_object, [
                    {<<"country">>, [
                        required,
                        [
                            {one_of, [
                                [<<"Ukraine">>, <<"USA">>]
                            ]}
                        ]
                    ]},
                    {<<"zip">>, positive_integer},
                    {<<"street">>, required},
                    {<<"building">>, [required, positive_integer]}
                ]}
            ]
        ]},
        {<<"address2">>, [
            {nested_object, [
                {<<"country">>, required}
            ]}
        ]}
    ]},
    {input, [
        {<<"address">>, [
            {<<"country">>, <<"Poland">>},
            {<<"zip">>, <<"AAA">>},
            {<<"street">>, <<>>},
            {<<"building">>, <<"-10">>}
        ]},
        {<<"address2">>, <<"Should be hash">>}
    ]},
    {errors, [
        {<<"address">>, [
            {<<"country">>, <<"NOT_ALLOWED_VALUE">>},
            {<<"zip">>, <<"NOT_POSITIVE_INTEGER">>},
            {<<"street">>, <<"REQUIRED">>},
            {<<"building">>, <<"NOT_POSITIVE_INTEGER">>}
        ]},
        {<<"address2">>, <<"FORMAT_ERROR">>}
    ]}
].
