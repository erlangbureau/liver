%% LIVR negative/19-list_of (case: list_of, form: proplists)
%% Source: https://github.com/koorchik/LIVR/tree/14e5a1b19011d3e9bf6ab5a6a0dd4444bea8b280/test_suite/negative/19-list_of
%% Imported for liver; iso_date outputs use Erlang {Y,M,D} dates.
%% Proplist fixtures preserve JSON key order from json:decode/3.

[
    {name, list_of},
    {rules, [
        {<<"product_ids1">>, [
            required,
            [
                {list_of, [
                    [
                        required,
                        positive_integer,
                        [
                            {max_number, 100}
                        ]
                    ]
                ]}
            ]
        ]},
        {<<"product_ids2">>, [
            required,
            [
                {list_of, [
                    required,
                    positive_integer,
                    [
                        {max_number, 100}
                    ]
                ]}
            ]
        ]},
        {<<"product_ids3">>, [
            required,
            [
                {list_of, positive_integer}
            ]
        ]},
        {<<"user_ids">>, [
            {list_of, [
                [required]
            ]}
        ]},
        {<<"object_value">>, [
            {list_of, integer}
        ]}
    ]},
    {input, [
        {<<"product_ids1">>, [-10, <<>>, 50, 120]},
        {<<"product_ids2">>, [-10, <<>>, 50, 120]},
        {<<"product_ids3">>, [-10, <<>>, 50, 120]},
        {<<"user_ids">>, <<"not an array">>},
        {<<"object_value">>, [
            {<<"a">>, 1}
        ]}
    ]},
    {errors, [
        {<<"product_ids1">>, [<<"NOT_POSITIVE_INTEGER">>, <<"REQUIRED">>, null, <<"TOO_HIGH">>]},
        {<<"product_ids2">>, [<<"NOT_POSITIVE_INTEGER">>, <<"REQUIRED">>, null, <<"TOO_HIGH">>]},
        {<<"product_ids3">>, [<<"NOT_POSITIVE_INTEGER">>, null, null, null]},
        {<<"user_ids">>, <<"FORMAT_ERROR">>},
        {<<"object_value">>, <<"FORMAT_ERROR">>}
    ]}
].
