%% LIVR negative/13-max_number (case: max_number, form: proplists)
%% Source: https://github.com/koorchik/LIVR/tree/44f0453b2cff7fdbb23c6cf48abe29fa8c601bf8/test_suite/negative/13-max_number
%% Imported for liver; iso_date outputs use Erlang {Y,M,D} dates.
%% Proplist fixtures preserve JSON key order from json:decode/3.

[
    {name, max_number},
    {rules, [
        {<<"number1">>, [
            {max_number, 10}
        ]},
        {<<"number2">>, [
            [
                {max_number, 20}
            ]
        ]},
        {<<"empty_field">>, [
            {max_number, 40}
        ]},
        {<<"value_is_string">>, [
            {max_number, 10}
        ]},
        {<<"value_is_hash">>, [
            {max_number, 10}
        ]},
        {<<"value_is_empty_hash">>, [
            {max_number, 10}
        ]},
        {<<"value_is_array">>, [
            {max_number, 10}
        ]},
        {<<"value_is_empty_array">>, [
            {max_number, 10}
        ]}
    ]},
    {input, [
        {<<"number1">>, <<"15">>},
        {<<"number2">>, <<"25.5">>},
        {<<"empty_field">>, <<>>},
        {<<"extra_field">>, <<"100">>},
        {<<"value_is_string">>, <<"some_string">>},
        {<<"value_is_hash">>, [
            {<<"test">>, 1}
        ]},
        {<<"value_is_empty_hash">>, [{}]},
        {<<"value_is_array">>, [<<"test">>, 1]},
        {<<"value_is_empty_array">>, []}
    ]},
    {errors, [
        {<<"number1">>, <<"TOO_HIGH">>},
        {<<"number2">>, <<"TOO_HIGH">>},
        {<<"value_is_string">>, <<"NOT_NUMBER">>},
        {<<"value_is_hash">>, <<"FORMAT_ERROR">>},
        {<<"value_is_empty_hash">>, <<"FORMAT_ERROR">>},
        {<<"value_is_array">>, <<"FORMAT_ERROR">>},
        {<<"value_is_empty_array">>, <<"FORMAT_ERROR">>}
    ]}
].
