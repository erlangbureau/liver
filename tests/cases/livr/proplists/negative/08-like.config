%% LIVR negative/08-like (case: like, form: proplists)
%% Source: https://github.com/koorchik/LIVR/tree/14e5a1b19011d3e9bf6ab5a6a0dd4444bea8b280/test_suite/negative/08-like
%% Imported for liver; iso_date outputs use Erlang {Y,M,D} dates.
%% Proplist fixtures preserve JSON key order from json:decode/3.

[
    {name, like},
    {rules, [
        {<<"first_name">>, [
            {like, <<"[0-9]+">>}
        ]},
        {<<"last_name">>, [
            {like, [<<"^[A-Z]+$">>]}
        ]},
        {<<"middle_name">>, [
            {like, [<<"^[b-z]+$">>, <<"i">>]}
        ]},
        {<<"age">>, [
            [
                {like, <<"^[a-z]+$">>}
            ]
        ]},
        {<<"empty_name">>, [
            {like, <<"[A-Za-z]">>}
        ]},
        {<<"zip_trailing_newline">>, [
            {like, <<"^[0-9]{5}$">>}
        ]},
        {<<"zip_text_after_newline">>, [
            {like, <<"^[0-9]{5}$">>}
        ]},
        {<<"zip_text_before_newline">>, [
            {like, <<"^[0-9]{5}$">>}
        ]},
        {<<"code_trailing_newline">>, [
            {like, [<<"^[a-z]+$">>, <<"i">>]}
        ]},
        {<<"value_is_hash">>, [
            {like, <<"[0-9]+">>}
        ]},
        {<<"value_is_empty_hash">>, [
            {like, <<"[0-9]+">>}
        ]},
        {<<"value_is_array">>, [
            {like, <<"[0-9]+">>}
        ]},
        {<<"value_is_empty_array">>, [
            {like, <<"[0-9]+">>}
        ]}
    ]},
    {input, [
        {<<"first_name">>, <<"Vasya">>},
        {<<"last_name">>, <<"Pupkin">>},
        {<<"middle_name">>, <<"Ivanovich">>},
        {<<"age">>, <<"35">>},
        {<<"empty_name">>, <<>>},
        {<<"extra_name">>, <<"extra_name">>},
        {<<"zip_trailing_newline">>, <<"12345\n">>},
        {<<"zip_text_after_newline">>, <<"12345\n<script>">>},
        {<<"zip_text_before_newline">>, <<"<script>\n12345">>},
        {<<"code_trailing_newline">>, <<"Abc\n">>},
        {<<"value_is_hash">>, [
            {<<"test">>, 1}
        ]},
        {<<"value_is_empty_hash">>, [{}]},
        {<<"value_is_array">>, [<<"test">>, 1]},
        {<<"value_is_empty_array">>, []}
    ]},
    {errors, [
        {<<"first_name">>, <<"WRONG_FORMAT">>},
        {<<"last_name">>, <<"WRONG_FORMAT">>},
        {<<"middle_name">>, <<"WRONG_FORMAT">>},
        {<<"age">>, <<"WRONG_FORMAT">>},
        {<<"zip_trailing_newline">>, <<"WRONG_FORMAT">>},
        {<<"zip_text_after_newline">>, <<"WRONG_FORMAT">>},
        {<<"zip_text_before_newline">>, <<"WRONG_FORMAT">>},
        {<<"code_trailing_newline">>, <<"WRONG_FORMAT">>},
        {<<"value_is_hash">>, <<"FORMAT_ERROR">>},
        {<<"value_is_empty_hash">>, <<"FORMAT_ERROR">>},
        {<<"value_is_array">>, <<"FORMAT_ERROR">>},
        {<<"value_is_empty_array">>, <<"FORMAT_ERROR">>}
    ]}
].
