%% LIVR negative/10-positive_integer (case: positive_integer, form: proplists)
%% Source: https://github.com/koorchik/LIVR/tree/4384f09e60d758d5c3ef3c76e8a29eac8ec688a0/test_suite/negative/10-positive_integer
%% Imported for liver; iso_date outputs use Erlang {Y,M,D} dates.
%% Proplist fixtures preserve JSON key order from json:decode/3.

[
    {name, positive_integer},
    {rules, [
        {<<"number1">>, positive_integer},
        {<<"number2">>, [positive_integer]},
        {<<"number3">>, [
            [
                {positive_integer, []}
            ]
        ]},
        {<<"empty_field">>, positive_integer},
        {<<"value_is_string">>, positive_integer},
        {<<"value_is_hash">>, positive_integer},
        {<<"value_is_empty_hash">>, positive_integer},
        {<<"value_is_array">>, positive_integer},
        {<<"value_is_empty_array">>, positive_integer}
    ]},
    {input, [
        {<<"number1">>, <<"A">>},
        {<<"number2">>, <<"-10">>},
        {<<"number3">>, <<"0">>},
        {<<"empty_field">>, <<>>},
        {<<"extra_field">>, <<"100">>},
        {<<"value_is_string">>, <<"some_string">>},
        {<<"value_is_hash">>, [
            {<<"test">>, 1}
        ]},
        {<<"value_is_empty_hash">>, [{}]},
        {<<"value_is_array">>, [<<"test">>, 1]},
        {<<"value_is_empty_array">>, []}
    ]},
    {errors, [
        {<<"number1">>, <<"NOT_POSITIVE_INTEGER">>},
        {<<"number2">>, <<"NOT_POSITIVE_INTEGER">>},
        {<<"number3">>, <<"NOT_POSITIVE_INTEGER">>},
        {<<"value_is_string">>, <<"NOT_POSITIVE_INTEGER">>},
        {<<"value_is_hash">>, <<"FORMAT_ERROR">>},
        {<<"value_is_empty_hash">>, <<"FORMAT_ERROR">>},
        {<<"value_is_array">>, <<"FORMAT_ERROR">>},
        {<<"value_is_empty_array">>, <<"FORMAT_ERROR">>}
    ]}
].
