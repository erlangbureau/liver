%% LIVR negative/22-not_empty_list (case: not_empty_list, form: proplists)
%% Source: https://github.com/koorchik/LIVR/tree/44f0453b2cff7fdbb23c6cf48abe29fa8c601bf8/test_suite/negative/22-not_empty_list
%% Imported for liver; iso_date outputs use Erlang {Y,M,D} dates.
%% Proplist fixtures preserve JSON key order from jsx:decode/1.

[
    {name, not_empty_list},
    {rules, [
        {<<"list1">>, not_empty_list},
        {<<"list2">>, [
            [
                {not_empty_list, []}
            ]
        ]},
        {<<"not_list">>, not_empty_list},
        {<<"empty_field">>, not_empty_list},
        {<<"missed_field">>, [not_empty_list]}
    ]},
    {input, [
        {<<"list1">>, []},
        {<<"list2">>, []},
        {<<"not_list">>, [{}]},
        {<<"empty_field">>, <<>>}
    ]},
    {errors, [
        {<<"list1">>, <<"CANNOT_BE_EMPTY">>},
        {<<"list2">>, <<"CANNOT_BE_EMPTY">>},
        {<<"not_list">>, <<"FORMAT_ERROR">>},
        {<<"empty_field">>, <<"CANNOT_BE_EMPTY">>},
        {<<"missed_field">>, <<"CANNOT_BE_EMPTY">>}
    ]}
].
