%% LIVR negative/01-required (case: required, form: proplists)
%% Source: https://github.com/koorchik/LIVR/tree/44f0453b2cff7fdbb23c6cf48abe29fa8c601bf8/test_suite/negative/01-required
%% Imported for liver; iso_date outputs use Erlang {Y,M,D} dates.
%% Proplist fixtures preserve JSON key order from jsx:decode/1.

[
    {name, required},
    {rules, [
        {<<"first_name">>, required},
        {<<"last_name">>, [required]},
        {<<"middle_name">>, [
            [
                {required, []}
            ]
        ]},
        {<<"value_is_hash">>, required},
        {<<"value_is_empty_hash">>, required},
        {<<"value_is_array">>, required},
        {<<"value_is_empty_array">>, required}
    ]},
    {input, [
        {<<"first_name">>, <<>>},
        {<<"last_name">>, null},
        {<<"age">>, <<"25">>},
        {<<"value_is_hash">>, [
            {<<"test">>, 1}
        ]},
        {<<"value_is_empty_hash">>, [{}]},
        {<<"value_is_array">>, [<<"test">>, 1]},
        {<<"value_is_empty_array">>, []}
    ]},
    {errors, [
        {<<"first_name">>, <<"REQUIRED">>},
        {<<"last_name">>, <<"REQUIRED">>},
        {<<"middle_name">>, <<"REQUIRED">>}
    ]}
].
