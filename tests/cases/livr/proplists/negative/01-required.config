%% LIVR negative/01-required (case: required, form: proplists)
%% Source: https://github.com/koorchik/LIVR/tree/4384f09e60d758d5c3ef3c76e8a29eac8ec688a0/test_suite/negative/01-required
%% Imported for liver; iso_date outputs use Erlang {Y,M,D} dates.
%% Proplist fixtures preserve JSON key order from json:decode/3.

[
    {name, required},
    {rules, [
        {<<"first_name">>, required},
        {<<"last_name">>, [required]},
        {<<"middle_name">>, [
            [
                {required, []}
            ]
        ]},
        {<<"value_is_hash">>, required},
        {<<"value_is_empty_hash">>, required},
        {<<"value_is_array">>, required},
        {<<"value_is_empty_array">>, required},
        {<<"constructor">>, required},
        {<<"toString">>, required},
        {<<"hasOwnProperty">>, required}
    ]},
    {input, [
        {<<"first_name">>, <<>>},
        {<<"last_name">>, null},
        {<<"age">>, <<"25">>},
        {<<"__proto__">>, [
            {<<"middle_name">>, <<"Some">>}
        ]},
        {<<"value_is_hash">>, [
            {<<"test">>, 1}
        ]},
        {<<"value_is_empty_hash">>, [{}]},
        {<<"value_is_array">>, [<<"test">>, 1]},
        {<<"value_is_empty_array">>, []}
    ]},
    {errors, [
        {<<"first_name">>, <<"REQUIRED">>},
        {<<"last_name">>, <<"REQUIRED">>},
        {<<"middle_name">>, <<"REQUIRED">>},
        {<<"constructor">>, <<"REQUIRED">>},
        {<<"toString">>, <<"REQUIRED">>},
        {<<"hasOwnProperty">>, <<"REQUIRED">>}
    ]}
].
