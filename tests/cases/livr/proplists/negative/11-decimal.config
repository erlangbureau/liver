%% LIVR negative/11-decimal (case: decimal, form: proplists)
%% Source: https://github.com/koorchik/LIVR/tree/44f0453b2cff7fdbb23c6cf48abe29fa8c601bf8/test_suite/negative/11-decimal
%% Imported for liver; iso_date outputs use Erlang {Y,M,D} dates.
%% Proplist fixtures preserve JSON key order from jsx:decode/1.

[
    {name, decimal},
    {rules, [
        {<<"number1">>, decimal},
        {<<"number2">>, [decimal]},
        {<<"number3">>, [
            [
                {decimal, []}
            ]
        ]},
        {<<"empty_field">>, decimal},
        {<<"value_is_string">>, decimal},
        {<<"value_is_hash">>, decimal},
        {<<"value_is_empty_hash">>, decimal},
        {<<"value_is_array">>, decimal},
        {<<"value_is_empty_array">>, decimal}
    ]},
    {input, [
        {<<"number1">>, <<"A">>},
        {<<"number2">>, <<"12.12.12">>},
        {<<"number3">>, <<"1,12">>},
        {<<"empty_field">>, <<>>},
        {<<"extra_field">>, <<"100">>},
        {<<"value_is_string">>, <<"some_string">>},
        {<<"value_is_hash">>, [
            {<<"test">>, 1}
        ]},
        {<<"value_is_empty_hash">>, [{}]},
        {<<"value_is_array">>, [<<"test">>, 1]},
        {<<"value_is_empty_array">>, []}
    ]},
    {errors, [
        {<<"number1">>, <<"NOT_DECIMAL">>},
        {<<"number2">>, <<"NOT_DECIMAL">>},
        {<<"number3">>, <<"NOT_DECIMAL">>},
        {<<"value_is_string">>, <<"NOT_DECIMAL">>},
        {<<"value_is_hash">>, <<"FORMAT_ERROR">>},
        {<<"value_is_empty_hash">>, <<"FORMAT_ERROR">>},
        {<<"value_is_array">>, <<"FORMAT_ERROR">>},
        {<<"value_is_empty_array">>, <<"FORMAT_ERROR">>}
    ]}
].
