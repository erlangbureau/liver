%% LIVR negative/12-positive_decimal (case: positive_decimal, form: proplists)
%% Source: https://github.com/koorchik/LIVR/tree/4384f09e60d758d5c3ef3c76e8a29eac8ec688a0/test_suite/negative/12-positive_decimal
%% Imported for liver; iso_date outputs use Erlang {Y,M,D} dates.
%% Proplist fixtures preserve JSON key order from json:decode/3.

[
    {name, positive_decimal},
    {rules, [
        {<<"number1">>, positive_decimal},
        {<<"number2">>, [positive_decimal]},
        {<<"number3">>, [
            [
                {positive_decimal, []}
            ]
        ]},
        {<<"number4">>, [positive_decimal]},
        {<<"empty_field">>, positive_decimal},
        {<<"value_is_string">>, positive_decimal},
        {<<"value_is_hash">>, positive_decimal},
        {<<"value_is_empty_hash">>, positive_decimal},
        {<<"value_is_array">>, positive_decimal},
        {<<"value_is_empty_array">>, positive_decimal}
    ]},
    {input, [
        {<<"number1">>, <<"10.10.10">>},
        {<<"number2">>, <<"0">>},
        {<<"number3">>, -1.12},
        {<<"number4">>, <<"0.0">>},
        {<<"empty_field">>, <<>>},
        {<<"extra_field">>, <<"100">>},
        {<<"value_is_string">>, <<"some_string">>},
        {<<"value_is_hash">>, [
            {<<"test">>, 1}
        ]},
        {<<"value_is_empty_hash">>, [{}]},
        {<<"value_is_array">>, [<<"test">>, 1]},
        {<<"value_is_empty_array">>, []}
    ]},
    {errors, [
        {<<"number1">>, <<"NOT_POSITIVE_DECIMAL">>},
        {<<"number2">>, <<"NOT_POSITIVE_DECIMAL">>},
        {<<"number3">>, <<"NOT_POSITIVE_DECIMAL">>},
        {<<"number4">>, <<"NOT_POSITIVE_DECIMAL">>},
        {<<"value_is_string">>, <<"NOT_POSITIVE_DECIMAL">>},
        {<<"value_is_hash">>, <<"FORMAT_ERROR">>},
        {<<"value_is_empty_hash">>, <<"FORMAT_ERROR">>},
        {<<"value_is_array">>, <<"FORMAT_ERROR">>},
        {<<"value_is_empty_array">>, <<"FORMAT_ERROR">>}
    ]}
].
