%% LIVR negative/24-iso_date (case: iso_date, form: proplists)
%% Source: https://github.com/koorchik/LIVR/tree/4384f09e60d758d5c3ef3c76e8a29eac8ec688a0/test_suite/negative/24-iso_date
%% Imported for liver; iso_date outputs use Erlang {Y,M,D} dates.
%% Proplist fixtures preserve JSON key order from json:decode/3.

[
    {name, iso_date},
    {rules, [
        {<<"iso_date1">>, iso_date},
        {<<"iso_date2">>, [
            {iso_date, []}
        ]},
        {<<"iso_date3">>, [
            [
                {iso_date, []}
            ]
        ]},
        {<<"iso_date4">>, iso_date},
        {<<"iso_date5">>, iso_date},
        {<<"iso_date6">>, iso_date},
        {<<"iso_date7">>, iso_date},
        {<<"iso_date8">>, iso_date},
        {<<"iso_date9">>, iso_date},
        {<<"like_iso_date">>, [
            [
                {iso_date, []}
            ]
        ]},
        {<<"empty_field">>, iso_date},
        {<<"value_is_hash">>, iso_date},
        {<<"value_is_empty_hash">>, iso_date},
        {<<"value_is_array">>, iso_date},
        {<<"value_is_empty_array">>, iso_date}
    ]},
    {input, [
        {<<"iso_date1">>, <<"2014-13-10">>},
        {<<"iso_date2">>, <<"2011-02-29">>},
        {<<"iso_date3">>, <<"2014-10-10T22:22">>},
        {<<"iso_date4">>, <<"1900-02-29">>},
        {<<"iso_date5">>, <<"2024-00-10">>},
        {<<"iso_date6">>, <<"2024-01-00">>},
        {<<"iso_date7">>, <<"2024-04-31">>},
        {<<"iso_date8">>, <<"2024-1-01">>},
        {<<"iso_date9">>, <<"2024-01-01\n">>},
        {<<"like_iso_date">>, <<"aaaa-bb-cc">>},
        {<<"empty_field">>, <<>>},
        {<<"extra_field">>, <<"aaaa">>},
        {<<"value_is_hash">>, [
            {<<"test">>, 1}
        ]},
        {<<"value_is_empty_hash">>, [{}]},
        {<<"value_is_array">>, [<<"test">>, 1]},
        {<<"value_is_empty_array">>, []}
    ]},
    {errors, [
        {<<"iso_date1">>, <<"WRONG_DATE">>},
        {<<"iso_date2">>, <<"WRONG_DATE">>},
        {<<"iso_date3">>, <<"WRONG_DATE">>},
        {<<"iso_date4">>, <<"WRONG_DATE">>},
        {<<"iso_date5">>, <<"WRONG_DATE">>},
        {<<"iso_date6">>, <<"WRONG_DATE">>},
        {<<"iso_date7">>, <<"WRONG_DATE">>},
        {<<"iso_date8">>, <<"WRONG_DATE">>},
        {<<"iso_date9">>, <<"WRONG_DATE">>},
        {<<"like_iso_date">>, <<"WRONG_DATE">>},
        {<<"value_is_hash">>, <<"FORMAT_ERROR">>},
        {<<"value_is_empty_hash">>, <<"FORMAT_ERROR">>},
        {<<"value_is_array">>, <<"FORMAT_ERROR">>},
        {<<"value_is_empty_array">>, <<"FORMAT_ERROR">>}
    ]}
].
