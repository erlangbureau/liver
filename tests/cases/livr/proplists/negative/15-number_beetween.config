%% LIVR negative/15-number_beetween (case: number_between, form: proplists)
%% Source: https://github.com/koorchik/LIVR/tree/44f0453b2cff7fdbb23c6cf48abe29fa8c601bf8/test_suite/negative/15-number_beetween
%% Imported for liver; iso_date outputs use Erlang {Y,M,D} dates.
%% Proplist fixtures preserve JSON key order from jsx:decode/1.

[
    {name, number_between},
    {rules, [
        {<<"number1">>, [
            {number_between, [10, 20]}
        ]},
        {<<"number2">>, [
            [
                {number_between, [10, 20]}
            ]
        ]},
        {<<"number3">>, [
            [
                {number_between, [-10, 10]}
            ]
        ]},
        {<<"number4">>, [
            [
                {number_between, [-10, 10]}
            ]
        ]},
        {<<"empty_field">>, [
            {number_between, [10, 20]}
        ]},
        {<<"value_is_string">>, [
            {number_between, [10, 20]}
        ]},
        {<<"value_is_hash">>, [
            {number_between, [10, 20]}
        ]},
        {<<"value_is_empty_hash">>, [
            {number_between, [10, 20]}
        ]},
        {<<"value_is_array">>, [
            {number_between, [10, 20]}
        ]},
        {<<"value_is_empty_array">>, [
            {number_between, [10, 20]}
        ]}
    ]},
    {input, [
        {<<"number1">>, <<"5">>},
        {<<"number2">>, <<"40">>},
        {<<"number3">>, -40},
        {<<"number4">>, 40},
        {<<"empty_field">>, <<>>},
        {<<"extra_field">>, <<"100">>},
        {<<"value_is_string">>, <<"some_string">>},
        {<<"value_is_hash">>, [
            {<<"test">>, 1}
        ]},
        {<<"value_is_empty_hash">>, [{}]},
        {<<"value_is_array">>, [<<"test">>, 1]},
        {<<"value_is_empty_array">>, []}
    ]},
    {errors, [
        {<<"number1">>, <<"TOO_LOW">>},
        {<<"number2">>, <<"TOO_HIGH">>},
        {<<"number3">>, <<"TOO_LOW">>},
        {<<"number4">>, <<"TOO_HIGH">>},
        {<<"value_is_string">>, <<"NOT_NUMBER">>},
        {<<"value_is_hash">>, <<"FORMAT_ERROR">>},
        {<<"value_is_empty_hash">>, <<"FORMAT_ERROR">>},
        {<<"value_is_array">>, <<"FORMAT_ERROR">>},
        {<<"value_is_empty_array">>, <<"FORMAT_ERROR">>}
    ]}
].
