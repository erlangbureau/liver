%% LIVR negative/23-url (case: url, form: proplists)
%% Source: https://github.com/koorchik/LIVR/tree/44f0453b2cff7fdbb23c6cf48abe29fa8c601bf8/test_suite/negative/23-url
%% Imported for liver; iso_date outputs use Erlang {Y,M,D} dates.
%% Proplist fixtures preserve JSON key order from jsx:decode/1.

[
    {name, url},
    {rules, [
        {<<"url1">>, url},
        {<<"url2">>, [
            {url, []}
        ]},
        {<<"url3">>, [
            [
                {url, []}
            ]
        ]},
        {<<"empty_field">>, url},
        {<<"value_is_hash">>, url},
        {<<"value_is_empty_hash">>, url},
        {<<"value_is_array">>, url},
        {<<"value_is_empty_array">>, url}
    ]},
    {input, [
        {<<"url1">>, <<"www.google.com">>},
        {<<"url2">>, <<"ftp://facebook.com">>},
        {<<"url3">>, <<"http://g_oogle.com">>},
        {<<"empty_field">>, <<>>},
        {<<"extra_field">>, <<"aaaa">>},
        {<<"value_is_hash">>, [
            {<<"test">>, 1}
        ]},
        {<<"value_is_empty_hash">>, [{}]},
        {<<"value_is_array">>, [<<"test">>, 1]},
        {<<"value_is_empty_array">>, []}
    ]},
    {errors, [
        {<<"url1">>, <<"WRONG_URL">>},
        {<<"url2">>, <<"WRONG_URL">>},
        {<<"url3">>, <<"WRONG_URL">>},
        {<<"value_is_hash">>, <<"FORMAT_ERROR">>},
        {<<"value_is_empty_hash">>, <<"FORMAT_ERROR">>},
        {<<"value_is_array">>, <<"FORMAT_ERROR">>},
        {<<"value_is_empty_array">>, <<"FORMAT_ERROR">>}
    ]}
].
