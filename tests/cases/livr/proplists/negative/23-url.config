%% LIVR negative/23-url (case: url, form: proplists)
%% Source: https://github.com/koorchik/LIVR/tree/14e5a1b19011d3e9bf6ab5a6a0dd4444bea8b280/test_suite/negative/23-url
%% Imported for liver; iso_date outputs use Erlang {Y,M,D} dates.
%% Proplist fixtures preserve JSON key order from json:decode/3.

[
    {name, url},
    {rules, [
        {<<"url1">>, url},
        {<<"url2">>, [
            {url, []}
        ]},
        {<<"url3">>, [
            [
                {url, []}
            ]
        ]},
        {<<"url4">>, url},
        {<<"url5">>, url},
        {<<"empty_field">>, url},
        {<<"value_is_hash">>, url},
        {<<"value_is_empty_hash">>, url},
        {<<"value_is_array">>, url},
        {<<"value_is_empty_array">>, url}
    ]},
    {input, [
        {<<"url1">>, <<"www.google.com">>},
        {<<"url2">>, <<"ftp://facebook.com">>},
        {<<"url3">>, <<"http://g_oogle.com">>},
        {<<"url4">>, <<"https://google.com\n">>},
        {<<"url5">>, <<"http://webbylab.com/?param_1=123\n">>},
        {<<"empty_field">>, <<>>},
        {<<"extra_field">>, <<"aaaa">>},
        {<<"value_is_hash">>, [
            {<<"test">>, 1}
        ]},
        {<<"value_is_empty_hash">>, [{}]},
        {<<"value_is_array">>, [<<"test">>, 1]},
        {<<"value_is_empty_array">>, []}
    ]},
    {errors, [
        {<<"url1">>, <<"WRONG_URL">>},
        {<<"url2">>, <<"WRONG_URL">>},
        {<<"url3">>, <<"WRONG_URL">>},
        {<<"url4">>, <<"WRONG_URL">>},
        {<<"url5">>, <<"WRONG_URL">>},
        {<<"value_is_hash">>, <<"FORMAT_ERROR">>},
        {<<"value_is_empty_hash">>, <<"FORMAT_ERROR">>},
        {<<"value_is_array">>, <<"FORMAT_ERROR">>},
        {<<"value_is_empty_array">>, <<"FORMAT_ERROR">>}
    ]}
].
