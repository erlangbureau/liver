%% LIVR negative/05-max_length (case: max_length, form: proplists)
%% Source: https://github.com/koorchik/LIVR/tree/44f0453b2cff7fdbb23c6cf48abe29fa8c601bf8/test_suite/negative/05-max_length
%% Imported for liver; iso_date outputs use Erlang {Y,M,D} dates.
%% Proplist fixtures preserve JSON key order from json:decode/3.

[
    {name, max_length},
    {rules, [
        {<<"first_name">>, [
            {max_length, 4}
        ]},
        {<<"last_name">>, [
            {max_length, [5]}
        ]},
        {<<"middle_name">>, [
            [
                {max_length, [0]}
            ]
        ]},
        {<<"empty_name">>, [
            {max_length, 3}
        ]},
        {<<"value_is_hash">>, [
            {max_length, 4}
        ]},
        {<<"value_is_empty_hash">>, [
            {max_length, 4}
        ]},
        {<<"value_is_array">>, [
            {max_length, 4}
        ]},
        {<<"value_is_empty_array">>, [
            {max_length, 4}
        ]}
    ]},
    {input, [
        {<<"first_name">>, <<"Vasya">>},
        {<<"last_name">>, <<"Pupkin">>},
        {<<"middle_name">>, <<"Some name">>},
        {<<"empty_name">>, <<>>},
        {<<"extra_name">>, <<"extra_name">>},
        {<<"value_is_hash">>, [
            {<<"test">>, 1}
        ]},
        {<<"value_is_empty_hash">>, [{}]},
        {<<"value_is_array">>, [<<"test">>, 1]},
        {<<"value_is_empty_array">>, []}
    ]},
    {errors, [
        {<<"first_name">>, <<"TOO_LONG">>},
        {<<"last_name">>, <<"TOO_LONG">>},
        {<<"middle_name">>, <<"TOO_LONG">>},
        {<<"value_is_hash">>, <<"FORMAT_ERROR">>},
        {<<"value_is_empty_hash">>, <<"FORMAT_ERROR">>},
        {<<"value_is_array">>, <<"FORMAT_ERROR">>},
        {<<"value_is_empty_array">>, <<"FORMAT_ERROR">>}
    ]}
].
