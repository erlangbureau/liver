                [
                    {<<"material">>, [
                        {<<"product_type">>, required},
                        {<<"material_id">>, positive_integer}
                    ]},
                    {<<"service">>, [
                        {<<"product_type">>, required},
                        {<<"name">>, required}
                    ]}
                ]
            ]}
        ]},
        {<<"selector_is_not_string">>, [
            {list_of_different_objects, [
                <<"product_type">>,
                [
                    {<<"material">>, [
                        {<<"product_type">>, required},
                        {<<"material_id">>, positive_integer}
                    ]},
                    {<<"service">>, [
                        {<<"product_type">>, required},
                        {<<"name">>, required}
                    ]}
                ]
