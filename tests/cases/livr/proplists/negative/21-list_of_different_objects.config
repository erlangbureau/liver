    {input, [
        {<<"order_id">>, <<"-10">>},
        {<<"products">>, [
            [
                {<<"product_type">>, <<"material">>},
                {<<"material_id">>, 0},
                {<<"quantity">>, <<>>}
            ],
            [
                {<<"product_type">>, <<"material">>},
                {<<"material_id">>, 100},
