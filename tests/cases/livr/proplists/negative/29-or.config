%% LIVR negative/29-or (case: 'or', form: proplists)
%% Source: https://github.com/koorchik/LIVR/tree/4384f09e60d758d5c3ef3c76e8a29eac8ec688a0/test_suite/negative/29-or
%% Imported for liver; iso_date outputs use Erlang {Y,M,D} dates.
%% Proplist fixtures preserve JSON key order from json:decode/3.
%% Known issue (patched on import): [or_negative_nested_error_key_order]
%% JSON objects are unordered; liver proplist errors follow schema order.

[
    {name, 'or'},
    {rules, [
        {<<"id1-1">>, [
            {'or', [email, positive_integer]}
        ]},
        {<<"id2-1">>, [
            [
                {'or', [email, positive_integer]}
            ],
            to_lc
        ]},
        {<<"id3-1">>, [
            {'or', [
                [
                    {min_length, 15}
                ],
                [email, to_lc]
            ]}
        ]},
        {<<"id4-1">>, [
            {'or', [
                [required, positive_integer],
                [not_empty, email]
            ]}
        ]},
        {<<"id4-2">>, [
            {'or', [
                [required, positive_integer],
                [required, email]
            ]}
        ]},
        {<<"products">>, [
            {list_of, [
                {'or', [
                    [
                        {nested_object, [
                            {<<"product_type">>, [
                                required,
                                [
                                    {eq, <<"material">>}
                                ]
                            ]},
                            {<<"material_id">>, [required, positive_integer]},
                            {<<"quantity">>, [
                                required,
                                [
                                    {min_number, 1}
                                ]
                            ]},
                            {<<"warehouse_id">>, positive_integer}
                        ]}
                    ],
                    [
                        {nested_object, [
                            {<<"product_type">>, [
                                required,
                                [
                                    {eq, <<"service">>}
                                ]
                            ]},
                            {<<"name">>, [
                                required,
                                [
                                    {max_length, 20}
                                ]
                            ]}
                        ]}
                    ]
                ]}
            ]}
        ]}
    ]},
    {input, [
        {<<"id1-1">>, <<"Usermail.com">>},
        {<<"id2-1">>, <<"Usermail.com">>},
        {<<"id3-1">>, <<"Usermail.com">>},
        {<<"id4-1">>, <<>>},
        {<<"products">>, [
            [
                {<<"product_type">>, <<"material">>},
                {<<"material_id">>, 123},
                {<<"quantity">>, 10},
                {<<"warehouse_id">>, -321}
            ],
            [
                {<<"product_type">>, <<"service">>},
                {<<"name">>, <<>>},
                {<<"extra_field">>, <<"some data">>}
            ]
        ]}
    ]},
    {errors, [
        {<<"id1-1">>, <<"NOT_POSITIVE_INTEGER">>},
        {<<"id2-1">>, <<"NOT_POSITIVE_INTEGER">>},
        {<<"id3-1">>, <<"WRONG_EMAIL">>},
        {<<"id4-1">>, <<"CANNOT_BE_EMPTY">>},
        {<<"id4-2">>, <<"REQUIRED">>},
        {<<"products">>, [
            [
                {<<"product_type">>, <<"NOT_ALLOWED_VALUE">>},
                {<<"name">>, <<"REQUIRED">>}
            ],
            [
                {<<"name">>, <<"REQUIRED">>}
            ]
        ]}
    ]}
].
