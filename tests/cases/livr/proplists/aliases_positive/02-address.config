%% LIVR aliases_positive/02-address (case: address, form: proplists)
%% Source: https://github.com/koorchik/LIVR/tree/14e5a1b19011d3e9bf6ab5a6a0dd4444bea8b280/test_suite/aliases_positive/02-address
%% Imported for liver; iso_date outputs use Erlang {Y,M,D} dates.
%% Proplist fixtures preserve JSON key order from json:decode/3.

[
    {name, address},
    {rules, [
        {<<"address">>, <<"address">>},
        {<<"address_custom_error">>, <<"address_with_custom_error">>}
    ]},
    {input, [
        {<<"address">>, [
            {<<"street">>, <<"My street">>},
            {<<"zip">>, 1232131},
            {<<"city">>, <<"Kyiv">>}
        ]},
        {<<"address_custom_error">>, [
            {<<"street">>, <<"My street">>},
            {<<"zip">>, <<"12312">>},
            {<<"city">>, <<"Kharkiv">>}
        ]},
        {<<"extra_field">>, 12}
    ]},
    {output, [
        {<<"address">>, [
            {<<"street">>, <<"My street">>},
            {<<"zip">>, 1232131},
            {<<"city">>, <<"Kyiv">>}
        ]},
        {<<"address_custom_error">>, [
            {<<"street">>, <<"My street">>},
            {<<"zip">>, 12312},
            {<<"city">>, <<"Kharkiv">>}
        ]}
    ]},
    {opts, [
        {aliased_rules, [
            [
                {name, address},
                {rules, [
                    {nested_object, [
                        {<<"street">>, required},
                        {<<"zip">>, [required, positive_integer]},
                        {<<"city">>, [
                            {one_of, [<<"Kyiv">>, <<"Kharkiv">>]}
                        ]}
                    ]}
                ]}
            ],
            [
                {name, address_with_custom_error},
                {rules, [
                    {nested_object, [
                        {<<"street">>, required},
                        {<<"zip">>, [required, positive_integer]},
                        {<<"city">>, [
                            {one_of, [<<"Kyiv">>, <<"Kharkiv">>]}
                        ]}
                    ]}
                ]},
                {error, <<"WRONG_ADDRESS">>}
            ]
        ]}
    ]}
].
