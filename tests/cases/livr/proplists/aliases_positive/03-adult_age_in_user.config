%% Proplist fixtures preserve JSON key order from json:decode/3.

[
    {name, adult_age_in_user},
    {rules, [
        {<<"user">>, <<"user">>},
        {<<"user_custom_error">>, [<<"user_with_custom_error">>]}
    ]},
    {input, [
        {<<"user">>, [
            {<<"name">>, <<"koorchik">>},
            {<<"age1">>, 20},
            {<<"age2">>, 40},
            {<<"extra_field">>, <<"som value">>}
        ]},
        {<<"user_custom_error">>, [
            {<<"name">>, <<"koorchik">>},
            {<<"age1">>, 33},
            {<<"age2">>, 22}
        ]},
        {<<"extra_field">>, 12}
    ]},
    {output, [
        {<<"user">>, [
            {<<"name">>, <<"koorchik">>},
            {<<"age1">>, 20},
            {<<"age2">>, 40}
        ]},
        {<<"user_custom_error">>, [
            {<<"name">>, <<"koorchik">>},
            {<<"age1">>, 33},
            {<<"age2">>, 22}
        ]}
    ]},
    {opts, [
        {aliased_rules, [
            [
                {name, adult_age},
                {rules, [
                    positive_integer,
                    [
                        {min_number, 18}
                    ]
                ]}
            ],
            [
                {name, adult_age_with_custom_error},
                {rules, [
                    positive_integer,
                    [
                        {min_number, 18}
                    ]
                ]},
                {error, <<"WRONG_AGE">>}
            ],
            [
                {name, user},
                {rules, [
                    {nested_object, [
                        {<<"name">>, required},
                        {<<"age1">>, <<"adult_age">>},
                        {<<"age2">>, <<"adult_age_with_custom_error">>}
                    ]}
                ]}
            ],
            [
                {name, user_with_custom_error},
                {rules, [
                    {nested_object, [
                        {<<"name">>, required},
                        {<<"age1">>, <<"adult_age">>},
                        {<<"age2">>, <<"adult_age_with_custom_error">>}
                    ]}
                ]},
                {error, <<"WRONG_USER">>}
            ]
        ]}
    ]}
].
