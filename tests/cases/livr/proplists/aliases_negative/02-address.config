%% LIVR aliases_negative/02-address (case: address, form: proplists)
%% Source: https://github.com/koorchik/LIVR/tree/4384f09e60d758d5c3ef3c76e8a29eac8ec688a0/test_suite/aliases_negative/02-address
%% Imported for liver; iso_date outputs use Erlang {Y,M,D} dates.
%% Proplist fixtures preserve JSON key order from json:decode/3.

[
    {name, address},
    {rules, [
        {<<"address">>, <<"address">>},
        {<<"address_custom_error">>, <<"address_with_custom_error">>}
    ]},
    {input, [
        {<<"address">>, [
            {<<"street">>, <<>>},
            {<<"zip">>, -1232131},
            {<<"city">>, <<"Lviv">>}
        ]},
        {<<"address_custom_error">>, [
            {<<"street">>, <<"My street">>},
            {<<"zip">>, <<"12312">>},
            {<<"city">>, <<"Lviv">>}
        ]},
        {<<"extra_field">>, 12}
    ]},
    {errors, [
        {<<"address">>, [
            {<<"street">>, <<"REQUIRED">>},
            {<<"zip">>, <<"NOT_POSITIVE_INTEGER">>},
            {<<"city">>, <<"NOT_ALLOWED_VALUE">>}
        ]},
        {<<"address_custom_error">>, <<"WRONG_ADDRESS">>}
    ]},
    {opts, [
        {aliased_rules, [
            [
                {name, address},
                {rules, [
                    {nested_object, [
                        {<<"street">>, required},
                        {<<"zip">>, [required, positive_integer]},
                        {<<"city">>, [
                            {one_of, [<<"Kyiv">>, <<"Kharkiv">>]}
                        ]}
                    ]}
                ]}
            ],
            [
                {name, address_with_custom_error},
                {rules, [
                    {nested_object, [
                        {<<"street">>, required},
                        {<<"zip">>, [required, positive_integer]},
                        {<<"city">>, [
                            {one_of, [<<"Kyiv">>, <<"Kharkiv">>]}
                        ]}
                    ]}
                ]},
                {error, <<"WRONG_ADDRESS">>}
            ]
        ]}
    ]}
].
