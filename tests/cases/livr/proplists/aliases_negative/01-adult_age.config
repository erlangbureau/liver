[
    {name, adult_age},
    {rules, [
        {<<"age1">>, <<"adult_age">>},
        {<<"age2">>, [<<"adult_age">>]},
        {<<"age3">>, [
            [
                {<<"adult_age">>, []}
            ]
        ]},
        {<<"age4">>, [
            {<<"adult_age">>, []}
        ]},
        {<<"age1_custom_error">>, <<"adult_age_with_custom_error">>},
        {<<"age2_custom_error">>, [<<"adult_age_with_custom_error">>]},
        {<<"age3_custom_error">>, [
            [
                {<<"adult_age_with_custom_error">>, []}
            ]
        ]},
        {<<"age4_custom_error">>, [
            {<<"adult_age_with_custom_error">>, []}
        ]}
    ]},
    {input, [
        {<<"age1">>, 32},
        {<<"age2">>, 33},
        {<<"age3">>, 15},
        {<<"age4">>, -20},
        {<<"age1_custom_error">>, 37},
        {<<"age2_custom_error">>, 38},
        {<<"age3_custom_error">>, 16},
        {<<"age4_custom_error">>, -10},
        {<<"extra_field">>, 12}
    ]},
    {errors, [
        {<<"age3">>, <<"TOO_LOW">>},
        {<<"age4">>, <<"NOT_POSITIVE_INTEGER">>},
        {<<"age3_custom_error">>, <<"WRONG_AGE">>},
        {<<"age4_custom_error">>, <<"WRONG_AGE">>}
    ]},
    {opts, [
        {aliased_rules, [
            [
                {name, adult_age},
                {rules, [
                    positive_integer,
                    [
                        {min_number, 18}
                    ]
                ]}
            ],
            [
                {name, adult_age_with_custom_error},
                {rules, [
                    positive_integer,
                    [
                        {min_number, 18}
                    ]
                ]},
                {error, <<"WRONG_AGE">>}
            ]
        ]}
    ]}
