%% LIVR positive/08-like (case: like, form: proplists)
%% Source: https://github.com/koorchik/LIVR/tree/44f0453b2cff7fdbb23c6cf48abe29fa8c601bf8/test_suite/positive/08-like
%% Imported for liver; iso_date outputs use Erlang {Y,M,D} dates.
%% Proplist fixtures preserve JSON key order from json:decode/3.

[
    {name, like},
    {rules, [
        {<<"first_name">>, [
            {like, <<"[A-Za-z]+">>}
        ]},
        {<<"last_name">>, [
            {like, [<<"^[A-Za-z]+$">>]}
        ]},
        {<<"middle_name">>, [
            {like, [<<"^[a-z]+$">>, <<"i">>]}
        ]},
        {<<"age">>, [
            [
                {like, <<"^[0-9]+$">>}
            ]
        ]},
        {<<"empty_name">>, [
            {like, <<"[A-Za-z]">>}
        ]},
        {<<"missed_name">>, [
            {like, <<"[A-Za-z]">>}
        ]}
    ]},
    {input, [
        {<<"first_name">>, <<"Vasya">>},
        {<<"last_name">>, <<"Pupkin">>},
        {<<"middle_name">>, <<"Ivanovich">>},
        {<<"age">>, 35},
        {<<"empty_name">>, <<>>},
        {<<"extra_name">>, <<"extra_name">>}
    ]},
    {output, [
        {<<"first_name">>, <<"Vasya">>},
        {<<"last_name">>, <<"Pupkin">>},
        {<<"middle_name">>, <<"Ivanovich">>},
        {<<"age">>, <<"35">>},
        {<<"empty_name">>, <<>>}
    ]}
].
