%% LIVR positive/06-length_equal (case: length_equal, form: proplists)
%% Source: https://github.com/koorchik/LIVR/tree/4384f09e60d758d5c3ef3c76e8a29eac8ec688a0/test_suite/positive/06-length_equal
%% Imported for liver; iso_date outputs use Erlang {Y,M,D} dates.
%% Proplist fixtures preserve JSON key order from json:decode/3.

[
    {name, length_equal},
    {rules, [
        {<<"first_name">>, [
            {length_equal, 5}
        ]},
        {<<"last_name">>, [
            {length_equal, [6]}
        ]},
        {<<"middle_name">>, [
            [
                {length_equal, [9]}
            ]
        ]},
        {<<"number1">>, [
            {length_equal, 4}
        ]},
        {<<"empty_name">>, [
            {length_equal, 3}
        ]},
        {<<"missed_name">>, [
            {length_equal, 3}
        ]}
    ]},
    {input, [
        {<<"first_name">>, <<"Vasya">>},
        {<<"last_name">>, <<"Pupkin">>},
        {<<"middle_name">>, <<"Some name">>},
        {<<"number1">>, 1111},
        {<<"empty_name">>, <<>>},
        {<<"extra_name">>, <<"extra_name">>}
    ]},
    {output, [
        {<<"first_name">>, <<"Vasya">>},
        {<<"last_name">>, <<"Pupkin">>},
        {<<"middle_name">>, <<"Some name">>},
        {<<"number1">>, <<"1111">>},
        {<<"empty_name">>, <<>>}
    ]}
].
