%% LIVR positive/12-positive_decimal (case: positive_decimal, form: proplists)
%% Source: https://github.com/koorchik/LIVR/tree/14e5a1b19011d3e9bf6ab5a6a0dd4444bea8b280/test_suite/positive/12-positive_decimal
%% Imported for liver; iso_date outputs use Erlang {Y,M,D} dates.
%% Proplist fixtures preserve JSON key order from json:decode/3.

[
    {name, positive_decimal},
    {rules, [
        {<<"number1">>, positive_decimal},
        {<<"number2">>, [positive_decimal]},
        {<<"number3">>, [
            [
                {positive_decimal, []}
            ]
        ]},
        {<<"number4">>, positive_decimal},
        {<<"empty_field">>, positive_decimal},
        {<<"integer_number">>, positive_decimal}
    ]},
    {input, [
        {<<"number1">>, <<"10">>},
        {<<"number2">>, <<"120.11">>},
        {<<"number3">>, <<"99999.9999">>},
        {<<"number4">>, <<"0.01">>},
        {<<"empty_field">>, <<>>},
        {<<"extra_field">>, <<"100">>},
        {<<"integer_number">>, 5}
    ]},
    {output, [
        {<<"number1">>, 10},
        {<<"number2">>, 120.11},
        {<<"number3">>, 99999.9999},
        {<<"number4">>, 0.01},
        {<<"empty_field">>, <<>>},
        {<<"integer_number">>, 5}
    ]}
].
