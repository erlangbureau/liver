%% LIVR positive/18-nested_object (case: nested_object, form: proplists)
%% Source: https://github.com/koorchik/LIVR/tree/4384f09e60d758d5c3ef3c76e8a29eac8ec688a0/test_suite/positive/18-nested_object
%% Imported for liver; iso_date outputs use Erlang {Y,M,D} dates.
%% Proplist fixtures preserve JSON key order from json:decode/3.

[
    {name, nested_object},
    {rules, [
        {<<"address">>, [
            required,
            [
                {nested_object, [
                    {<<"country">>, [
                        required,
                        [
                            {one_of, [
                                [<<"Ukraine">>, <<"USA">>]
                            ]}
                        ]
                    ]},
                    {<<"zip">>, positive_integer},
                    {<<"street">>, required},
                    {<<"building">>, [required, positive_integer]}
                ]}
            ]
        ]},
        {<<"should_not_be_errored">>, [
            {nested_object, [
                {<<"zip">>, positive_integer}
            ]}
        ]},
        {<<"should_be_empty">>, [
            required,
            [
                {nested_object, [
                    {<<"country">>, [
                        [
                            {one_of, [
                                [<<"Ukraine">>, <<"USA">>]
                            ]}
                        ]
                    ]},
                    {<<"zip">>, positive_integer}
                ]}
            ]
        ]},
        {<<"builtin_names">>, [
            {nested_object, [
                {<<"constructor">>, required},
                {<<"toString">>, required}
            ]}
        ]}
    ]},
    {input, [
        {<<"address">>, [
            {<<"country">>, <<"Ukraine">>},
            {<<"zip">>, <<"12345">>},
            {<<"street">>, <<"10">>},
            {<<"building">>, <<"10">>},
            {<<"extra_field">>, <<"will be removed">>}
        ]},
        {<<"should_not_be_errored">>, <<>>},
        {<<"should_be_empty">>, [
            {<<"extra_field">>, <<"will be removed">>}
        ]},
        {<<"extra_field">>, <<"will be removed">>},
        {<<"builtin_names">>, [
            {<<"constructor">>, <<"Constructor value">>},
            {<<"toString">>, <<"ToString value">>},
            {<<"hasOwnProperty">>, <<"will be removed">>}
        ]}
    ]},
    {output, [
        {<<"address">>, [
            {<<"country">>, <<"Ukraine">>},
            {<<"zip">>, 12345},
            {<<"street">>, <<"10">>},
            {<<"building">>, 10}
        ]},
        {<<"should_not_be_errored">>, <<>>},
        {<<"should_be_empty">>, [{}]},
        {<<"builtin_names">>, [
            {<<"constructor">>, <<"Constructor value">>},
            {<<"toString">>, <<"ToString value">>}
        ]}
    ]}
].
