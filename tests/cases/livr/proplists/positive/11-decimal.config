%% LIVR positive/11-decimal (case: decimal, form: proplists)
%% Source: https://github.com/koorchik/LIVR/tree/44f0453b2cff7fdbb23c6cf48abe29fa8c601bf8/test_suite/positive/11-decimal
%% Imported for liver; iso_date outputs use Erlang {Y,M,D} dates.
%% Proplist fixtures preserve JSON key order from jsx:decode/1.

[
    {name, decimal},
    {rules, [
        {<<"number1">>, decimal},
        {<<"number2">>, [decimal]},
        {<<"number3">>, [
            [
                {decimal, []}
            ]
        ]},
        {<<"number4">>, decimal},
        {<<"empty_field">>, decimal}
    ]},
    {input, [
        {<<"number1">>, <<"10.12">>},
        {<<"number2">>, 0.55},
        {<<"number3">>, -1.1},
        {<<"number4">>, -3.0},
        {<<"empty_field">>, <<>>},
        {<<"extra_field">>, <<"100">>}
    ]},
    {output, [
        {<<"number1">>, 10.12},
        {<<"number2">>, 0.55},
        {<<"number3">>, -1.1},
        {<<"number4">>, -3.0},
        {<<"empty_field">>, <<>>}
    ]}
].
