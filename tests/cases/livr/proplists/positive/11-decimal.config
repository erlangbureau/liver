%% LIVR positive/11-decimal (case: decimal, form: proplists)
%% Source: https://github.com/koorchik/LIVR/tree/14e5a1b19011d3e9bf6ab5a6a0dd4444bea8b280/test_suite/positive/11-decimal
%% Imported for liver; iso_date outputs use Erlang {Y,M,D} dates.
%% Proplist fixtures preserve JSON key order from json:decode/3.

[
    {name, decimal},
    {rules, [
        {<<"number1">>, decimal},
        {<<"number2">>, [decimal]},
        {<<"number3">>, [
            [
                {decimal, []}
            ]
        ]},
        {<<"number4">>, decimal},
        {<<"empty_field">>, decimal},
        {<<"negative_integer_string">>, decimal},
        {<<"negative_integer">>, decimal},
        {<<"zero">>, decimal},
        {<<"null_value">>, decimal}
    ]},
    {input, [
        {<<"number1">>, <<"10.12">>},
        {<<"number2">>, 0.55},
        {<<"number3">>, -1.1},
        {<<"number4">>, -3.0},
        {<<"empty_field">>, <<>>},
        {<<"extra_field">>, <<"100">>},
        {<<"negative_integer_string">>, <<"-200">>},
        {<<"negative_integer">>, -200},
        {<<"zero">>, 0},
        {<<"null_value">>, null}
    ]},
    {output, [
        {<<"number1">>, 10.12},
        {<<"number2">>, 0.55},
        {<<"number3">>, -1.1},
        {<<"number4">>, -3.0},
        {<<"empty_field">>, <<>>},
        {<<"negative_integer_string">>, -200},
        {<<"negative_integer">>, -200},
        {<<"zero">>, 0},
        {<<"null_value">>, null}
    ]}
].
