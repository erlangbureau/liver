%% LIVR positive/09-integer (case: integer, form: proplists)
%% Source: https://github.com/koorchik/LIVR/tree/4384f09e60d758d5c3ef3c76e8a29eac8ec688a0/test_suite/positive/09-integer
%% Imported for liver; iso_date outputs use Erlang {Y,M,D} dates.
%% Proplist fixtures preserve JSON key order from json:decode/3.

[
    {name, integer},
    {rules, [
        {<<"number1">>, integer},
        {<<"number2">>, [integer]},
        {<<"number3">>, [
            [
                {integer, []}
            ]
        ]},
        {<<"empty_field">>, integer},
        {<<"missed_field">>, integer}
    ]},
    {input, [
        {<<"number1">>, <<"10">>},
        {<<"number2">>, 0},
        {<<"number3">>, -1},
        {<<"empty_field">>, <<>>},
        {<<"extra_field">>, <<"100">>}
    ]},
    {output, [
        {<<"number1">>, 10},
        {<<"number2">>, 0},
        {<<"number3">>, -1},
        {<<"empty_field">>, <<>>}
    ]}
].
