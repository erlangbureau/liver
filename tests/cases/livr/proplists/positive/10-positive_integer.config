%% LIVR positive/10-positive_integer (case: positive_integer, form: proplists)
%% Source: https://github.com/koorchik/LIVR/tree/44f0453b2cff7fdbb23c6cf48abe29fa8c601bf8/test_suite/positive/10-positive_integer
%% Imported for liver; iso_date outputs use Erlang {Y,M,D} dates.
%% Proplist fixtures preserve JSON key order from jsx:decode/1.

[
    {name, positive_integer},
    {rules, [
        {<<"number1">>, positive_integer},
        {<<"number2">>, [positive_integer]},
        {<<"number3">>, [
            [
                {positive_integer, []}
            ]
        ]},
        {<<"empty_field">>, positive_integer}
    ]},
    {input, [
        {<<"number1">>, <<"10">>},
        {<<"number2">>, 999999},
        {<<"number3">>, 1},
        {<<"empty_field">>, <<>>},
        {<<"extra_field">>, <<"100">>}
    ]},
    {output, [
        {<<"number1">>, 10},
        {<<"number2">>, 999999},
        {<<"number3">>, 1},
        {<<"empty_field">>, <<>>}
    ]}
].
