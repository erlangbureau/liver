%% LIVR positive/02-not_empty (case: not_empty, form: proplists)
%% Source: https://github.com/koorchik/LIVR/tree/14e5a1b19011d3e9bf6ab5a6a0dd4444bea8b280/test_suite/positive/02-not_empty
%% Imported for liver; iso_date outputs use Erlang {Y,M,D} dates.
%% Proplist fixtures preserve JSON key order from json:decode/3.

[
    {name, not_empty},
    {rules, [
        {<<"first_name">>, not_empty},
        {<<"last_name">>, [not_empty]},
        {<<"middle_name">>, [
            [
                {not_empty, []}
            ]
        ]},
        {<<"salary">>, [
            {required, []}
        ]}
    ]},
    {input, [
        {<<"first_name">>, <<"Vasya">>},
        {<<"last_name">>, null},
        {<<"age">>, <<"25">>},
        {<<"salary">>, 0}
    ]},
    {output, [
        {<<"first_name">>, <<"Vasya">>},
        {<<"last_name">>, null},
        {<<"salary">>, 0}
    ]}
].
