%% Imported for liver; iso_date outputs use Erlang {Y,M,D} dates.
%% Proplist fixtures preserve JSON key order from json:decode/3.

[
    {name, min_length},
    {rules, [
        {<<"first_name">>, [
            {min_length, 3}
        ]},
        {<<"last_name">>, [
            {min_length, [4]}
        ]},
        {<<"middle_name">>, [
            [
                {min_length, [5]}
            ]
        ]},
        {<<"number1">>, [
            {min_length, 2}
        ]},
        {<<"empty_name">>, [
            {min_length, 3}
        ]},
        {<<"missed_name">>, [
            {min_length, 3}
        ]}
    ]},
    {input, [
        {<<"first_name">>, <<"Vasya">>},
        {<<"last_name">>, <<"Pupkin">>},
        {<<"middle_name">>, <<"Some name">>},
        {<<"number1">>, 1111},
        {<<"empty_name">>, <<>>},
        {<<"extra_name">>, <<"extra_name">>}
    ]},
    {output, [
        {<<"first_name">>, <<"Vasya">>},
        {<<"last_name">>, <<"Pupkin">>},
        {<<"middle_name">>, <<"Some name">>},
        {<<"number1">>, <<"1111">>},
        {<<"empty_name">>, <<>>}
    ]}
].
