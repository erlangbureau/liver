%% LIVR positive/24-iso_date (case: iso_date, form: proplists)
%% Source: https://github.com/koorchik/LIVR/tree/4384f09e60d758d5c3ef3c76e8a29eac8ec688a0/test_suite/positive/24-iso_date
%% Imported for liver; iso_date outputs use Erlang {Y,M,D} dates.
%% Proplist fixtures preserve JSON key order from json:decode/3.

[
    {name, iso_date},
    {rules, [
        {<<"iso_date1">>, iso_date},
        {<<"iso_date2">>, [
            {iso_date, []}
        ]},
        {<<"iso_date3">>, [
            [
                {iso_date, []}
            ]
        ]},
        {<<"iso_date4">>, [
            [
                {iso_date, []}
            ]
        ]},
        {<<"iso_date5">>, iso_date},
        {<<"iso_date6">>, iso_date},
        {<<"iso_date7">>, iso_date},
        {<<"empty_field">>, iso_date}
    ]},
    {input, [
        {<<"iso_date1">>, <<"2014-02-18">>},
        {<<"iso_date2">>, <<"1930-03-30">>},
        {<<"iso_date3">>, <<"1930-01-01">>},
        {<<"iso_date4">>, <<"1970-01-01">>},
        {<<"iso_date5">>, <<"2015-10-10">>},
        {<<"iso_date6">>, <<"2024-02-29">>},
        {<<"iso_date7">>, <<"2000-02-29">>},
        {<<"empty_field">>, <<>>},
        {<<"extra_field">>, <<"aaaa">>}
    ]},
    {output, [
        {<<"iso_date1">>, {2014, 2, 18}},
        {<<"iso_date2">>, {1930, 3, 30}},
        {<<"iso_date3">>, {1930, 1, 1}},
        {<<"iso_date4">>, {1970, 1, 1}},
        {<<"iso_date5">>, {2015, 10, 10}},
        {<<"iso_date6">>, {2024, 2, 29}},
        {<<"iso_date7">>, {2000, 2, 29}},
        {<<"empty_field">>, <<>>}
    ]}
].
