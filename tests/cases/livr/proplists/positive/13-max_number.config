%% LIVR positive/13-max_number (case: max_number, form: proplists)
%% Source: https://github.com/koorchik/LIVR/tree/4384f09e60d758d5c3ef3c76e8a29eac8ec688a0/test_suite/positive/13-max_number
%% Imported for liver; iso_date outputs use Erlang {Y,M,D} dates.
%% Proplist fixtures preserve JSON key order from json:decode/3.

[
    {name, max_number},
    {rules, [
        {<<"number1">>, [
            {max_number, 10}
        ]},
        {<<"number2">>, [
            {max_number, [20]}
        ]},
        {<<"number3">>, [
            [
                {max_number, [30]}
            ]
        ]},
        {<<"empty_field">>, [
            {max_number, 10}
        ]}
    ]},
    {input, [
        {<<"number1">>, <<"10">>},
        {<<"number2">>, 15},
        {<<"number3">>, -10},
        {<<"empty_field">>, <<>>},
        {<<"extra_field">>, <<"100">>}
    ]},
    {output, [
        {<<"number1">>, 10},
        {<<"number2">>, 15},
        {<<"number3">>, -10},
        {<<"empty_field">>, <<>>}
    ]}
].
