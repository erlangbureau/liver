%% LIVR positive/21-list_of_different_objects (case: list_of_different_objects, form: proplists)
%% Source: https://github.com/koorchik/LIVR/tree/4384f09e60d758d5c3ef3c76e8a29eac8ec688a0/test_suite/positive/21-list_of_different_objects
%% Imported for liver; iso_date outputs use Erlang {Y,M,D} dates.
%% Proplist fixtures preserve JSON key order from json:decode/3.

[
    {name, list_of_different_objects},
    {rules, [
        {<<"order_id">>, [required, positive_integer]},
        {<<"products">>, [
            required,
            [
                {list_of_different_objects, [
                    <<"product_type">>,
                    [
                        {<<"material">>, [
                            {<<"product_type">>, required},
                            {<<"material_id">>, [required, positive_integer]},
                            {<<"quantity">>, [
                                required,
                                [
                                    {min_number, 1}
                                ]
                            ]},
                            {<<"warehouse_id">>, positive_integer}
                        ]},
                        {<<"service">>, [
                            {<<"product_type">>, required},
                            {<<"name">>, [
                                required,
                                [
                                    {max_length, 10}
                                ]
                            ]}
                        ]}
                    ]
                ]}
            ]
        ]},
        {<<"empty_list">>, [
            required,
            [
                {list_of_different_objects, [
                    <<"item_type">>,
                    [
                        {<<"string">>, [
                            {<<"value">>, required}
                        ]},
                        {<<"number">>, [
                            {<<"value">>, [required, integer]}
                        ]}
                    ]
                ]}
            ]
        ]}
    ]},
    {input, [
        {<<"order_id">>, <<"10">>},
        {<<"products">>, [
            [
                {<<"product_type">>, <<"material">>},
                {<<"material_id">>, 12},
                {<<"quantity">>, <<"11">>}
            ],
            [
                {<<"product_type">>, <<"material">>},
                {<<"material_id">>, 100},
                {<<"quantity">>, 10},
                {<<"warehouse_id">>, 100}
            ],
            [
                {<<"product_type">>, <<"service">>},
                {<<"name">>, <<"service1">>},
                {<<"extra_field">>, <<"will be removed">>}
            ]
        ]},
        {<<"empty_list">>, []}
    ]},
    {output, [
        {<<"order_id">>, 10},
        {<<"products">>, [
            [
                {<<"product_type">>, <<"material">>},
                {<<"material_id">>, 12},
                {<<"quantity">>, 11}
            ],
            [
                {<<"product_type">>, <<"material">>},
                {<<"material_id">>, 100},
                {<<"quantity">>, 10},
                {<<"warehouse_id">>, 100}
            ],
            [
                {<<"product_type">>, <<"service">>},
                {<<"name">>, <<"service1">>}
            ]
        ]},
        {<<"empty_list">>, []}
    ]}
].
