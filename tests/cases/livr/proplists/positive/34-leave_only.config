%% LIVR positive/34-leave_only (case: leave_only, form: proplists)
%% Source: https://github.com/koorchik/LIVR/tree/44f0453b2cff7fdbb23c6cf48abe29fa8c601bf8/test_suite/positive/34-leave_only
%% Imported for liver; iso_date outputs use Erlang {Y,M,D} dates.
%% Proplist fixtures preserve JSON key order from json:decode/3.

[
    {name, leave_only},
    {rules, [
        {<<"string_value">>, [
            {leave_only, <<"Vl ">>}
        ]},
        {<<"object">>, [
            {nested_object, [
                {<<"string_value">>, [
                    {leave_only, <<"a-zv">>}
                ]}
            ]}
        ]},
        {<<"list_of_string_values">>, [
            {list_of, [
                {leave_only, <<"23">>}
            ]}
        ]}
    ]},
    {input, [
        {<<"string_value">>, <<"Value value Value">>},
        {<<"object">>, [
            {<<"string_value">>, <<"Value-value |Value|">>}
        ]},
        {<<"list_of_string_values">>, [
            <<"value1">>,
            [
                {<<"key">>, <<"123">>}
            ],
            <<"value123">>
        ]}
    ]},
    {output, [
        {<<"string_value">>, <<"Vl l Vl">>},
        {<<"object">>, [
            {<<"string_value">>, <<"a-vaa">>}
        ]},
        {<<"list_of_string_values">>, [
            <<>>,
            [
                {<<"key">>, <<"123">>}
            ],
            <<"23">>
        ]}
    ]}
].
