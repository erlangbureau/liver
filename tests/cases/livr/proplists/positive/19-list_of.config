%% LIVR positive/19-list_of (case: list_of, form: proplists)
%% Source: https://github.com/koorchik/LIVR/tree/44f0453b2cff7fdbb23c6cf48abe29fa8c601bf8/test_suite/positive/19-list_of
%% Imported for liver; iso_date outputs use Erlang {Y,M,D} dates.
%% Proplist fixtures preserve JSON key order from jsx:decode/1.

[
    {name, list_of},
    {rules, [
        {<<"product_ids1">>, [
            required,
            [
                {list_of, [
                    [
                        required,
                        positive_integer,
                        [
                            {max_number, 100}
                        ]
                    ]
                ]}
            ]
        ]},
        {<<"product_ids2">>, [
            required,
            [
                {list_of, [
                    required,
                    positive_integer,
                    [
                        {max_number, 100}
                    ]
                ]}
            ]
        ]},
        {<<"product_ids3">>, [
            required,
            [
                {list_of, positive_integer}
            ]
        ]},
        {<<"user_ids">>, [
            {list_of, [
                [required]
            ]}
        ]},
        {<<"empty_list">>, [
            {list_of, [required]}
        ]}
    ]},
    {input, [
        {<<"product_ids1">>, [10, 20, 100, 10]},
        {<<"product_ids2">>, [10, 20, 100, 10]},
        {<<"product_ids3">>, [10, 20, 100, 10]},
        {<<"user_ids">>, <<>>},
        {<<"empty_list">>, []}
    ]},
    {output, [
        {<<"product_ids1">>, [10, 20, 100, 10]},
        {<<"product_ids2">>, [10, 20, 100, 10]},
        {<<"product_ids3">>, [10, 20, 100, 10]},
        {<<"user_ids">>, <<>>},
        {<<"empty_list">>, []}
    ]}
].
