%% LIVR positive/29-or (case: 'or', form: proplists)
%% Source: https://github.com/koorchik/LIVR/tree/14e5a1b19011d3e9bf6ab5a6a0dd4444bea8b280/test_suite/positive/29-or
%% Imported for liver; iso_date outputs use Erlang {Y,M,D} dates.
%% Proplist fixtures preserve JSON key order from json:decode/3.

[
    {name, 'or'},
    {rules, [
        {<<"id1-1">>, [
            {'or', [email, positive_integer]}
        ]},
        {<<"id1-2">>, [
            {'or', [email, positive_integer]}
        ]},
        {<<"id2-1">>, [
            [
                {'or', [email, positive_integer]}
            ],
            to_lc
        ]},
        {<<"id2-2">>, [
            [
                {'or', [email, positive_integer]}
            ],
            to_lc
        ]},
        {<<"id3-1">>, [
            {'or', [
                [
                    {min_length, 15}
                ],
                [email, to_lc]
            ]}
        ]},
        {<<"id3-2">>, [
            {'or', [
                [
                    {min_length, 15}
                ],
                [email, to_lc]
            ]}
        ]},
        {<<"id4-1">>, [
            {'or', [email, positive_integer]}
        ]},
        {<<"id4-2">>, [
            {'or', [email, positive_integer]}
        ]},
        {<<"products">>, [
            {list_of, [
                {'or', [
                    [
                        {nested_object, [
                            {<<"product_type">>, [
                                required,
                                [
                                    {eq, <<"material">>}
                                ]
                            ]},
                            {<<"material_id">>, [required, positive_integer]},
                            {<<"quantity">>, [
                                required,
                                [
                                    {min_number, 1}
                                ]
                            ]},
                            {<<"warehouse_id">>, positive_integer}
                        ]}
                    ],
                    [
                        {nested_object, [
                            {<<"product_type">>, [
                                required,
                                [
                                    {eq, <<"service">>}
                                ]
                            ]},
                            {<<"name">>, [
                                required,
                                [
                                    {max_length, 20}
                                ]
                            ]}
                        ]}
                    ]
                ]}
            ]}
        ]},
        {<<"missing_with_modifier">>, [
            {'or', [
                [to_lc, integer],
                string
            ]}
        ]}
    ]},
    {input, [
        {<<"id1-1">>, <<"User@mail.com">>},
        {<<"id1-2">>, 123},
        {<<"id2-1">>, <<"User@mail.com">>},
        {<<"id2-2">>, 123},
        {<<"id3-1">>, <<"User@mail.com">>},
        {<<"id3-2">>, <<"UserUserUser@mail.com">>},
        {<<"id4-1">>, <<>>},
        {<<"products">>, [
            [
                {<<"product_type">>, <<"material">>},
                {<<"material_id">>, 123},
                {<<"quantity">>, 10},
                {<<"warehouse_id">>, 321}
            ],
            [
                {<<"product_type">>, <<"service">>},
                {<<"name">>, <<"Some service">>},
                {<<"extra_field">>, <<"some data">>}
            ]
        ]}
    ]},
    {output, [
        {<<"id1-1">>, <<"User@mail.com">>},
        {<<"id1-2">>, 123},
        {<<"id2-1">>, <<"user@mail.com">>},
        {<<"id2-2">>, <<"123">>},
        {<<"id3-1">>, <<"user@mail.com">>},
        {<<"id3-2">>, <<"UserUserUser@mail.com">>},
        {<<"id4-1">>, <<>>},
        {<<"products">>, [
            [
                {<<"product_type">>, <<"material">>},
                {<<"material_id">>, 123},
                {<<"quantity">>, 10},
                {<<"warehouse_id">>, 321}
            ],
            [
                {<<"product_type">>, <<"service">>},
                {<<"name">>, <<"Some service">>}
            ]
        ]}
    ]}
].
