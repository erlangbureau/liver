%% LIVR positive/01-required (case: required, form: proplists)
%% Source: https://github.com/koorchik/LIVR/tree/4384f09e60d758d5c3ef3c76e8a29eac8ec688a0/test_suite/positive/01-required
%% Imported for liver; iso_date outputs use Erlang {Y,M,D} dates.
%% Proplist fixtures preserve JSON key order from json:decode/3.

[
    {name, required},
    {rules, [
        {<<"first_name">>, required},
        {<<"last_name">>, [required]},
        {<<"middle_name">>, [
            [
                {required, []}
            ]
        ]},
        {<<"salary">>, [
            {required, []}
        ]},
        {<<"constructor">>, required},
        {<<"toString">>, required},
        {<<"hasOwnProperty">>, required}
    ]},
    {input, [
        {<<"first_name">>, <<"Vasya">>},
        {<<"last_name">>, <<"Pupkin">>},
        {<<"middle_name">>, <<"Some">>},
        {<<"age">>, <<"25">>},
        {<<"__proto__">>, [
            {<<"polluted">>, <<"yes">>}
        ]},
        {<<"salary">>, 0},
        {<<"constructor">>, <<"Constructor value">>},
        {<<"toString">>, <<"ToString value">>},
        {<<"hasOwnProperty">>, <<"HasOwnProperty value">>}
    ]},
    {output, [
        {<<"first_name">>, <<"Vasya">>},
        {<<"last_name">>, <<"Pupkin">>},
        {<<"middle_name">>, <<"Some">>},
        {<<"salary">>, 0},
        {<<"constructor">>, <<"Constructor value">>},
        {<<"toString">>, <<"ToString value">>},
        {<<"hasOwnProperty">>, <<"HasOwnProperty value">>}
    ]}
].
