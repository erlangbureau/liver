%% LIVR positive/03-one_of (case: one_of, form: proplists)
%% Source: https://github.com/koorchik/LIVR/tree/44f0453b2cff7fdbb23c6cf48abe29fa8c601bf8/test_suite/positive/03-one_of
%% Imported for liver; iso_date outputs use Erlang {Y,M,D} dates.
%% Proplist fixtures preserve JSON key order from json:decode/3.

[
    {name, one_of},
    {rules, [
        {<<"city1">>, [
            {one_of, [
                [<<"Moscow">>, <<"Kiev">>]
            ]}
        ]},
        {<<"city2">>, [
            [
                {one_of, [
                    [<<"Moscow">>, <<"Kiev">>]
                ]}
            ]
        ]},
        {<<"city3">>, [
            {one_of, [<<"Moscow">>, <<"Kiev">>]}
        ]},
        {<<"number1">>, [
            {one_of, [1, 2]}
        ]},
        {<<"number2">>, [
            {one_of, [<<"1">>, <<"2">>]}
        ]},
        {<<"number3">>, [
            {one_of, 1.2}
        ]},
        {<<"boolean">>, [
            {one_of, [true, false]}
        ]},
        {<<"empty_city">>, [
            {one_of, [
                [<<"Moscow">>, <<"Kiev">>]
            ]}
        ]}
    ]},
    {input, [
        {<<"city1">>, <<"Moscow">>},
        {<<"city2">>, <<"Kiev">>},
        {<<"city3">>, <<"Kiev">>},
        {<<"number1">>, 2},
        {<<"number2">>, 2},
        {<<"number3">>, 1.2},
        {<<"boolean">>, true},
        {<<"empty_city">>, <<>>},
        {<<"extra_city">>, <<"New York">>}
    ]},
    {output, [
        {<<"city1">>, <<"Moscow">>},
        {<<"city2">>, <<"Kiev">>},
        {<<"city3">>, <<"Kiev">>},
        {<<"number1">>, 2},
        {<<"number2">>, <<"2">>},
        {<<"number3">>, 1.2},
        {<<"boolean">>, true},
        {<<"empty_city">>, <<>>}
    ]}
].
