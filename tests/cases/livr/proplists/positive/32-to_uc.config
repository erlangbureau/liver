%% LIVR positive/32-to_uc (case: to_uc, form: proplists)
%% Source: https://github.com/koorchik/LIVR/tree/44f0453b2cff7fdbb23c6cf48abe29fa8c601bf8/test_suite/positive/32-to_uc
%% Imported for liver; iso_date outputs use Erlang {Y,M,D} dates.
%% Proplist fixtures preserve JSON key order from json:decode/3.

[
    {name, to_uc},
    {rules, [
        {<<"string_value">>, to_uc},
        {<<"unicode_string">>, to_uc},
        {<<"decimal_value">>, [to_uc]},
        {<<"object">>, [
            {nested_object, [
                {<<"string_value">>, to_uc}
            ]}
        ]},
        {<<"list_of_string_values">>, [
            {list_of, to_uc}
        ]}
    ]},
    {input, [
        {<<"string_value">>, <<"Value">>},
        {<<"unicode_string">>, <<"привет"/utf8>>},
        {<<"decimal_value">>, 1.2},
        {<<"object">>, [
            {<<"string_value">>, <<"Some Value">>}
        ]},
        {<<"list_of_string_values">>, [
            <<"value1">>,
            [
                {<<"key">>, <<"123">>}
            ],
            <<"value2">>
        ]}
    ]},
    {output, [
        {<<"string_value">>, <<"VALUE">>},
        {<<"unicode_string">>, <<"ПРИВЕТ"/utf8>>},
        {<<"decimal_value">>, <<"1.2">>},
        {<<"object">>, [
            {<<"string_value">>, <<"SOME VALUE">>}
        ]},
        {<<"list_of_string_values">>, [
            <<"VALUE1">>,
            [
                {<<"key">>, <<"123">>}
            ],
            <<"VALUE2">>
        ]}
    ]}
].
