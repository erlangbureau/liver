%% LIVR positive/14-min_number (case: min_number, form: proplists)
%% Source: https://github.com/koorchik/LIVR/tree/44f0453b2cff7fdbb23c6cf48abe29fa8c601bf8/test_suite/positive/14-min_number
%% Imported for liver; iso_date outputs use Erlang {Y,M,D} dates.
%% Proplist fixtures preserve JSON key order from jsx:decode/1.

[
    {name, min_number},
    {rules, [
        {<<"number1">>, [
            {min_number, 10}
        ]},
        {<<"number2">>, [
            {min_number, [20]}
        ]},
        {<<"number3">>, [
            [
                {min_number, [30]}
            ]
        ]},
        {<<"empty_field">>, [
            {min_number, 10}
        ]}
    ]},
    {input, [
        {<<"number1">>, <<"10">>},
        {<<"number2">>, 25},
        {<<"number3">>, 40},
        {<<"empty_field">>, <<>>},
        {<<"extra_field">>, <<"100">>}
    ]},
    {output, [
        {<<"number1">>, 10},
        {<<"number2">>, 25},
        {<<"number3">>, 40},
        {<<"empty_field">>, <<>>}
    ]}
].
