%% LIVR positive/20-list_of_objects (case: list_of_objects, form: proplists)
%% Source: https://github.com/koorchik/LIVR/tree/44f0453b2cff7fdbb23c6cf48abe29fa8c601bf8/test_suite/positive/20-list_of_objects
%% Imported for liver; iso_date outputs use Erlang {Y,M,D} dates.
%% Proplist fixtures preserve JSON key order from jsx:decode/1.

[
    {name, list_of_objects},
    {rules, [
        {<<"products">>, [
            required,
            [
                {list_of_objects, [
                    {<<"product_id">>, [required, positive_integer]},
                    {<<"quantity">>, [required, positive_integer]}
                ]}
            ]
        ]},
        {<<"empty_list">>, [
            [
                {list_of_objects, [
                    {<<"some_field">>, [required]}
                ]}
            ]
        ]}
    ]},
    {input, [
        {<<"products">>, [
            [
                {<<"product_id">>, 10},
                {<<"quantity">>, <<"10">>}
            ],
            [
                {<<"product_id">>, 20},
                {<<"quantity">>, 20}
            ],
            [
                {<<"product_id">>, 30},
                {<<"quantity">>, 30}
            ]
        ]},
        {<<"empty_list">>, []}
    ]},
    {output, [
        {<<"products">>, [
            [
                {<<"product_id">>, 10},
                {<<"quantity">>, 10}
            ],
            [
                {<<"product_id">>, 20},
                {<<"quantity">>, 20}
            ],
            [
                {<<"product_id">>, 30},
                {<<"quantity">>, 30}
            ]
        ]},
        {<<"empty_list">>, []}
    ]}
].
