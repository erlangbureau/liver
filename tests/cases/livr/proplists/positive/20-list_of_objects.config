%% LIVR positive/20-list_of_objects (case: list_of_objects, form: proplists)
%% Source: https://github.com/koorchik/LIVR/tree/14e5a1b19011d3e9bf6ab5a6a0dd4444bea8b280/test_suite/positive/20-list_of_objects
%% Imported for liver; iso_date outputs use Erlang {Y,M,D} dates.
%% Proplist fixtures preserve JSON key order from json:decode/3.

[
    {name, list_of_objects},
    {rules, [
        {<<"products">>, [
            required,
            [
                {list_of_objects, [
                    {<<"product_id">>, [required, positive_integer]},
                    {<<"quantity">>, [required, positive_integer]}
                ]}
            ]
        ]},
        {<<"empty_list">>, [
            [
                {list_of_objects, [
                    {<<"some_field">>, [required]}
                ]}
            ]
        ]}
    ]},
    {input, [
        {<<"products">>, [
            [
                {<<"product_id">>, 10},
                {<<"quantity">>, <<"10">>}
            ],
            [
                {<<"product_id">>, 20},
                {<<"quantity">>, 20}
            ],
            [
                {<<"product_id">>, 30},
                {<<"quantity">>, 30}
            ]
        ]},
        {<<"empty_list">>, []}
    ]},
    {output, [
        {<<"products">>, [
            [
                {<<"product_id">>, 10},
                {<<"quantity">>, 10}
            ],
            [
                {<<"product_id">>, 20},
                {<<"quantity">>, 20}
            ],
            [
                {<<"product_id">>, 30},
                {<<"quantity">>, 30}
            ]
        ]},
        {<<"empty_list">>, []}
    ]}
].
