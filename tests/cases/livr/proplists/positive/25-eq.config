%% LIVR positive/25-eq (case: eq, form: proplists)
%% Source: https://github.com/koorchik/LIVR/tree/44f0453b2cff7fdbb23c6cf48abe29fa8c601bf8/test_suite/positive/25-eq
%% Imported for liver; iso_date outputs use Erlang {Y,M,D} dates.
%% Proplist fixtures preserve JSON key order from json:decode/3.

[
    {name, eq},
    {rules, [
        {<<"city1">>, [
            {eq, <<"Moscow">>}
        ]},
        {<<"city2">>, [
            [
                {eq, <<"Kiev">>}
            ]
        ]},
        {<<"city3">>, [
            {eq, <<"Kiev">>}
        ]},
        {<<"city4">>, [
            [
                {eq, [<<"Dnipro">>]}
            ]
        ]},
        {<<"number1">>, [
            {eq, 2}
        ]},
        {<<"number2">>, [
            {eq, <<"2">>}
        ]},
        {<<"empty_city">>, [
            {eq, <<"Kiev">>}
        ]}
    ]},
    {input, [
        {<<"city1">>, <<"Moscow">>},
        {<<"city2">>, <<"Kiev">>},
        {<<"city3">>, <<"Kiev">>},
        {<<"city4">>, <<"Dnipro">>},
        {<<"number1">>, <<"2">>},
        {<<"number2">>, 2},
        {<<"empty_city">>, <<>>},
        {<<"extra_city">>, <<"New York">>}
    ]},
    {output, [
        {<<"city1">>, <<"Moscow">>},
        {<<"city2">>, <<"Kiev">>},
        {<<"city3">>, <<"Kiev">>},
        {<<"city4">>, <<"Dnipro">>},
        {<<"number1">>, 2},
        {<<"number2">>, <<"2">>},
        {<<"empty_city">>, <<>>}
    ]}
].
