%% LIVR positive/25-eq (case: eq, form: proplists)
%% Source: https://github.com/koorchik/LIVR/tree/4384f09e60d758d5c3ef3c76e8a29eac8ec688a0/test_suite/positive/25-eq
%% Imported for liver; iso_date outputs use Erlang {Y,M,D} dates.
%% Proplist fixtures preserve JSON key order from json:decode/3.

[
    {name, eq},
    {rules, [
        {<<"city1">>, [
            {eq, <<"Lviv">>}
        ]},
        {<<"city2">>, [
            [
                {eq, <<"Kyiv">>}
            ]
        ]},
        {<<"city3">>, [
            {eq, <<"Kyiv">>}
        ]},
        {<<"city4">>, [
            [
                {eq, [<<"Dnipro">>]}
            ]
        ]},
        {<<"number1">>, [
            {eq, 2}
        ]},
        {<<"number2">>, [
            {eq, <<"2">>}
        ]},
        {<<"empty_city">>, [
            {eq, <<"Kyiv">>}
        ]}
    ]},
    {input, [
        {<<"city1">>, <<"Lviv">>},
        {<<"city2">>, <<"Kyiv">>},
        {<<"city3">>, <<"Kyiv">>},
        {<<"city4">>, <<"Dnipro">>},
        {<<"number1">>, <<"2">>},
        {<<"number2">>, 2},
        {<<"empty_city">>, <<>>},
        {<<"extra_city">>, <<"New York">>}
    ]},
    {output, [
        {<<"city1">>, <<"Lviv">>},
        {<<"city2">>, <<"Kyiv">>},
        {<<"city3">>, <<"Kyiv">>},
        {<<"city4">>, <<"Dnipro">>},
        {<<"number1">>, 2},
        {<<"number2">>, <<"2">>},
        {<<"empty_city">>, <<>>}
    ]}
].
