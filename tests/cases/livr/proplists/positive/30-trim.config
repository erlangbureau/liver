%% LIVR positive/30-trim (case: trim, form: proplists)
%% Source: https://github.com/koorchik/LIVR/tree/4384f09e60d758d5c3ef3c76e8a29eac8ec688a0/test_suite/positive/30-trim
%% Imported for liver; iso_date outputs use Erlang {Y,M,D} dates.
%% Proplist fixtures preserve JSON key order from json:decode/3.

[
    {name, trim},
    {rules, [
        {<<"string_value">>, trim},
        {<<"decimal_value">>, [trim]},
        {<<"unicode_string">>, trim},
        {<<"object">>, [
            {nested_object, [
                {<<"string_value">>, trim}
            ]}
        ]},
        {<<"list_of_string_values">>, [
            {list_of, trim}
        ]}
    ]},
    {input, [
        {<<"string_value">>, <<" value ">>},
        {<<"decimal_value">>, 1.2},
        {<<"unicode_string">>, <<" Привет "/utf8>>},
        {<<"object">>, [
            {<<"string_value">>, <<" some value ">>}
        ]},
        {<<"list_of_string_values">>, [
            <<" value1 ">>,
            [
                {<<"key">>, <<"123">>}
            ],
            <<" value2 ">>
        ]}
    ]},
    {output, [
        {<<"string_value">>, <<"value">>},
        {<<"decimal_value">>, <<"1.2">>},
        {<<"unicode_string">>, <<"Привет"/utf8>>},
        {<<"object">>, [
            {<<"string_value">>, <<"some value">>}
        ]},
        {<<"list_of_string_values">>, [
            <<"value1">>,
            [
                {<<"key">>, <<"123">>}
            ],
            <<"value2">>
        ]}
    ]}
].
