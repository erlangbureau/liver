%% LIVR positive/26-string (case: string, form: proplists)
%% Source: https://github.com/koorchik/LIVR/tree/14e5a1b19011d3e9bf6ab5a6a0dd4444bea8b280/test_suite/positive/26-string
%% Imported for liver; iso_date outputs use Erlang {Y,M,D} dates.
%% Proplist fixtures preserve JSON key order from json:decode/3.

[
    {name, string},
    {rules, [
        {<<"city1">>, string},
        {<<"city2">>, [
            [
                {string, []}
            ]
        ]},
        {<<"number1">>, string},
        {<<"number2">>, string},
        {<<"empty_city">>, string},
        {<<"null_value">>, string}
    ]},
    {input, [
        {<<"city1">>, <<"Lviv">>},
        {<<"city2">>, <<"Kyiv">>},
        {<<"number1">>, <<"2">>},
        {<<"number2">>, 2},
        {<<"empty_city">>, <<>>},
        {<<"extra_city">>, <<"New York">>},
        {<<"null_value">>, null}
    ]},
    {output, [
        {<<"city1">>, <<"Lviv">>},
        {<<"city2">>, <<"Kyiv">>},
        {<<"number1">>, <<"2">>},
        {<<"number2">>, <<"2">>},
        {<<"empty_city">>, <<>>},
        {<<"null_value">>, null}
    ]}
].
