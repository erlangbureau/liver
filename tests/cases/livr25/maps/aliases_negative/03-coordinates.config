%% LIVR aliases_negative/03-coordinates (case: coordinates, form: maps)
%% Source: https://github.com/koorchik/LIVR/tree/14e5a1b19011d3e9bf6ab5a6a0dd4444bea8b280/test_suite_2.5/aliases_negative/03-coordinates
%% Imported for liver; iso_date outputs use Erlang {Y,M,D} dates.
%% Proplist fixtures preserve JSON key order from json:decode/3.

#{
    input => #{
        <<"path">> => [
            [0, 0],
            [10, <<>>],
            <<"x">>
        ],
        <<"place1">> => #{
            <<"lat">> => 95,
            <<"lng">> => 30
        },
        <<"place2">> => #{
            <<"lng">> => <<"-200">>
        },
        <<"places">> => [
            #{
                <<"lat">> => 0,
                <<"lng">> => 0
            },
            <<"x">>
        ],
        <<"point1">> => [30.5234],
        <<"point2">> => [200, 50, 1],
        <<"point3">> => [30.5234, <<"x">>]
    },
    name => coordinates,
    opts => #{
        aliased_rules => [
            #{
                name => point,
                rules => [
                    #{
                        list_length => 2
                    },
                    #{
                        list_of => [required, decimal]
                    }
                ]
            },
            #{
                name => coordinates,
                rules => #{
                    nested_object => #{
                        <<"lat">> => [
                            required,
                            decimal,
                            #{
                                number_between => [-90, 90]
                            }
                        ],
                        <<"lng">> => [
                            required,
                            decimal,
                            #{
                                number_between => [-180, 180]
                            }
                        ]
                    }
                }
            }
        ]
    },
    rules => #{
        <<"path">> => #{
            list_of => <<"point">>
        },
        <<"place1">> => <<"coordinates">>,
        <<"place2">> => [required, <<"coordinates">>],
        <<"places">> => #{
            list_of => <<"coordinates">>
        },
        <<"point1">> => <<"point">>,
        <<"point2">> => [required, <<"point">>],
        <<"point3">> => <<"point">>
    },
    errors => #{
        <<"path">> => [
            null,
            [null, <<"REQUIRED">>],
            <<"FORMAT_ERROR">>
        ],
        <<"place1">> => #{
            <<"lat">> => <<"TOO_HIGH">>
        },
        <<"place2">> => #{
            <<"lat">> => <<"REQUIRED">>,
            <<"lng">> => <<"TOO_LOW">>
        },
        <<"places">> => [null, <<"FORMAT_ERROR">>],
        <<"point1">> => <<"TOO_FEW_ITEMS">>,
        <<"point2">> => <<"TOO_MANY_ITEMS">>,
        <<"point3">> => [null, <<"NOT_DECIMAL">>]
    }
}.
