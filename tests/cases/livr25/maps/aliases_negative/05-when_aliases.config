%% Imported for liver; iso_date outputs use Erlang {Y,M,D} dates.
%% Proplist fixtures preserve JSON key order from json:decode/3.

#{
    input => #{
        <<"data">> => #{
            <<"number">> => <<"4111111111111112">>
        },
        <<"orders">> => [
            #{
                <<"data">> => #{
                    <<"number">> => <<"4111111111111111">>
                }
            },
            #{
                <<"data">> => <<>>
            }
        ],
        <<"pay_type">> => <<"card">>,
        <<"payments">> => [
            #{
                <<"number">> => <<"4111111111111111">>
            }
        ],
        <<"person">> => #{
            <<"type">> => <<"person">>,
            <<"vat_number">> => <<"UA12345678">>
        },
        <<"type">> => <<"company">>
    },
    name => when_aliases,
    opts => #{
        aliased_rules => [
            #{
                name => vat_by_type,
                rules => #{
                    'when' => [
                        <<"type">>,
                        #{
                            eq => <<"company">>
                        },
                        [
                            required,
                            #{
                                like => <<"^[A-Z]{2}[0-9]{8,12}$">>
                            }
                        ],
                        #{
                            eq => <<>>
                        }
                    ]
                }
            },
            #{
                name => case_by_mode,
                rules => #{
                    'when' => [
                        <<"mode">>,
                        #{
                            eq => <<"upper">>
                        },
                        to_uc,
                        to_lc
                    ]
                }
            },
            #{
                name => payment_data,
                rules => #{
                    'when' => [
                        <<"pay_type">>,
                        #{
                            <<"bank">> => #{
                                nested_object => #{
                                    <<"iban">> => [required, iban]
                                }
                            },
                            <<"card">> => #{
                                nested_object => #{
                                    <<"number">> => [required, credit_card]
                                }
                            }
                        }
                    ]
                }
            },
            #{
                name => required_payment_data,
                rules => [required, <<"payment_data">>]
            }
        ]
    },
    rules => #{
        <<"data">> => <<"required_payment_data">>,
        <<"either">> => #{
            'or' => [
                [
                    required,
                    #{
                        eq => <<"none">>
                    }
                ],
                <<"vat_by_type">>
            ]
        },
        <<"orders">> => #{
            list_of_objects => #{
                <<"data">> => <<"payment_data">>
            }
        },
        <<"pay_type">> => [
            required,
            #{
                one_of => [<<"card">>, <<"bank">>]
            }
        ],
        <<"payments">> => #{
            list_of => <<"payment_data">>
        },
        <<"person">> => #{
            nested_object => #{
                <<"type">> => required,
                <<"vat_number">> => <<"vat_by_type">>
            }
        },
        <<"type">> => string,
        <<"vat_number">> => <<"vat_by_type">>
    },
    errors => #{
        <<"data">> => #{
            <<"number">> => <<"WRONG_CREDIT_CARD_NUMBER">>
        },
        <<"either">> => <<"REQUIRED">>,
        <<"orders">> => [
            #{
                <<"data">> => <<"NOT_ALLOWED_VALUE">>
            },
            null
        ],
        <<"payments">> => [<<"NOT_ALLOWED_VALUE">>],
        <<"person">> => #{
            <<"vat_number">> => <<"NOT_ALLOWED_VALUE">>
        },
        <<"vat_number">> => <<"REQUIRED">>
    }
}.
