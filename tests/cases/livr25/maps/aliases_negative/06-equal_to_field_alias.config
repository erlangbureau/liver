%% LIVR aliases_negative/06-equal_to_field_alias (case: equal_to_field_alias, form: maps)
%% Source: https://github.com/koorchik/LIVR/tree/14e5a1b19011d3e9bf6ab5a6a0dd4444bea8b280/test_suite_2.5/aliases_negative/06-equal_to_field_alias
%% Imported for liver; iso_date outputs use Erlang {Y,M,D} dates.
%% Proplist fixtures preserve JSON key order from json:decode/3.

#{
    input => #{
        <<"account">> => #{
            <<"password">> => <<"abc">>,
            <<"password2">> => <<"s3cret">>
        },
        <<"alias_copies">> => [<<"s3cret">>],
        <<"copies">> => [<<"s3cret">>, <<>>],
        <<"either">> => <<"other">>,
        <<"password">> => <<"s3cret">>,
        <<"password2">> => <<"s3cret!">>,
        <<"password3">> => <<"S3CRET">>,
        <<"password4">> => <<>>,
        <<"users">> => [
            #{
                <<"password">> => <<"x1">>,
                <<"password2">> => <<"x1">>
            },
            #{
                <<"password">> => <<"y2">>,
                <<"password2">> => <<"s3cret">>
            }
        ],
        <<"value_copies">> => #{
            <<"other">> => <<"s3cret">>,
            <<"password">> => <<"s3cret">>
        }
    },
    name => equal_to_field_alias,
    opts => #{
        aliased_rules => [
            #{
                name => password_confirmation,
                rules => [
                    required,
                    #{
                        equal_to_field => <<"password">>
                    }
                ]
            },
            #{
                error => <<"PASSWORDS_DIFFER">>,
                name => same_as_password,
                rules => #{
                    equal_to_field => <<"password">>
                }
            }
        ]
    },
    rules => #{
        <<"account">> => #{
            nested_object => #{
                <<"password">> => required,
                <<"password2">> => <<"password_confirmation">>
            }
        },
        <<"alias_copies">> => #{
            list_of => <<"same_as_password">>
        },
        <<"copies">> => #{
            list_of => #{
                equal_to_field => <<"password">>
            }
        },
        <<"either">> => #{
            'or' => [
                [
                    required,
                    #{
                        eq => <<"none">>
                    }
                ],
                #{
                    equal_to_field => <<"password">>
                }
            ]
        },
        <<"password">> => required,
        <<"password2">> => <<"password_confirmation">>,
        <<"password3">> => <<"same_as_password">>,
        <<"password4">> => <<"password_confirmation">>,
        <<"users">> => #{
            list_of_objects => #{
                <<"password">> => required,
                <<"password2">> => <<"same_as_password">>
            }
        },
        <<"value_copies">> => #{
            values => #{
                equal_to_field => <<"password">>
            }
        }
    },
    errors => #{
        <<"account">> => #{
            <<"password2">> => <<"FIELDS_NOT_EQUAL">>
        },
        <<"alias_copies">> => [<<"PASSWORDS_DIFFER">>],
        <<"copies">> => [<<"FIELDS_NOT_EQUAL">>, null],
        <<"either">> => <<"FIELDS_NOT_EQUAL">>,
        <<"password2">> => <<"FIELDS_NOT_EQUAL">>,
        <<"password3">> => <<"PASSWORDS_DIFFER">>,
        <<"password4">> => <<"REQUIRED">>,
        <<"users">> => [
            null,
            #{
                <<"password2">> => <<"PASSWORDS_DIFFER">>
            }
        ],
        <<"value_copies">> => #{
            <<"other">> => <<"FIELDS_NOT_EQUAL">>,
            <<"password">> => <<"FIELDS_NOT_EQUAL">>
        }
    }
}.
