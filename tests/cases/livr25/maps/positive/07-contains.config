%% Imported for liver; iso_date outputs use Erlang {Y,M,D} dates.
%% Proplist fixtures preserve JSON key order from json:decode/3.

#{
    input => #{
        <<"big_integer">> => 123456789012345,
        <<"boolean">> => true,
        <<"comment">> => <<"user@example.com">>,
        <<"comment_in_list">> => <<"@">>,
        <<"empty_field">> => <<>>,
        <<"exponent">> => 1.0e3,
        <<"extra_field">> => <<"extra">>,
        <<"fraction">> => 0.1,
        <<"negative_fraction">> => -12.25,
        <<"null_field">> => null,
        <<"number">> => 12345,
        <<"number_fraction">> => 0.5,
        <<"one_of_several">> => <<"a bar b">>
    },
    name => contains,
    output => #{
        <<"big_integer">> => <<"123456789012345">>,
        <<"boolean">> => <<"true">>,
        <<"comment">> => <<"user@example.com">>,
        <<"comment_in_list">> => <<"@">>,
        <<"empty_field">> => <<>>,
        <<"exponent">> => <<"1000">>,
        <<"fraction">> => <<"0.1">>,
        <<"negative_fraction">> => <<"-12.25">>,
        <<"null_field">> => null,
        <<"number">> => <<"12345">>,
        <<"number_fraction">> => <<"0.5">>,
        <<"one_of_several">> => <<"a bar b">>
    },
    rules => #{
        <<"big_integer">> => #{
            contains => <<"6789">>
        },
        <<"boolean">> => #{
            contains => <<"ru">>
        },
        <<"comment">> => #{
            contains => <<"@">>
        },
        <<"comment_in_list">> => [
            #{
                contains => <<"@">>
            }
        ],
        <<"empty_field">> => #{
            contains => <<"@">>
        },
        <<"exponent">> => #{
            contains => <<"00">>
        },
        <<"fraction">> => #{
            contains => <<".">>
        },
        <<"missing_field">> => #{
            contains => <<"@">>
        },
        <<"negative_fraction">> => #{
            contains => <<"2.2">>
        },
        <<"null_field">> => #{
            contains => <<"@">>
        },
        <<"number">> => #{
            contains => <<"234">>
        },
        <<"number_fraction">> => #{
            contains => <<".">>
        },
        <<"one_of_several">> => #{
            contains => [<<"foo">>, <<"bar">>]
        }
    }
}.
