%% LIVR positive/05-starts_with (case: starts_with, form: maps)
%% Source: https://github.com/koorchik/LIVR/tree/44955f198e7cbd2d6ec2fb1926c9fe8bd2e5628d/test_suite_2.5/positive/05-starts_with
%% Imported for liver; iso_date outputs use Erlang {Y,M,D} dates.
%% Proplist fixtures preserve JSON key order from json:decode/3.

#{
    input => #{
        <<"big_integer">> => 123456789012345,
        <<"boolean">> => true,
        <<"empty_field">> => <<>>,
        <<"exponent">> => 1.0e3,
        <<"extra_field">> => <<"extra">>,
        <<"fraction">> => 0.1,
        <<"minus_zero">> => -0.0,
        <<"negative_fraction">> => -12.25,
        <<"null_field">> => null,
        <<"number">> => 123,
        <<"number_argument">> => <<"123">>,
        <<"number_argument_number_value">> => 15,
        <<"number_with_trailing_zero">> => 1.5,
        <<"one_point_zero">> => 1.0,
        <<"single_prefix">> => <<"ID-123">>,
        <<"single_prefix_in_list">> => <<"ID-">>,
        <<"unicode">> => <<"Привіт"/utf8>>,
        <<"website1">> => <<"https://example.com">>,
        <<"website2">> => <<"http://example.com">>
    },
    name => starts_with,
    output => #{
        <<"big_integer">> => <<"123456789012345">>,
        <<"boolean">> => <<"true">>,
        <<"empty_field">> => <<>>,
        <<"exponent">> => <<"1000">>,
        <<"fraction">> => <<"0.1">>,
        <<"minus_zero">> => <<"0">>,
        <<"negative_fraction">> => <<"-12.25">>,
        <<"null_field">> => null,
        <<"number">> => <<"123">>,
        <<"number_argument">> => <<"123">>,
        <<"number_argument_number_value">> => <<"15">>,
        <<"number_with_trailing_zero">> => <<"1.5">>,
        <<"one_point_zero">> => <<"1">>,
        <<"single_prefix">> => <<"ID-123">>,
        <<"single_prefix_in_list">> => <<"ID-">>,
        <<"unicode">> => <<"Привіт"/utf8>>,
        <<"website1">> => <<"https://example.com">>,
        <<"website2">> => <<"http://example.com">>
    },
    rules => #{
        <<"big_integer">> => #{
            starts_with => <<"1234567890">>
        },
        <<"boolean">> => #{
            starts_with => <<"tr">>
        },
        <<"empty_field">> => #{
            starts_with => [<<"https://">>, <<"http://">>]
        },
        <<"exponent">> => #{
            starts_with => <<"1000">>
        },
        <<"fraction">> => #{
            starts_with => <<"0.1">>
        },
        <<"minus_zero">> => #{
            starts_with => <<"0">>
        },
        <<"missing_field">> => #{
            starts_with => [<<"https://">>, <<"http://">>]
        },
        <<"negative_fraction">> => #{
            starts_with => <<"-12.2">>
        },
        <<"null_field">> => #{
            starts_with => [<<"https://">>, <<"http://">>]
        },
        <<"number">> => #{
            starts_with => <<"12">>
        },
        <<"number_argument">> => #{
            starts_with => 1
        },
        <<"number_argument_number_value">> => #{
            starts_with => [2, 1]
        },
        <<"number_with_trailing_zero">> => #{
            starts_with => <<"1.5">>
        },
        <<"one_point_zero">> => #{
            starts_with => <<"1">>
        },
        <<"single_prefix">> => #{
            starts_with => <<"ID-">>
        },
        <<"single_prefix_in_list">> => #{
            starts_with => [<<"ID-">>]
        },
        <<"unicode">> => #{
            starts_with => <<"При"/utf8>>
        },
        <<"website1">> => #{
            starts_with => [<<"https://">>, <<"http://">>]
        },
        <<"website2">> => [
            #{
                starts_with => [<<"https://">>, <<"http://">>]
            }
        ]
    }
}.
