%% LIVR positive/06-ends_with (case: ends_with, form: maps)
%% Source: https://github.com/koorchik/LIVR/tree/14e5a1b19011d3e9bf6ab5a6a0dd4444bea8b280/test_suite_2.5/positive/06-ends_with
%% Imported for liver; iso_date outputs use Erlang {Y,M,D} dates.
%% Proplist fixtures preserve JSON key order from json:decode/3.

#{
    input => #{
        <<"big_integer">> => 123456789012345,
        <<"boolean">> => false,
        <<"empty_field">> => <<>>,
        <<"exponent">> => 1.0e3,
        <<"extra_field">> => <<"extra">>,
        <<"file">> => <<"report.pdf">>,
        <<"file_in_list">> => <<".pdf">>,
        <<"image1">> => <<"photo.jpg">>,
        <<"image2">> => <<"photo.png">>,
        <<"minus_zero">> => -0.0,
        <<"negative_fraction">> => -12.25,
        <<"null_field">> => null,
        <<"number">> => 100
    },
    name => ends_with,
    output => #{
        <<"big_integer">> => <<"123456789012345">>,
        <<"boolean">> => <<"false">>,
        <<"empty_field">> => <<>>,
        <<"exponent">> => <<"1000">>,
        <<"file">> => <<"report.pdf">>,
        <<"file_in_list">> => <<".pdf">>,
        <<"image1">> => <<"photo.jpg">>,
        <<"image2">> => <<"photo.png">>,
        <<"minus_zero">> => <<"0">>,
        <<"negative_fraction">> => <<"-12.25">>,
        <<"null_field">> => null,
        <<"number">> => <<"100">>
    },
    rules => #{
        <<"big_integer">> => #{
            ends_with => <<"012345">>
        },
        <<"boolean">> => #{
            ends_with => <<"se">>
        },
        <<"empty_field">> => #{
            ends_with => <<".pdf">>
        },
        <<"exponent">> => #{
            ends_with => <<"000">>
        },
        <<"file">> => #{
            ends_with => <<".pdf">>
        },
        <<"file_in_list">> => [
            #{
                ends_with => <<".pdf">>
            }
        ],
        <<"image1">> => #{
            ends_with => [<<".jpg">>, <<".png">>]
        },
        <<"image2">> => #{
            ends_with => [<<".jpg">>, <<".png">>]
        },
        <<"minus_zero">> => #{
            ends_with => <<"0">>
        },
        <<"missing_field">> => #{
            ends_with => <<".pdf">>
        },
        <<"negative_fraction">> => #{
            ends_with => <<".25">>
        },
        <<"null_field">> => #{
            ends_with => <<".pdf">>
        },
        <<"number">> => #{
            ends_with => <<"00">>
        }
    }
}.
