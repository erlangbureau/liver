%% Imported for liver; iso_date outputs use Erlang {Y,M,D} dates.
%% Proplist fixtures preserve JSON key order from json:decode/3.

#{
    input => #{
        <<"boolean">> => false,
        <<"case_sensitive">> => <<"FOO">>,
        <<"empty_field">> => <<>>,
        <<"exponent">> => 1.0e3,
        <<"extra_field">> => <<"extra">>,
        <<"minus_zero">> => -0.0,
        <<"missing_at">> => <<"user.example.com">>,
        <<"none_of_several">> => <<"baz">>,
        <<"null_field">> => null,
        <<"number">> => 2.0,
        <<"one_point_zero">> => 1.0,
        <<"value_is_array">> => [<<"test">>, 1],
        <<"value_is_empty_array">> => [],
        <<"value_is_empty_hash">> => #{},
        <<"value_is_hash">> => #{
            <<"test">> => 1
        }
    },
    name => contains,
    rules => #{
        <<"boolean">> => #{
            contains => <<"ru">>
        },
        <<"case_sensitive">> => #{
            contains => [<<"foo">>, <<"bar">>]
        },
        <<"empty_field">> => #{
            contains => <<"@">>
        },
        <<"exponent">> => #{
            contains => <<"e">>
        },
        <<"minus_zero">> => #{
            contains => <<"-">>
        },
        <<"missing_at">> => #{
            contains => <<"@">>
        },
        <<"none_of_several">> => [
            #{
                contains => [<<"foo">>, <<"bar">>]
            }
        ],
        <<"null_field">> => #{
            contains => <<"@">>
        },
        <<"number">> => #{
            contains => <<".">>
        },
        <<"one_point_zero">> => #{
            contains => <<".">>
        },
        <<"value_is_array">> => #{
            contains => <<"@">>
        },
        <<"value_is_empty_array">> => #{
            contains => <<"@">>
        },
        <<"value_is_empty_hash">> => #{
            contains => <<"@">>
        },
        <<"value_is_hash">> => #{
            contains => <<"@">>
        }
    },
    errors => #{
        <<"boolean">> => <<"WRONG_FORMAT">>,
        <<"case_sensitive">> => <<"WRONG_FORMAT">>,
        <<"exponent">> => <<"WRONG_FORMAT">>,
        <<"minus_zero">> => <<"WRONG_FORMAT">>,
        <<"missing_at">> => <<"WRONG_FORMAT">>,
        <<"none_of_several">> => <<"WRONG_FORMAT">>,
        <<"number">> => <<"WRONG_FORMAT">>,
        <<"one_point_zero">> => <<"WRONG_FORMAT">>,
        <<"value_is_array">> => <<"FORMAT_ERROR">>,
        <<"value_is_empty_array">> => <<"FORMAT_ERROR">>,
        <<"value_is_empty_hash">> => <<"FORMAT_ERROR">>,
        <<"value_is_hash">> => <<"FORMAT_ERROR">>
    }
}.
