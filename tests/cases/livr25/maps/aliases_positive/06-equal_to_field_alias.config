%% LIVR aliases_positive/06-equal_to_field_alias (case: equal_to_field_alias, form: maps)
%% Source: https://github.com/koorchik/LIVR/tree/14e5a1b19011d3e9bf6ab5a6a0dd4444bea8b280/test_suite_2.5/aliases_positive/06-equal_to_field_alias
%% Imported for liver; iso_date outputs use Erlang {Y,M,D} dates.
%% Proplist fixtures preserve JSON key order from json:decode/3.

#{
    input => #{
        <<"account">> => #{
            <<"password">> => <<"abc">>,
            <<"password2">> => <<"abc">>
        },
        <<"either">> => <<"s3cret">>,
        <<"either_alias">> => <<"s3cret">>,
        <<"empty_copies">> => [<<>>],
        <<"extra_field">> => <<"x">>,
        <<"password">> => <<"s3cret">>,
        <<"password2">> => <<"s3cret">>,
        <<"password3">> => <<"s3cret">>,
        <<"users">> => [
            #{
                <<"password">> => <<"x1">>,
                <<"password2">> => <<"x1">>
            },
            #{
                <<"password">> => <<"y2">>,
                <<"password2">> => <<"y2">>
            }
        ]
    },
    name => equal_to_field_alias,
    output => #{
        <<"account">> => #{
            <<"password">> => <<"abc">>,
            <<"password2">> => <<"abc">>
        },
        <<"either">> => <<"s3cret">>,
        <<"either_alias">> => <<"s3cret">>,
        <<"empty_copies">> => [<<>>],
        <<"password">> => <<"s3cret">>,
        <<"password2">> => <<"s3cret">>,
        <<"password3">> => <<"s3cret">>,
        <<"users">> => [
            #{
                <<"password">> => <<"x1">>,
                <<"password2">> => <<"x1">>
            },
            #{
                <<"password">> => <<"y2">>,
                <<"password2">> => <<"y2">>
            }
        ]
    },
    opts => #{
        aliased_rules => [
            #{
                name => password_confirmation,
                rules => [
                    required,
                    #{
                        equal_to_field => <<"password">>
                    }
                ]
            },
            #{
                error => <<"PASSWORDS_DIFFER">>,
                name => same_as_password,
                rules => #{
                    equal_to_field => <<"password">>
                }
            }
        ]
    },
    rules => #{
        <<"account">> => #{
            nested_object => #{
                <<"password">> => required,
                <<"password2">> => <<"password_confirmation">>
            }
        },
        <<"either">> => #{
            'or' => [
                [
                    required,
                    #{
                        eq => <<"none">>
                    }
                ],
                #{
                    equal_to_field => <<"password">>
                }
            ]
        },
        <<"either_alias">> => #{
            'or' => [
                [
                    required,
                    #{
                        eq => <<"none">>
                    }
                ],
                <<"same_as_password">>
            ]
        },
        <<"empty_copies">> => #{
            list_of => <<"same_as_password">>
        },
        <<"password">> => required,
        <<"password2">> => <<"password_confirmation">>,
        <<"password3">> => <<"same_as_password">>,
        <<"users">> => #{
            list_of_objects => #{
                <<"password">> => required,
                <<"password2">> => <<"same_as_password">>
            }
        }
    }
}.
