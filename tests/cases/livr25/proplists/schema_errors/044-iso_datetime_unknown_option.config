%% LIVR schema_errors/044-iso_datetime_unknown_option (case: iso_datetime_unknown_option, form: proplists)
%% Source: https://github.com/koorchik/LIVR/tree/44955f198e7cbd2d6ec2fb1926c9fe8bd2e5628d/test_suite_2.5/schema_errors/044-iso_datetime_unknown_option
%% Imported for liver; iso_date outputs use Erlang {Y,M,D} dates.
%% Proplist fixtures preserve JSON key order from json:decode/3.

[
    {name, iso_datetime_unknown_option},
    {rules, [
        {<<"starts_at">>, [
            {iso_datetime, [
                {<<"timezone">>, <<"UTC">>}
            ]}
        ]}
    ]}
].
