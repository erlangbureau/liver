%% LIVR schema_errors/174-alias_uuid_version_number (case: alias_uuid_version_number, form: proplists)
%% Source: https://github.com/koorchik/LIVR/tree/44955f198e7cbd2d6ec2fb1926c9fe8bd2e5628d/test_suite_2.5/schema_errors/174-alias_uuid_version_number
%% Imported for liver; iso_date outputs use Erlang {Y,M,D} dates.
%% Proplist fixtures preserve JSON key order from json:decode/3.

[
    {name, alias_uuid_version_number},
    {rules, [
        {<<"id">>, <<"uuid_v4">>}
    ]},
    {opts, [
        {aliased_rules, [
            [
                {name, uuid_v4},
                {rules, [
                    {uuid, 4}
                ]},
                {error, <<"WRONG_ID">>}
            ]
        ]}
    ]}
].
