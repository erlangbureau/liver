%% LIVR schema_errors/034-iso_date_string_argument (case: iso_date_string_argument, form: proplists)
%% Source: https://github.com/koorchik/LIVR/tree/14e5a1b19011d3e9bf6ab5a6a0dd4444bea8b280/test_suite_2.5/schema_errors/034-iso_date_string_argument
%% Imported for liver; iso_date outputs use Erlang {Y,M,D} dates.
%% Proplist fixtures preserve JSON key order from json:decode/3.

[
    {name, iso_date_string_argument},
    {rules, [
        {<<"birth_date">>, [
            {iso_date, <<"x">>}
        ]}
    ]}
].
