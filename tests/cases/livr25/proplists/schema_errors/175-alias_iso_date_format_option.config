%% LIVR schema_errors/175-alias_iso_date_format_option (case: alias_iso_date_format_option, form: proplists)
%% Source: https://github.com/koorchik/LIVR/tree/14e5a1b19011d3e9bf6ab5a6a0dd4444bea8b280/test_suite_2.5/schema_errors/175-alias_iso_date_format_option
%% Imported for liver; iso_date outputs use Erlang {Y,M,D} dates.
%% Proplist fixtures preserve JSON key order from json:decode/3.

[
    {name, alias_iso_date_format_option},
    {rules, [
        {<<"starts_at">>, [required, <<"datetime">>]}
    ]},
    {opts, [
        {aliased_rules, [
            [
                {name, datetime},
                {rules, [
                    {iso_date, [
                        {<<"format">>, <<"datetime">>}
                    ]}
                ]}
            ]
        ]}
    ]}
].
