%% LIVR schema_errors/070-iso_time_bound_trailing_newline (case: iso_time_bound_trailing_newline, form: proplists)
%% Source: https://github.com/koorchik/LIVR/tree/44955f198e7cbd2d6ec2fb1926c9fe8bd2e5628d/test_suite_2.5/schema_errors/070-iso_time_bound_trailing_newline
%% Imported for liver; iso_date outputs use Erlang {Y,M,D} dates.
%% Proplist fixtures preserve JSON key order from json:decode/3.

[
    {name, iso_time_bound_trailing_newline},
    {rules, [
        {<<"opens_at">>, [
            {iso_time, [
                {<<"min">>, <<"09:00\n">>}
            ]}
        ]}
    ]}
].
