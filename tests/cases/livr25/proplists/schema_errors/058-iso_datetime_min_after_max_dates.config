%% LIVR schema_errors/058-iso_datetime_min_after_max_dates (case: iso_datetime_min_after_max_dates, form: proplists)
%% Source: https://github.com/koorchik/LIVR/tree/44955f198e7cbd2d6ec2fb1926c9fe8bd2e5628d/test_suite_2.5/schema_errors/058-iso_datetime_min_after_max_dates
%% Imported for liver; iso_date outputs use Erlang {Y,M,D} dates.
%% Proplist fixtures preserve JSON key order from json:decode/3.

[
    {name, iso_datetime_min_after_max_dates},
    {rules, [
        {<<"starts_at">>, [
            {iso_datetime, [
                {<<"min">>, <<"2026-12-31">>},
                {<<"max">>, <<"2026-01-01">>}
            ]}
        ]}
    ]}
].
