%% LIVR schema_errors/060-iso_datetime_min_after_max_relative (case: iso_datetime_min_after_max_relative, form: proplists)
%% Source: https://github.com/koorchik/LIVR/tree/14e5a1b19011d3e9bf6ab5a6a0dd4444bea8b280/test_suite_2.5/schema_errors/060-iso_datetime_min_after_max_relative
%% Imported for liver; iso_date outputs use Erlang {Y,M,D} dates.
%% Proplist fixtures preserve JSON key order from json:decode/3.

[
    {name, iso_datetime_min_after_max_relative},
    {rules, [
        {<<"starts_at">>, [
            {iso_datetime, [
                {<<"min">>, <<"tomorrow">>},
                {<<"max">>, <<"today">>}
            ]}
        ]}
    ]}
].
