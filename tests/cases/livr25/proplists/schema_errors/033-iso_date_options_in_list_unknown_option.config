%% Proplist fixtures preserve JSON key order from json:decode/3.

[
    {name, iso_date_options_in_list_unknown_option},
    {rules, [
        {<<"birth_date">>, [
            {iso_date, [
                [
                    {<<"format">>, <<"datetime">>}
                ]
            ]}
        ]}
    ]}
].
