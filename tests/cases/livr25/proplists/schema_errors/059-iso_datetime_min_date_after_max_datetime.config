%% LIVR schema_errors/059-iso_datetime_min_date_after_max_datetime (case: iso_datetime_min_date_after_max_datetime, form: proplists)
%% Source: https://github.com/koorchik/LIVR/tree/14e5a1b19011d3e9bf6ab5a6a0dd4444bea8b280/test_suite_2.5/schema_errors/059-iso_datetime_min_date_after_max_datetime
%% Imported for liver; iso_date outputs use Erlang {Y,M,D} dates.
%% Proplist fixtures preserve JSON key order from json:decode/3.

[
    {name, iso_datetime_min_date_after_max_datetime},
    {rules, [
        {<<"starts_at">>, [
            {iso_datetime, [
                {<<"min">>, <<"2026-10-19">>},
                {<<"max">>, <<"2026-10-18T23:59:59Z">>}
            ]}
        ]}
    ]}
].
