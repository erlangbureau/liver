%% LIVR schema_errors/043-iso_date_min_after_max_relative (case: iso_date_min_after_max_relative, form: proplists)
%% Source: https://github.com/koorchik/LIVR/tree/44955f198e7cbd2d6ec2fb1926c9fe8bd2e5628d/test_suite_2.5/schema_errors/043-iso_date_min_after_max_relative
%% Imported for liver; iso_date outputs use Erlang {Y,M,D} dates.
%% Proplist fixtures preserve JSON key order from json:decode/3.

[
    {name, iso_date_min_after_max_relative},
    {rules, [
        {<<"event_date">>, [
            {iso_date, [
                {<<"min">>, <<"tomorrow">>},
                {<<"max">>, <<"yesterday">>}
            ]}
        ]}
    ]}
].
