%% LIVR aliases_positive/06-equal_to_field_alias (case: equal_to_field_alias, form: proplists)
%% Source: https://github.com/koorchik/LIVR/tree/44955f198e7cbd2d6ec2fb1926c9fe8bd2e5628d/test_suite_2.5/aliases_positive/06-equal_to_field_alias
%% Imported for liver; iso_date outputs use Erlang {Y,M,D} dates.
%% Proplist fixtures preserve JSON key order from json:decode/3.

[
    {name, equal_to_field_alias},
    {rules, [
        {<<"password">>, required},
        {<<"password2">>, <<"password_confirmation">>},
        {<<"password3">>, <<"same_as_password">>},
        {<<"either">>, [
            {'or', [
                [
                    required,
                    [
                        {eq, <<"none">>}
                    ]
                ],
                [
                    {equal_to_field, <<"password">>}
                ]
            ]}
        ]},
        {<<"either_alias">>, [
            {'or', [
                [
                    required,
                    [
                        {eq, <<"none">>}
                    ]
                ],
                <<"same_as_password">>
            ]}
        ]},
        {<<"account">>, [
            {nested_object, [
                {<<"password">>, required},
                {<<"password2">>, <<"password_confirmation">>}
            ]}
        ]},
        {<<"users">>, [
            {list_of_objects, [
                {<<"password">>, required},
                {<<"password2">>, <<"same_as_password">>}
            ]}
        ]},
        {<<"empty_copies">>, [
            {list_of, <<"same_as_password">>}
        ]}
    ]},
    {input, [
        {<<"password">>, <<"s3cret">>},
        {<<"password2">>, <<"s3cret">>},
        {<<"password3">>, <<"s3cret">>},
        {<<"either">>, <<"s3cret">>},
        {<<"either_alias">>, <<"s3cret">>},
        {<<"account">>, [
            {<<"password">>, <<"abc">>},
            {<<"password2">>, <<"abc">>}
        ]},
        {<<"users">>, [
            [
                {<<"password">>, <<"x1">>},
                {<<"password2">>, <<"x1">>}
            ],
            [
                {<<"password">>, <<"y2">>},
                {<<"password2">>, <<"y2">>}
            ]
        ]},
        {<<"empty_copies">>, [<<>>]},
        {<<"extra_field">>, <<"x">>}
    ]},
    {output, [
        {<<"password">>, <<"s3cret">>},
        {<<"password2">>, <<"s3cret">>},
        {<<"password3">>, <<"s3cret">>},
        {<<"either">>, <<"s3cret">>},
        {<<"either_alias">>, <<"s3cret">>},
        {<<"account">>, [
            {<<"password">>, <<"abc">>},
            {<<"password2">>, <<"abc">>}
        ]},
        {<<"users">>, [
            [
                {<<"password">>, <<"x1">>},
                {<<"password2">>, <<"x1">>}
            ],
            [
                {<<"password">>, <<"y2">>},
                {<<"password2">>, <<"y2">>}
            ]
        ]},
        {<<"empty_copies">>, [<<>>]}
    ]},
    {opts, [
        {aliased_rules, [
            [
                {name, password_confirmation},
                {rules, [
                    required,
                    [
                        {equal_to_field, <<"password">>}
                    ]
                ]}
            ],
            [
                {name, same_as_password},
                {rules, [
                    {equal_to_field, <<"password">>}
                ]},
                {error, <<"PASSWORDS_DIFFER">>}
            ]
        ]}
    ]}
].
