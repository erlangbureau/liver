%% LIVR aliases_positive/03-coordinates (case: coordinates, form: proplists)
%% Source: https://github.com/koorchik/LIVR/tree/44955f198e7cbd2d6ec2fb1926c9fe8bd2e5628d/test_suite_2.5/aliases_positive/03-coordinates
%% Imported for liver; iso_date outputs use Erlang {Y,M,D} dates.
%% Proplist fixtures preserve JSON key order from json:decode/3.

[
    {name, coordinates},
    {rules, [
        {<<"point1">>, <<"point">>},
        {<<"point2">>, [required, <<"point">>]},
        {<<"path">>, [
            {list_of, <<"point">>}
        ]},
        {<<"place1">>, <<"coordinates">>},
        {<<"place2">>, [required, <<"coordinates">>]},
        {<<"places">>, [
            {list_of, <<"coordinates">>}
        ]}
    ]},
    {input, [
        {<<"point1">>, [30.5234, 50.4501]},
        {<<"point2">>, [<<"-73.9857">>, <<"40.7484">>]},
        {<<"path">>, [
            [0, 0],
            [179.9, -89.9]
        ]},
        {<<"place1">>, [
            {<<"lat">>, 50.4501},
            {<<"lng">>, 30.5234}
        ]},
        {<<"place2">>, [
            {<<"lat">>, <<"40.7484">>},
            {<<"lng">>, <<"-73.9857">>},
            {<<"alt">>, 10}
        ]},
        {<<"places">>, [
            [
                {<<"lat">>, 0},
                {<<"lng">>, 0}
            ],
            [
                {<<"lat">>, -89.9},
                {<<"lng">>, 179.9}
            ]
        ]}
    ]},
    {output, [
        {<<"point1">>, [30.5234, 50.4501]},
        {<<"point2">>, [-73.9857, 40.7484]},
        {<<"path">>, [
            [0, 0],
            [179.9, -89.9]
        ]},
        {<<"place1">>, [
            {<<"lat">>, 50.4501},
            {<<"lng">>, 30.5234}
        ]},
        {<<"place2">>, [
            {<<"lat">>, 40.7484},
            {<<"lng">>, -73.9857}
        ]},
        {<<"places">>, [
            [
                {<<"lat">>, 0},
                {<<"lng">>, 0}
            ],
            [
                {<<"lat">>, -89.9},
                {<<"lng">>, 179.9}
            ]
        ]}
    ]},
    {opts, [
        {aliased_rules, [
            [
                {name, point},
                {rules, [
                    [
                        {list_length, 2}
                    ],
                    [
                        {list_of, [required, decimal]}
                    ]
                ]}
            ],
            [
                {name, coordinates},
                {rules, [
                    {nested_object, [
                        {<<"lat">>, [
                            required,
                            decimal,
                            [
                                {number_between, [-90, 90]}
                            ]
                        ]},
                        {<<"lng">>, [
                            required,
                            decimal,
                            [
                                {number_between, [-180, 180]}
                            ]
                        ]}
                    ]}
                ]}
            ]
        ]}
    ]}
].
