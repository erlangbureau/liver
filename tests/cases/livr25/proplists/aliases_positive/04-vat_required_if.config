%% LIVR aliases_positive/04-vat_required_if (case: vat_required_if, form: proplists)
%% Source: https://github.com/koorchik/LIVR/tree/14e5a1b19011d3e9bf6ab5a6a0dd4444bea8b280/test_suite_2.5/aliases_positive/04-vat_required_if
%% Imported for liver; iso_date outputs use Erlang {Y,M,D} dates.
%% Proplist fixtures preserve JSON key order from json:decode/3.

[
    {name, vat_required_if},
    {rules, [
        {<<"type">>, [
            required,
            [
                {one_of, [<<"person">>, <<"company">>, <<"ngo">>]}
            ]
        ]},
        {<<"vat_number">>, <<"vat">>},
        {<<"strict_vat_number">>, [required, <<"strict_vat">>]},
        {<<"person">>, [
            {nested_object, [
                {<<"type">>, required},
                {<<"vat_number">>, <<"vat">>}
            ]}
        ]},
        {<<"company">>, [
            {nested_object, [
                {<<"type">>, required},
                {<<"vat_number">>, <<"strict_vat">>}
            ]}
        ]},
        {<<"members">>, [
            {list_of_objects, [
                {<<"type">>, required},
                {<<"vat_number">>, <<"vat_with_custom_error">>}
            ]}
        ]},
        {<<"notes">>, [
            {list_of, <<"vat">>}
        ]}
    ]},
    {input, [
        {<<"type">>, <<"company">>},
        {<<"vat_number">>, <<"UA1">>},
        {<<"strict_vat_number">>, <<"UA12345678">>},
        {<<"person">>, [
            {<<"type">>, <<"person">>}
        ]},
        {<<"company">>, [
            {<<"type">>, <<"company">>},
            {<<"vat_number">>, <<"PL1234567890">>}
        ]},
        {<<"members">>, [
            [
                {<<"type">>, <<"person">>},
                {<<"vat_number">>, <<>>}
            ],
            [
                {<<"type">>, <<"company">>},
                {<<"vat_number">>, <<"DE1">>}
            ]
        ]},
        {<<"notes">>, [<<>>, <<"x">>]},
        {<<"extra_field">>, <<"x">>}
    ]},
    {output, [
        {<<"type">>, <<"company">>},
        {<<"vat_number">>, <<"UA1">>},
        {<<"strict_vat_number">>, <<"UA12345678">>},
        {<<"person">>, [
            {<<"type">>, <<"person">>}
        ]},
        {<<"company">>, [
            {<<"type">>, <<"company">>},
            {<<"vat_number">>, <<"PL1234567890">>}
        ]},
        {<<"members">>, [
            [
                {<<"type">>, <<"person">>},
                {<<"vat_number">>, <<>>}
            ],
            [
                {<<"type">>, <<"company">>},
                {<<"vat_number">>, <<"DE1">>}
            ]
        ]},
        {<<"notes">>, [<<>>, <<"x">>]}
    ]},
    {opts, [
        {aliased_rules, [
            [
                {name, vat},
                {rules, [
                    {required_if, [
                        {<<"type">>, <<"company">>}
                    ]}
                ]}
            ],
            [
                {name, strict_vat},
                {rules, [
                    <<"vat">>,
                    [
                        {like, <<"^[A-Z]{2}[0-9]{8,12}$">>}
                    ]
                ]}
            ],
            [
                {name, vat_with_custom_error},
                {rules, [
                    {required_if, [
                        {<<"type">>, <<"company">>}
                    ]}
                ]},
                {error, <<"VAT_REQUIRED">>}
            ]
        ]}
    ]}
].
