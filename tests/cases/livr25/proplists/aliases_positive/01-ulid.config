%% LIVR aliases_positive/01-ulid (case: ulid, form: proplists)
%% Source: https://github.com/koorchik/LIVR/tree/44955f198e7cbd2d6ec2fb1926c9fe8bd2e5628d/test_suite_2.5/aliases_positive/01-ulid
%% Imported for liver; iso_date outputs use Erlang {Y,M,D} dates.
%% Proplist fixtures preserve JSON key order from json:decode/3.

[
    {name, ulid},
    {rules, [
        {<<"id1">>, <<"ulid">>},
        {<<"id2">>, [required, <<"ulid">>]},
        {<<"empty_id">>, <<"ulid">>}
    ]},
    {input, [
        {<<"id1">>, <<"01ARZ3NDEKTSV4RRFFQ69G5FAV">>},
        {<<"id2">>, <<"7ZZZZZZZZZZZZZZZZZZZZZZZZZ">>},
        {<<"empty_id">>, <<>>},
        {<<"extra_field">>, <<"x">>}
    ]},
    {output, [
        {<<"id1">>, <<"01ARZ3NDEKTSV4RRFFQ69G5FAV">>},
        {<<"id2">>, <<"7ZZZZZZZZZZZZZZZZZZZZZZZZZ">>},
        {<<"empty_id">>, <<>>}
    ]},
    {opts, [
        {aliased_rules, [
            [
                {name, ulid},
                {rules, [
                    {like, <<"^[0-7][0-9A-HJKMNP-TV-Z]{25}$">>}
                ]},
                {error, <<"WRONG_ULID">>}
            ]
        ]}
    ]}
].
