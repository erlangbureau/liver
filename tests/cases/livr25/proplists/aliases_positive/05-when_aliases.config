%% LIVR aliases_positive/05-when_aliases (case: when_aliases, form: proplists)
%% Source: https://github.com/koorchik/LIVR/tree/14e5a1b19011d3e9bf6ab5a6a0dd4444bea8b280/test_suite_2.5/aliases_positive/05-when_aliases
%% Imported for liver; iso_date outputs use Erlang {Y,M,D} dates.
%% Proplist fixtures preserve JSON key order from json:decode/3.

[
    {name, when_aliases},
    {rules, [
        {<<"type">>, string},
        {<<"vat_number">>, <<"vat_by_type">>},
        {<<"mode">>, string},
        {<<"title">>, <<"case_by_mode">>},
        {<<"subtitle">>, [trim, <<"case_by_mode">>]},
        {<<"pay_type">>, [
            required,
            [
                {one_of, [<<"card">>, <<"bank">>]}
            ]
        ]},
        {<<"data">>, <<"required_payment_data">>},
        {<<"person">>, [
            {nested_object, [
                {<<"type">>, required},
                {<<"vat_number">>, <<"vat_by_type">>}
            ]}
        ]},
        {<<"sections">>, [
            {list_of_objects, [
                {<<"mode">>, required},
                {<<"title">>, <<"case_by_mode">>}
            ]}
        ]},
        {<<"items">>, [
            {list_of, <<"case_by_mode">>}
        ]},
        {<<"labels">>, [
            {values, <<"case_by_mode">>}
        ]},
        {<<"either">>, [
            {'or', [
                [
                    required,
                    [
                        {eq, <<"none">>}
                    ]
                ],
                <<"case_by_mode">>
            ]}
        ]}
    ]},
    {input, [
        {<<"type">>, <<"company">>},
        {<<"vat_number">>, <<"UA12345678">>},
        {<<"mode">>, <<"upper">>},
        {<<"title">>, <<"AbC">>},
        {<<"subtitle">>, <<" AbC ">>},
        {<<"pay_type">>, <<"bank">>},
        {<<"data">>, [
            {<<"iban">>, <<"GB82WEST12345698765432">>},
            {<<"holder">>, <<"Jane Doe">>}
        ]},
        {<<"person">>, [
            {<<"type">>, <<"person">>}
        ]},
        {<<"sections">>, [
            [
                {<<"mode">>, <<"lower">>},
                {<<"title">>, <<"AbC">>}
            ],
            [
                {<<"mode">>, <<"upper">>},
                {<<"title">>, <<"AbC">>}
            ]
        ]},
        {<<"items">>, [<<"AbC">>]},
        {<<"labels">>, [
            {<<"mode">>, <<"upper">>},
            {<<"a">>, <<"AbC">>}
        ]},
        {<<"either">>, <<"AbC">>}
    ]},
    {output, [
        {<<"type">>, <<"company">>},
        {<<"vat_number">>, <<"UA12345678">>},
        {<<"mode">>, <<"upper">>},
        {<<"title">>, <<"ABC">>},
        {<<"subtitle">>, <<"ABC">>},
        {<<"pay_type">>, <<"bank">>},
        {<<"data">>, [
            {<<"iban">>, <<"GB82WEST12345698765432">>}
        ]},
        {<<"person">>, [
            {<<"type">>, <<"person">>}
        ]},
        {<<"sections">>, [
            [
                {<<"mode">>, <<"lower">>},
                {<<"title">>, <<"abc">>}
            ],
            [
                {<<"mode">>, <<"upper">>},
                {<<"title">>, <<"ABC">>}
            ]
        ]},
        {<<"items">>, [<<"abc">>]},
        {<<"labels">>, [
            {<<"mode">>, <<"upper">>},
            {<<"a">>, <<"abc">>}
        ]},
        {<<"either">>, <<"ABC">>}
    ]},
    {opts, [
        {aliased_rules, [
            [
                {name, vat_by_type},
                {rules, [
                    {'when', [
                        <<"type">>,
                        [
                            {eq, <<"company">>}
                        ],
                        [
                            required,
                            [
                                {like, <<"^[A-Z]{2}[0-9]{8,12}$">>}
                            ]
                        ],
                        [
                            {eq, <<>>}
                        ]
                    ]}
                ]}
            ],
            [
                {name, case_by_mode},
                {rules, [
                    {'when', [
                        <<"mode">>,
                        [
                            {eq, <<"upper">>}
                        ],
                        to_uc,
                        to_lc
                    ]}
                ]}
            ],
            [
                {name, payment_data},
                {rules, [
                    {'when', [
                        <<"pay_type">>,
                        [
                            {<<"card">>, [
                                {nested_object, [
                                    {<<"number">>, [required, credit_card]}
                                ]}
                            ]},
                            {<<"bank">>, [
                                {nested_object, [
                                    {<<"iban">>, [required, iban]}
                                ]}
                            ]}
                        ]
                    ]}
                ]}
            ],
            [
                {name, required_payment_data},
                {rules, [required, <<"payment_data">>]}
            ]
        ]}
    ]}
].
