%% LIVR positive/35-object_or_list (case: object_or_list, form: proplists)
%% Source: https://github.com/koorchik/LIVR/tree/44955f198e7cbd2d6ec2fb1926c9fe8bd2e5628d/test_suite_2.5/positive/35-object_or_list
%% Imported for liver; iso_date outputs use Erlang {Y,M,D} dates.
%% Proplist fixtures preserve JSON key order from json:decode/3.

[
    {name, object_or_list},
    {rules, [
        {<<"values_empty_object">>, [
            {values, [required, positive_integer]}
        ]},
        {<<"values_required_empty_object">>, [
            required,
            [
                {values, [required, positive_integer]}
            ]
        ]},
        {<<"keys_empty_object">>, [
            {keys, positive_integer}
        ]},
        {<<"list_length_exact_zero">>, [
            {list_length, 0}
        ]},
        {<<"list_length_min_zero">>, [
            {list_length, [0, 2]}
        ]},
        {<<"list_length_max_only">>, [
            {list_length, [
                {<<"max">>, 100}
            ]}
        ]},
        {<<"unique_empty_list">>, unique},
        {<<"unique_with_key_empty_list">>, [
            {unique, <<"id">>}
        ]},
        {<<"keys_numeric_keys_unchanged">>, [
            {keys, positive_integer}
        ]}
    ]},
    {input, [
        {<<"values_empty_object">>, [{}]},
        {<<"values_required_empty_object">>, [{}]},
        {<<"keys_empty_object">>, [{}]},
        {<<"list_length_exact_zero">>, []},
        {<<"list_length_min_zero">>, []},
        {<<"list_length_max_only">>, []},
        {<<"unique_empty_list">>, []},
        {<<"unique_with_key_empty_list">>, []},
        {<<"keys_numeric_keys_unchanged">>, [
            {<<"1">>, <<"a">>},
            {<<"20">>, <<"b">>}
        ]},
        {<<"extra_field">>, <<"extra">>}
    ]},
    {output, [
        {<<"values_empty_object">>, [{}]},
        {<<"values_required_empty_object">>, [{}]},
        {<<"keys_empty_object">>, [{}]},
        {<<"list_length_exact_zero">>, []},
        {<<"list_length_min_zero">>, []},
        {<<"list_length_max_only">>, []},
        {<<"unique_empty_list">>, []},
        {<<"unique_with_key_empty_list">>, []},
        {<<"keys_numeric_keys_unchanged">>, [
            {<<"1">>, <<"a">>},
            {<<"20">>, <<"b">>}
        ]}
    ]}
].
