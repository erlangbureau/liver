%% LIVR positive/07-contains (case: contains, form: proplists)
%% Source: https://github.com/koorchik/LIVR/tree/44955f198e7cbd2d6ec2fb1926c9fe8bd2e5628d/test_suite_2.5/positive/07-contains
%% Imported for liver; iso_date outputs use Erlang {Y,M,D} dates.
%% Proplist fixtures preserve JSON key order from json:decode/3.

[
    {name, contains},
    {rules, [
        {<<"comment">>, [
            {contains, <<"@">>}
        ]},
        {<<"comment_in_list">>, [
            [
                {contains, <<"@">>}
            ]
        ]},
        {<<"one_of_several">>, [
            {contains, [<<"foo">>, <<"bar">>]}
        ]},
        {<<"number">>, [
            {contains, <<"234">>}
        ]},
        {<<"number_fraction">>, [
            {contains, <<".">>}
        ]},
        {<<"boolean">>, [
            {contains, <<"ru">>}
        ]},
        {<<"fraction">>, [
            {contains, <<".">>}
        ]},
        {<<"big_integer">>, [
            {contains, <<"6789">>}
        ]},
        {<<"exponent">>, [
            {contains, <<"00">>}
        ]},
        {<<"negative_fraction">>, [
            {contains, <<"2.2">>}
        ]},
        {<<"empty_field">>, [
            {contains, <<"@">>}
        ]},
        {<<"null_field">>, [
            {contains, <<"@">>}
        ]},
        {<<"missing_field">>, [
            {contains, <<"@">>}
        ]}
    ]},
    {input, [
        {<<"comment">>, <<"user@example.com">>},
        {<<"comment_in_list">>, <<"@">>},
        {<<"one_of_several">>, <<"a bar b">>},
        {<<"number">>, 12345},
        {<<"number_fraction">>, 0.5},
        {<<"boolean">>, true},
        {<<"fraction">>, 0.1},
        {<<"big_integer">>, 123456789012345},
        {<<"exponent">>, 1.0e3},
        {<<"negative_fraction">>, -12.25},
        {<<"empty_field">>, <<>>},
        {<<"null_field">>, null},
        {<<"extra_field">>, <<"extra">>}
    ]},
    {output, [
        {<<"comment">>, <<"user@example.com">>},
        {<<"comment_in_list">>, <<"@">>},
        {<<"one_of_several">>, <<"a bar b">>},
        {<<"number">>, <<"12345">>},
        {<<"number_fraction">>, <<"0.5">>},
        {<<"boolean">>, <<"true">>},
        {<<"fraction">>, <<"0.1">>},
        {<<"big_integer">>, <<"123456789012345">>},
        {<<"exponent">>, <<"1000">>},
        {<<"negative_fraction">>, <<"-12.25">>},
        {<<"empty_field">>, <<>>},
        {<<"null_field">>, null}
    ]}
].
