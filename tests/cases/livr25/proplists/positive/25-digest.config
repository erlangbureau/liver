        {<<"md5_in_list">>, <<"5d41402abc4b2a76b9719d911017c592">>},
        {<<"md5_or_sha1_1">>, <<"5d41402abc4b2a76b9719d911017c592">>},
        {<<"md5_or_sha1_2">>, <<"aaf4c61ddcc5e8a2dabede0f3b482cd9aea9434d">>},
        {<<"sha_any">>, <<"59e1748777448c69de6b800d7a33bbfb9ff1b463e44354c3553bcdb9c666fa90125a3c79f90397bdf5f6a13de828684f">>},
        {<<"sha256_uppercase">>, <<"2CF24DBA5FB0A30E26E83B2AC5B9E29E1B161E5C1FA7425E73043362938B9824">>},
