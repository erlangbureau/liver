%% LIVR positive/25-digest (case: digest, form: proplists)
%% Source: https://github.com/koorchik/LIVR/tree/44955f198e7cbd2d6ec2fb1926c9fe8bd2e5628d/test_suite_2.5/positive/25-digest
%% Imported for liver; iso_date outputs use Erlang {Y,M,D} dates.
%% Proplist fixtures preserve JSON key order from json:decode/3.

[
    {name, digest},
    {rules, [
        {<<"md5">>, [
            {digest, <<"md5">>}
        ]},
        {<<"md5_uppercase">>, [
            [
                {digest, <<"md5">>}
            ]
        ]},
        {<<"sha1">>, [
            {digest, <<"sha1">>}
        ]},
        {<<"sha256">>, [
            {digest, <<"sha256">>}
        ]},
        {<<"sha384">>, [
            {digest, <<"sha384">>}
        ]},
        {<<"sha512">>, [
            {digest, <<"sha512">>}
        ]},
        {<<"md5_in_list">>, [
            {digest, [<<"md5">>]}
        ]},
        {<<"md5_or_sha1_1">>, [
            {digest, [<<"md5">>, <<"sha1">>]}
        ]},
        {<<"md5_or_sha1_2">>, [
            {digest, [<<"md5">>, <<"sha1">>]}
        ]},
        {<<"sha_any">>, [
            {digest, [<<"sha1">>, <<"sha256">>, <<"sha384">>, <<"sha512">>]}
        ]},
        {<<"sha256_uppercase">>, [
            {digest, <<"sha256">>}
        ]},
        {<<"all_algorithms">>, [
            {digest, [<<"md5">>, <<"sha1">>, <<"sha256">>, <<"sha384">>, <<"sha512">>]}
        ]},
        {<<"empty_field">>, [
            {digest, <<"md5">>}
        ]},
        {<<"null_field">>, [
            {digest, <<"md5">>}
        ]},
        {<<"missing_field">>, [
            {digest, <<"md5">>}
        ]}
    ]},
    {input, [
        {<<"md5">>, <<"5d41402abc4b2a76b9719d911017c592">>},
        {<<"md5_uppercase">>, <<"5D41402ABC4B2A76B9719D911017C592">>},
