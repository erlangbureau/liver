%% LIVR positive/28-mac (case: mac, form: proplists)
%% Source: https://github.com/koorchik/LIVR/tree/44955f198e7cbd2d6ec2fb1926c9fe8bd2e5628d/test_suite_2.5/positive/28-mac
%% Imported for liver; iso_date outputs use Erlang {Y,M,D} dates.
%% Proplist fixtures preserve JSON key order from json:decode/3.

[
    {name, mac},
    {rules, [
        {<<"colons">>, mac},
        {<<"dashes">>, [mac]},
        {<<"uppercase">>, [
            {mac, []}
        ]},
        {<<"empty_field">>, mac},
        {<<"null_field">>, mac},
        {<<"missing_field">>, mac},
        {<<"mac48_explicit">>, [
            {mac, 48}
        ]},
        {<<"eui64_colons">>, [
            {mac, 64}
        ]},
        {<<"eui64_dashes">>, [
            [
                {mac, 64}
            ]
        ]},
        {<<"eui64_empty">>, [
            {mac, 64}
        ]},
        {<<"string_argument">>, [
            {mac, <<"64">>}
        ]},
        {<<"string_argument_48">>, [
            {mac, <<"48">>}
        ]}
    ]},
    {input, [
        {<<"colons">>, <<"00:1A:2b:3c:4D:5e">>},
        {<<"dashes">>, <<"00-1a-2b-3c-4d-5e">>},
        {<<"uppercase">>, <<"FF-FF-FF-FF-FF-FF">>},
        {<<"empty_field">>, <<>>},
        {<<"null_field">>, null},
        {<<"extra_field">>, <<"extra">>},
        {<<"mac48_explicit">>, <<"00:1a:2b:3c:4d:5e">>},
        {<<"eui64_colons">>, <<"00:1A:2b:3c:4D:5e:6F:70">>},
        {<<"eui64_dashes">>, <<"70-B3-D5-7E-D0-00-12-34">>},
        {<<"eui64_empty">>, <<>>},
        {<<"string_argument">>, <<"00:1A:2b:3c:4D:5e:6F:70">>},
        {<<"string_argument_48">>, <<"00-1a-2b-3c-4d-5e">>}
    ]},
    {output, [
        {<<"colons">>, <<"00:1A:2b:3c:4D:5e">>},
        {<<"dashes">>, <<"00-1a-2b-3c-4d-5e">>},
        {<<"uppercase">>, <<"FF-FF-FF-FF-FF-FF">>},
        {<<"empty_field">>, <<>>},
        {<<"null_field">>, null},
        {<<"mac48_explicit">>, <<"00:1a:2b:3c:4d:5e">>},
        {<<"eui64_colons">>, <<"00:1A:2b:3c:4D:5e:6F:70">>},
        {<<"eui64_dashes">>, <<"70-B3-D5-7E-D0-00-12-34">>},
        {<<"eui64_empty">>, <<>>},
        {<<"string_argument">>, <<"00:1A:2b:3c:4D:5e:6F:70">>},
        {<<"string_argument_48">>, <<"00-1a-2b-3c-4d-5e">>}
    ]}
].
