%% LIVR positive/01-boolean (case: boolean, form: proplists)
%% Source: https://github.com/koorchik/LIVR/tree/14e5a1b19011d3e9bf6ab5a6a0dd4444bea8b280/test_suite_2.5/positive/01-boolean
%% Imported for liver; iso_date outputs use Erlang {Y,M,D} dates.
%% Proplist fixtures preserve JSON key order from json:decode/3.

[
    {name, boolean},
    {rules, [
        {<<"true_value">>, boolean},
        {<<"false_value">>, [boolean]},
        {<<"one_number">>, [
            {boolean, []}
        ]},
        {<<"zero_number">>, boolean},
        {<<"one_string">>, boolean},
        {<<"zero_string">>, boolean},
        {<<"true_string">>, boolean},
        {<<"false_string">>, boolean},
        {<<"required_false">>, [required, boolean]},
        {<<"required_zero_string">>, [required, boolean]},
        {<<"one_point_zero_number">>, boolean},
        {<<"minus_zero_number">>, boolean},
        {<<"empty_field">>, boolean},
        {<<"null_field">>, boolean},
        {<<"missing_field">>, boolean}
    ]},
    {input, [
        {<<"true_value">>, true},
        {<<"false_value">>, false},
        {<<"one_number">>, 1},
        {<<"zero_number">>, 0},
        {<<"one_string">>, <<"1">>},
        {<<"zero_string">>, <<"0">>},
        {<<"true_string">>, <<"true">>},
        {<<"false_string">>, <<"false">>},
        {<<"required_false">>, false},
        {<<"required_zero_string">>, <<"0">>},
        {<<"one_point_zero_number">>, 1.0},
        {<<"minus_zero_number">>, -0.0},
        {<<"empty_field">>, <<>>},
        {<<"null_field">>, null},
        {<<"extra_field">>, <<"extra">>}
    ]},
    {output, [
        {<<"true_value">>, true},
        {<<"false_value">>, false},
        {<<"one_number">>, true},
        {<<"zero_number">>, false},
        {<<"one_string">>, true},
        {<<"zero_string">>, false},
        {<<"true_string">>, true},
        {<<"false_string">>, false},
        {<<"required_false">>, false},
        {<<"required_zero_string">>, false},
        {<<"one_point_zero_number">>, true},
        {<<"minus_zero_number">>, false},
        {<<"empty_field">>, <<>>},
        {<<"null_field">>, null}
    ]}
].
