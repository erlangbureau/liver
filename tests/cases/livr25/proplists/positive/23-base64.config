%% LIVR positive/23-base64 (case: base64, form: proplists)
%% Source: https://github.com/koorchik/LIVR/tree/14e5a1b19011d3e9bf6ab5a6a0dd4444bea8b280/test_suite_2.5/positive/23-base64
%% Imported for liver; iso_date outputs use Erlang {Y,M,D} dates.
%% Proplist fixtures preserve JSON key order from json:decode/3.

[
    {name, base64},
    {rules, [
        {<<"standard">>, base64},
        {<<"standard_no_padding_needed">>, [base64]},
        {<<"standard_double_padding">>, [
            {base64, []}
        ]},
        {<<"standard_alphabet">>, base64},
        {<<"unused_bits_not_checked">>, base64},
        {<<"number">>, base64},
        {<<"url">>, [
            {base64, <<"url">>}
        ]},
        {<<"url_no_padding">>, [
            {base64, <<"url">>}
        ]},
        {<<"url_with_padding">>, [
            {base64, <<"url">>}
        ]},
        {<<"url_short">>, [
            {base64, <<"url">>}
        ]},
        {<<"url_double_padding">>, [
            {base64, [<<"url">>]}
        ]},
        {<<"url_no_double_padding">>, [
            {base64, <<"url">>}
        ]},
        {<<"url_number">>, [
            {base64, <<"url">>}
        ]},
        {<<"true_string">>, base64},
        {<<"exponent_number">>, base64},
        {<<"empty_field">>, base64},
        {<<"null_field">>, base64},
        {<<"missing_field">>, base64}
    ]},
    {input, [
        {<<"standard">>, <<"SGVsbG8=">>},
        {<<"standard_no_padding_needed">>, <<"SGVsbG8h">>},
        {<<"standard_double_padding">>, <<"SA==">>},
        {<<"standard_alphabet">>, <<"+/AZaz09">>},
        {<<"unused_bits_not_checked">>, <<"SB==">>},
        {<<"number">>, 1234},
        {<<"url">>, <<"-_-_">>},
        {<<"url_no_padding">>, <<"SGVsbG8">>},
        {<<"url_with_padding">>, <<"SGVsbG8=">>},
        {<<"url_short">>, <<"a-_">>},
        {<<"url_double_padding">>, <<"a-==">>},
        {<<"url_no_double_padding">>, <<"SA">>},
        {<<"url_number">>, 123},
        {<<"true_string">>, <<"true">>},
        {<<"exponent_number">>, 1.0e3},
        {<<"empty_field">>, <<>>},
        {<<"null_field">>, null},
        {<<"extra_field">>, <<"extra">>}
    ]},
    {output, [
        {<<"standard">>, <<"SGVsbG8=">>},
        {<<"standard_no_padding_needed">>, <<"SGVsbG8h">>},
        {<<"standard_double_padding">>, <<"SA==">>},
        {<<"standard_alphabet">>, <<"+/AZaz09">>},
        {<<"unused_bits_not_checked">>, <<"SB==">>},
        {<<"number">>, <<"1234">>},
        {<<"url">>, <<"-_-_">>},
        {<<"url_no_padding">>, <<"SGVsbG8">>},
        {<<"url_with_padding">>, <<"SGVsbG8=">>},
        {<<"url_short">>, <<"a-_">>},
        {<<"url_double_padding">>, <<"a-==">>},
        {<<"url_no_double_padding">>, <<"SA">>},
        {<<"url_number">>, <<"123">>},
        {<<"true_string">>, <<"true">>},
        {<<"exponent_number">>, <<"1000">>},
        {<<"empty_field">>, <<>>},
        {<<"null_field">>, null}
    ]}
].
