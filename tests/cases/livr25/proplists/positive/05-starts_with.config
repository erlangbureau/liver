%% LIVR positive/05-starts_with (case: starts_with, form: proplists)
%% Source: https://github.com/koorchik/LIVR/tree/14e5a1b19011d3e9bf6ab5a6a0dd4444bea8b280/test_suite_2.5/positive/05-starts_with
%% Imported for liver; iso_date outputs use Erlang {Y,M,D} dates.
%% Proplist fixtures preserve JSON key order from json:decode/3.

[
    {name, starts_with},
    {rules, [
        {<<"website1">>, [
            {starts_with, [<<"https://">>, <<"http://">>]}
        ]},
        {<<"website2">>, [
            [
                {starts_with, [<<"https://">>, <<"http://">>]}
            ]
        ]},
        {<<"single_prefix">>, [
            {starts_with, <<"ID-">>}
        ]},
        {<<"single_prefix_in_list">>, [
            {starts_with, [<<"ID-">>]}
        ]},
        {<<"number">>, [
            {starts_with, <<"12">>}
        ]},
        {<<"number_with_trailing_zero">>, [
            {starts_with, <<"1.5">>}
        ]},
        {<<"boolean">>, [
            {starts_with, <<"tr">>}
        ]},
        {<<"unicode">>, [
            {starts_with, <<"При"/utf8>>}
        ]},
        {<<"one_point_zero">>, [
            {starts_with, <<"1">>}
        ]},
        {<<"exponent">>, [
            {starts_with, <<"1000">>}
        ]},
        {<<"fraction">>, [
            {starts_with, <<"0.1">>}
        ]},
        {<<"negative_fraction">>, [
            {starts_with, <<"-12.2">>}
        ]},
        {<<"big_integer">>, [
            {starts_with, <<"1234567890">>}
        ]},
        {<<"minus_zero">>, [
            {starts_with, <<"0">>}
        ]},
        {<<"number_argument">>, [
            {starts_with, 1}
        ]},
        {<<"number_argument_number_value">>, [
            {starts_with, [2, 1]}
        ]},
        {<<"empty_field">>, [
            {starts_with, [<<"https://">>, <<"http://">>]}
        ]},
        {<<"null_field">>, [
            {starts_with, [<<"https://">>, <<"http://">>]}
        ]},
        {<<"missing_field">>, [
            {starts_with, [<<"https://">>, <<"http://">>]}
        ]}
    ]},
    {input, [
        {<<"website1">>, <<"https://example.com">>},
        {<<"website2">>, <<"http://example.com">>},
        {<<"single_prefix">>, <<"ID-123">>},
        {<<"single_prefix_in_list">>, <<"ID-">>},
        {<<"number">>, 123},
        {<<"number_with_trailing_zero">>, 1.5},
        {<<"boolean">>, true},
        {<<"unicode">>, <<"Привіт"/utf8>>},
        {<<"one_point_zero">>, 1.0},
        {<<"exponent">>, 1.0e3},
        {<<"fraction">>, 0.1},
        {<<"negative_fraction">>, -12.25},
        {<<"big_integer">>, 123456789012345},
        {<<"minus_zero">>, -0.0},
        {<<"number_argument">>, <<"123">>},
        {<<"number_argument_number_value">>, 15},
        {<<"empty_field">>, <<>>},
        {<<"null_field">>, null},
        {<<"extra_field">>, <<"extra">>}
    ]},
    {output, [
        {<<"website1">>, <<"https://example.com">>},
        {<<"website2">>, <<"http://example.com">>},
        {<<"single_prefix">>, <<"ID-123">>},
        {<<"single_prefix_in_list">>, <<"ID-">>},
        {<<"number">>, <<"123">>},
        {<<"number_with_trailing_zero">>, <<"1.5">>},
        {<<"boolean">>, <<"true">>},
        {<<"unicode">>, <<"Привіт"/utf8>>},
        {<<"one_point_zero">>, <<"1">>},
        {<<"exponent">>, <<"1000">>},
        {<<"fraction">>, <<"0.1">>},
        {<<"negative_fraction">>, <<"-12.25">>},
        {<<"big_integer">>, <<"123456789012345">>},
        {<<"minus_zero">>, <<"0">>},
        {<<"number_argument">>, <<"123">>},
        {<<"number_argument_number_value">>, <<"15">>},
        {<<"empty_field">>, <<>>},
        {<<"null_field">>, null}
    ]}
].
