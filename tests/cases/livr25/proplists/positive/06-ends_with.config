%% LIVR positive/06-ends_with (case: ends_with, form: proplists)
%% Source: https://github.com/koorchik/LIVR/tree/14e5a1b19011d3e9bf6ab5a6a0dd4444bea8b280/test_suite_2.5/positive/06-ends_with
%% Imported for liver; iso_date outputs use Erlang {Y,M,D} dates.
%% Proplist fixtures preserve JSON key order from json:decode/3.

[
    {name, ends_with},
    {rules, [
        {<<"file">>, [
            {ends_with, <<".pdf">>}
        ]},
        {<<"file_in_list">>, [
            [
                {ends_with, <<".pdf">>}
            ]
        ]},
        {<<"image1">>, [
            {ends_with, [<<".jpg">>, <<".png">>]}
        ]},
        {<<"image2">>, [
            {ends_with, [<<".jpg">>, <<".png">>]}
        ]},
        {<<"number">>, [
            {ends_with, <<"00">>}
        ]},
        {<<"boolean">>, [
            {ends_with, <<"se">>}
        ]},
        {<<"exponent">>, [
            {ends_with, <<"000">>}
        ]},
        {<<"minus_zero">>, [
            {ends_with, <<"0">>}
        ]},
        {<<"negative_fraction">>, [
            {ends_with, <<".25">>}
        ]},
        {<<"big_integer">>, [
            {ends_with, <<"012345">>}
        ]},
        {<<"empty_field">>, [
            {ends_with, <<".pdf">>}
        ]},
        {<<"null_field">>, [
            {ends_with, <<".pdf">>}
        ]},
        {<<"missing_field">>, [
            {ends_with, <<".pdf">>}
        ]}
    ]},
    {input, [
        {<<"file">>, <<"report.pdf">>},
        {<<"file_in_list">>, <<".pdf">>},
        {<<"image1">>, <<"photo.jpg">>},
        {<<"image2">>, <<"photo.png">>},
        {<<"number">>, 100},
        {<<"boolean">>, false},
        {<<"exponent">>, 1.0e3},
        {<<"minus_zero">>, -0.0},
        {<<"negative_fraction">>, -12.25},
        {<<"big_integer">>, 123456789012345},
        {<<"empty_field">>, <<>>},
        {<<"null_field">>, null},
        {<<"extra_field">>, <<"extra">>}
    ]},
    {output, [
        {<<"file">>, <<"report.pdf">>},
        {<<"file_in_list">>, <<".pdf">>},
        {<<"image1">>, <<"photo.jpg">>},
        {<<"image2">>, <<"photo.png">>},
        {<<"number">>, <<"100">>},
        {<<"boolean">>, <<"false">>},
        {<<"exponent">>, <<"1000">>},
        {<<"minus_zero">>, <<"0">>},
        {<<"negative_fraction">>, <<"-12.25">>},
        {<<"big_integer">>, <<"123456789012345">>},
        {<<"empty_field">>, <<>>},
        {<<"null_field">>, null}
    ]}
].
