        {<<"contact_email_only">>, [
            {nested_object, [
                {<<"email">>, [
                    {'when', [
                        <<"phone">>,
                        not_empty,
                        email,
                        [required, email]
                    ]}
                ]},
                {<<"phone">>, [
                    {'when', [
                        <<"email">>,
                        not_empty,
                        string,
                        [required, string]
                    ]}
                ]}
            ]}
        ]},
