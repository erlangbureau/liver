%% LIVR positive/22-hostname (case: hostname, form: proplists)
%% Source: https://github.com/koorchik/LIVR/tree/14e5a1b19011d3e9bf6ab5a6a0dd4444bea8b280/test_suite_2.5/positive/22-hostname
%% Imported for liver; iso_date outputs use Erlang {Y,M,D} dates.
%% Proplist fixtures preserve JSON key order from json:decode/3.

[
    {name, hostname},
    {rules, [
        {<<"domain">>, hostname},
        {<<"single_label">>, [hostname]},
        {<<"single_char">>, [
            {hostname, []}
        ]},
        {<<"subdomains">>, hostname},
        {<<"hyphens">>, hostname},
        {<<"uppercase">>, hostname},
        {<<"punycode">>, hostname},
        {<<"digit_labels">>, hostname},
        {<<"digit_labels_except_last">>, hostname},
        {<<"labels_with_digits">>, hostname},
        {<<"last_label_ends_with_digit">>, hostname},
        {<<"last_label_starts_with_digit">>, hostname},
        {<<"true_string">>, hostname},
        {<<"label_starts_with_digit">>, hostname},
        {<<"label_63">>, hostname},
        {<<"total_253">>, hostname},
        {<<"empty_field">>, hostname},
        {<<"null_field">>, hostname},
        {<<"missing_field">>, hostname}
    ]},
    {input, [
        {<<"domain">>, <<"example.com">>},
        {<<"single_label">>, <<"localhost">>},
        {<<"single_char">>, <<"a">>},
        {<<"subdomains">>, <<"a.b.c.example.org">>},
        {<<"hyphens">>, <<"my-host--1.example-site.com">>},
        {<<"uppercase">>, <<"WWW.Example.COM">>},
        {<<"punycode">>, <<"xn--80ak6aa92e.com">>},
        {<<"digit_labels">>, <<"123.example">>},
        {<<"digit_labels_except_last">>, <<"192.0.2.example">>},
        {<<"labels_with_digits">>, <<"a1.b2c">>},
        {<<"last_label_ends_with_digit">>, <<"x.y1">>},
        {<<"last_label_starts_with_digit">>, <<"example.1a">>},
        {<<"true_string">>, <<"true">>},
        {<<"label_starts_with_digit">>, <<"1password.example">>},
        {<<"label_63">>, <<"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.com">>},
        {<<"total_253">>, <<"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb.ccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc.ddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd">>},
        {<<"empty_field">>, <<>>},
        {<<"null_field">>, null},
        {<<"extra_field">>, <<"extra">>}
    ]},
    {output, [
        {<<"domain">>, <<"example.com">>},
        {<<"single_label">>, <<"localhost">>},
        {<<"single_char">>, <<"a">>},
        {<<"subdomains">>, <<"a.b.c.example.org">>},
        {<<"hyphens">>, <<"my-host--1.example-site.com">>},
        {<<"uppercase">>, <<"WWW.Example.COM">>},
        {<<"punycode">>, <<"xn--80ak6aa92e.com">>},
        {<<"digit_labels">>, <<"123.example">>},
        {<<"digit_labels_except_last">>, <<"192.0.2.example">>},
        {<<"labels_with_digits">>, <<"a1.b2c">>},
        {<<"last_label_ends_with_digit">>, <<"x.y1">>},
        {<<"last_label_starts_with_digit">>, <<"example.1a">>},
        {<<"true_string">>, <<"true">>},
        {<<"label_starts_with_digit">>, <<"1password.example">>},
        {<<"label_63">>, <<"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.com">>},
        {<<"total_253">>, <<"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb.ccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc.ddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd">>},
        {<<"empty_field">>, <<>>},
        {<<"null_field">>, null}
    ]}
].
