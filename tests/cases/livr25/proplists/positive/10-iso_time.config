%% LIVR positive/10-iso_time (case: iso_time, form: proplists)
%% Source: https://github.com/koorchik/LIVR/tree/14e5a1b19011d3e9bf6ab5a6a0dd4444bea8b280/test_suite_2.5/positive/10-iso_time
%% Imported for liver; iso_date outputs use Erlang {Y,M,D} dates.
%% Proplist fixtures preserve JSON key order from json:decode/3.

[
    {name, iso_time},
    {rules, [
        {<<"opens_at">>, iso_time},
        {<<"midnight">>, [iso_time]},
        {<<"last_minute">>, [
            {iso_time, []}
        ]},
        {<<"with_seconds">>, iso_time},
        {<<"one_fraction_digit">>, iso_time},
        {<<"nine_fraction_digits">>, iso_time},
        {<<"empty_options_with_seconds">>, [
            {iso_time, [{}]}
        ]},
        {<<"max_with_nine_digits">>, [
            {iso_time, [
                {<<"max">>, <<"18:00:00.123456789">>}
            ]}
        ]},
        {<<"min_with_fraction">>, [
            {iso_time, [
                {<<"min">>, <<"09:00:00.500000000">>}
            ]}
        ]},
        {<<"night_spec_example">>, [
            {iso_time, [
                {<<"min">>, <<"22:00">>},
                {<<"max">>, <<"06:00">>}
            ]}
        ]},
        {<<"night_spec_example_late">>, [
            {iso_time, [
                {<<"min">>, <<"22:00">>},
                {<<"max">>, <<"06:00">>}
            ]}
        ]},
        {<<"empty_field">>, iso_time},
        {<<"null_field">>, iso_time},
        {<<"missing_field">>, iso_time},
        {<<"bounds_min_equal">>, [
            {iso_time, [
                {<<"min">>, <<"09:00">>},
                {<<"max">>, <<"18:00">>}
            ]}
        ]},
        {<<"bounds_min_equal_with_seconds">>, [
            {iso_time, [
                {<<"min">>, <<"09:00">>},
                {<<"max">>, <<"18:00">>}
            ]}
        ]},
        {<<"bounds_inside">>, [
            {iso_time, [
                {<<"min">>, <<"09:00">>},
                {<<"max">>, <<"18:00">>}
            ]}
        ]},
        {<<"bounds_max_equal">>, [
            {iso_time, [
                {<<"min">>, <<"09:00">>},
                {<<"max">>, <<"18:00">>}
            ]}
        ]},
        {<<"only_min">>, [
            {iso_time, [
                {<<"min">>, <<"09:00">>}
            ]}
        ]},
        {<<"only_max">>, [
            {iso_time, [
                {<<"max">>, <<"18:00:00.5">>}
            ]}
        ]},
        {<<"empty_options">>, [
            {iso_time, [{}]}
        ]},
        {<<"same_min_and_max">>, [
            {iso_time, [
                {<<"min">>, <<"12:00">>},
                {<<"max">>, <<"12:00:00">>}
            ]}
        ]},
        {<<"night_after_min">>, [
            {iso_time, [
                {<<"min">>, <<"22:00">>},
                {<<"max">>, <<"06:00">>}
            ]}
        ]},
        {<<"night_at_min">>, [
            {iso_time, [
                {<<"min">>, <<"22:00">>},
                {<<"max">>, <<"06:00">>}
            ]}
        ]},
        {<<"night_midnight">>, [
            {iso_time, [
                {<<"min">>, <<"22:00">>},
                {<<"max">>, <<"06:00">>}
            ]}
        ]},
        {<<"night_at_max">>, [
            {iso_time, [
                {<<"min">>, <<"22:00">>},
                {<<"max">>, <<"06:00">>}
            ]}
        ]},
        {<<"night_before_max">>, [
            {iso_time, [
                {<<"min">>, <<"22:00">>},
                {<<"max">>, <<"06:00">>}
            ]}
        ]},
        {<<"bounds_empty_value">>, [
            {iso_time, [
                {<<"min">>, <<"09:00">>},
                {<<"max">>, <<"18:00">>}
            ]}
        ]},
        {<<"bounds_null_value">>, [
            {iso_time, [
                {<<"min">>, <<"09:00">>},
                {<<"max">>, <<"18:00">>}
            ]}
        ]}
    ]},
    {input, [
        {<<"opens_at">>, <<"09:30">>},
        {<<"midnight">>, <<"00:00">>},
        {<<"last_minute">>, <<"23:59">>},
        {<<"with_seconds">>, <<"23:59:59">>},
        {<<"one_fraction_digit">>, <<"00:00:00.1">>},
        {<<"nine_fraction_digits">>, <<"12:34:56.123456789">>},
        {<<"empty_options_with_seconds">>, <<"07:05:09">>},
        {<<"max_with_nine_digits">>, <<"18:00:00.123456789">>},
        {<<"min_with_fraction">>, <<"09:00:00.5">>},
        {<<"night_spec_example">>, <<"05:59">>},
        {<<"night_spec_example_late">>, <<"23:30">>},
        {<<"empty_field">>, <<>>},
        {<<"null_field">>, null},
        {<<"extra_field">>, <<"extra">>},
        {<<"bounds_min_equal">>, <<"09:00">>},
        {<<"bounds_min_equal_with_seconds">>, <<"09:00:00.000">>},
        {<<"bounds_inside">>, <<"12:30:15">>},
        {<<"bounds_max_equal">>, <<"18:00">>},
        {<<"only_min">>, <<"23:59:59.999999999">>},
        {<<"only_max">>, <<"18:00:00.499999999">>},
        {<<"empty_options">>, <<"00:00">>},
        {<<"same_min_and_max">>, <<"12:00:00.0">>},
        {<<"night_after_min">>, <<"23:15">>},
        {<<"night_at_min">>, <<"22:00">>},
        {<<"night_midnight">>, <<"00:00">>},
        {<<"night_at_max">>, <<"06:00:00">>},
        {<<"night_before_max">>, <<"05:59:59.999">>},
        {<<"bounds_empty_value">>, <<>>},
        {<<"bounds_null_value">>, null}
    ]},
    {output, [
        {<<"opens_at">>, <<"09:30">>},
        {<<"midnight">>, <<"00:00">>},
        {<<"last_minute">>, <<"23:59">>},
        {<<"with_seconds">>, <<"23:59:59">>},
        {<<"one_fraction_digit">>, <<"00:00:00.1">>},
        {<<"nine_fraction_digits">>, <<"12:34:56.123456789">>},
        {<<"empty_options_with_seconds">>, <<"07:05:09">>},
        {<<"max_with_nine_digits">>, <<"18:00:00.123456789">>},
        {<<"min_with_fraction">>, <<"09:00:00.5">>},
        {<<"night_spec_example">>, <<"05:59">>},
        {<<"night_spec_example_late">>, <<"23:30">>},
        {<<"empty_field">>, <<>>},
        {<<"null_field">>, null},
        {<<"bounds_min_equal">>, <<"09:00">>},
        {<<"bounds_min_equal_with_seconds">>, <<"09:00:00.000">>},
        {<<"bounds_inside">>, <<"12:30:15">>},
        {<<"bounds_max_equal">>, <<"18:00">>},
        {<<"only_min">>, <<"23:59:59.999999999">>},
        {<<"only_max">>, <<"18:00:00.499999999">>},
        {<<"empty_options">>, <<"00:00">>},
        {<<"same_min_and_max">>, <<"12:00:00.0">>},
        {<<"night_after_min">>, <<"23:15">>},
        {<<"night_at_min">>, <<"22:00">>},
        {<<"night_midnight">>, <<"00:00">>},
        {<<"night_at_max">>, <<"06:00:00">>},
        {<<"night_before_max">>, <<"05:59:59.999">>},
        {<<"bounds_empty_value">>, <<>>},
        {<<"bounds_null_value">>, null}
    ]}
].
