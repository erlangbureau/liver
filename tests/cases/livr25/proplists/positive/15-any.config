%% Proplist fixtures preserve JSON key order from json:decode/3.

[
    {name, any},
    {rules, [
        {<<"metadata">>, any},
        {<<"empty_object">>, [any]},
        {<<"list">>, [
            {any, []}
        ]},
        {<<"empty_list">>, any},
        {<<"string">>, any},
        {<<"number">>, any},
        {<<"number_string">>, any},
        {<<"boolean">>, any},
        {<<"zero">>, any},
        {<<"required_any">>, [required, any]},
        {<<"empty_field">>, any},
        {<<"null_field">>, any},
        {<<"missing_field">>, any}
    ]},
    {input, [
        {<<"metadata">>, [
            {<<"a">>, [
                {<<"b">>, [
                    1,
                    [
                        {<<"c">>, null}
                    ]
                ]}
            ]},
            {<<"d">>, <<>>}
        ]},
        {<<"empty_object">>, [{}]},
        {<<"list">>, [
