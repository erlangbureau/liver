%% LIVR positive/13-values (case: values, form: proplists)
%% Source: https://github.com/koorchik/LIVR/tree/14e5a1b19011d3e9bf6ab5a6a0dd4444bea8b280/test_suite_2.5/positive/13-values
%% Imported for liver; iso_date outputs use Erlang {Y,M,D} dates.
%% Proplist fixtures preserve JSON key order from json:decode/3.

[
    {name, values},
    {rules, [
        {<<"stock">>, [
            {values, [required, positive_integer]}
        ]},
        {<<"single_rule">>, [
            {values, positive_integer}
        ]},
        {<<"single_list_form">>, [
            {values, [
                [required, positive_integer]
            ]}
        ]},
        {<<"prototype_keys">>, [
            {values, positive_integer}
        ]},
        {<<"rule_object">>, [
            [
                {values, [
                    {max_length, 3}
                ]}
            ]
        ]},
        {<<"modifier">>, [
            {values, to_uc}
        ]},
        {<<"empty_values_inside">>, [
            {values, positive_integer}
        ]},
        {<<"nested_objects">>, [
            {values, [
                {nested_object, [
                    {<<"name">>, required}
                ]}
            ]}
        ]},
        {<<"lists">>, [
            {values, [
                {list_of, positive_integer}
            ]}
        ]},
        {<<"empty_field">>, [
            {values, [required, positive_integer]}
        ]},
        {<<"null_field">>, [
            {values, [required, positive_integer]}
        ]},
        {<<"missing_field">>, [
            {values, [required, positive_integer]}
        ]}
    ]},
    {input, [
        {<<"stock">>, [
            {<<"sku-1">>, <<"5">>},
            {<<"sku-2">>, 10}
        ]},
        {<<"single_rule">>, [
            {<<"a">>, <<"1">>}
        ]},
        {<<"single_list_form">>, [
            {<<"a">>, <<"1">>},
            {<<"b">>, 2}
        ]},
        {<<"prototype_keys">>, [
            {<<"__proto__">>, <<"1">>},
            {<<"constructor">>, <<"2">>},
            {<<"toString">>, <<"3">>}
        ]},
        {<<"rule_object">>, [
            {<<"a">>, <<"abc">>},
            {<<"b">>, <<>>}
        ]},
        {<<"modifier">>, [
            {<<"en">>, <<"hello">>},
            {<<"de">>, <<"hallo">>}
        ]},
        {<<"empty_values_inside">>, [
            {<<"a">>, <<>>},
            {<<"b">>, null}
        ]},
        {<<"nested_objects">>, [
            {<<"u1">>, [
                {<<"name">>, <<"Jane Doe">>},
                {<<"password">>, <<"x">>}
            ]},
            {<<"u2">>, [
                {<<"name">>, <<"John Doe">>}
            ]}
        ]},
        {<<"lists">>, [
            {<<"a">>, [<<"1">>, 2]},
            {<<"b">>, []}
        ]},
        {<<"empty_field">>, <<>>},
        {<<"null_field">>, null},
        {<<"extra_field">>, <<"extra">>}
    ]},
    {output, [
        {<<"stock">>, [
            {<<"sku-1">>, 5},
            {<<"sku-2">>, 10}
        ]},
        {<<"single_rule">>, [
            {<<"a">>, 1}
        ]},
        {<<"single_list_form">>, [
            {<<"a">>, 1},
            {<<"b">>, 2}
        ]},
        {<<"prototype_keys">>, [
            {<<"__proto__">>, 1},
            {<<"constructor">>, 2},
            {<<"toString">>, 3}
        ]},
        {<<"rule_object">>, [
            {<<"a">>, <<"abc">>},
            {<<"b">>, <<>>}
        ]},
        {<<"modifier">>, [
            {<<"en">>, <<"HELLO">>},
            {<<"de">>, <<"HALLO">>}
        ]},
        {<<"empty_values_inside">>, [
            {<<"a">>, <<>>},
            {<<"b">>, null}
        ]},
        {<<"nested_objects">>, [
            {<<"u1">>, [
                {<<"name">>, <<"Jane Doe">>}
            ]},
            {<<"u2">>, [
                {<<"name">>, <<"John Doe">>}
            ]}
        ]},
        {<<"lists">>, [
            {<<"a">>, [1, 2]},
            {<<"b">>, []}
        ]},
        {<<"empty_field">>, <<>>},
        {<<"null_field">>, null}
    ]}
].
