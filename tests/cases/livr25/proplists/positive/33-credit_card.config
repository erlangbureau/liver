%% Imported for liver; iso_date outputs use Erlang {Y,M,D} dates.
%% Proplist fixtures preserve JSON key order from json:decode/3.

[
    {name, credit_card},
    {rules, [
        {<<"visa">>, credit_card},
        {<<"mastercard">>, [credit_card]},
        {<<"amex">>, [
            {credit_card, []}
        ]},
        {<<"discover">>, credit_card},
        {<<"twelve_digits">>, credit_card},
        {<<"fourteen_digits">>, credit_card},
        {<<"nineteen_digits">>, credit_card},
        {<<"number">>, credit_card},
        {<<"empty_field">>, credit_card},
        {<<"null_field">>, credit_card},
        {<<"missing_field">>, credit_card}
    ]},
    {input, [
        {<<"visa">>, <<"4111111111111111">>},
        {<<"mastercard">>, <<"5555555555554444">>},
        {<<"amex">>, <<"378282246310005">>},
        {<<"discover">>, <<"6011111111111117">>},
        {<<"twelve_digits">>, <<"500000000009">>},
        {<<"fourteen_digits">>, <<"40000000000002">>},
        {<<"nineteen_digits">>, <<"6000000000000000004">>},
        {<<"number">>, 4111111111111111},
        {<<"empty_field">>, <<>>},
        {<<"null_field">>, null},
        {<<"extra_field">>, <<"extra">>}
    ]},
    {output, [
        {<<"visa">>, <<"4111111111111111">>},
        {<<"mastercard">>, <<"5555555555554444">>},
        {<<"amex">>, <<"378282246310005">>},
        {<<"discover">>, <<"6011111111111117">>},
        {<<"twelve_digits">>, <<"500000000009">>},
        {<<"fourteen_digits">>, <<"40000000000002">>},
        {<<"nineteen_digits">>, <<"6000000000000000004">>},
        {<<"number">>, <<"4111111111111111">>},
        {<<"empty_field">>, <<>>},
        {<<"null_field">>, null}
    ]}
].
