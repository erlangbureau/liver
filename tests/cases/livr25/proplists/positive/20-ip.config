%% LIVR positive/20-ip (case: ip, form: proplists)
%% Source: https://github.com/koorchik/LIVR/tree/14e5a1b19011d3e9bf6ab5a6a0dd4444bea8b280/test_suite_2.5/positive/20-ip
%% Imported for liver; iso_date outputs use Erlang {Y,M,D} dates.
%% Proplist fixtures preserve JSON key order from json:decode/3.

[
    {name, ip},
    {rules, [
        {<<"ipv4">>, ip},
        {<<"ipv4_rule_list">>, [ip]},
        {<<"ipv4_empty_arguments">>, [
            {ip, []}
        ]},
        {<<"ipv4_zeros">>, ip},
        {<<"ipv4_max">>, ip},
        {<<"ipv6">>, ip},
        {<<"ipv6_full">>, ip},
        {<<"ipv6_leading_zeros">>, ip},
        {<<"ipv6_unspecified">>, ip},
        {<<"ipv6_loopback">>, ip},
        {<<"ipv6_trailing_double_colon">>, ip},
        {<<"ipv6_double_colon_one_group">>, ip},
        {<<"ipv6_double_colon_one_group_middle">>, ip},
        {<<"ipv6_mixed_case">>, ip},
        {<<"ipv6_embedded_ipv4">>, ip},
        {<<"ipv6_embedded_ipv4_compatible">>, ip},
        {<<"ipv6_embedded_ipv4_full">>, ip},
        {<<"ipv6_embedded_ipv4_prefix">>, ip},
        {<<"only_ipv4">>, [
            {ip, <<"v4">>}
        ]},
        {<<"only_ipv4_in_list">>, [
            {ip, [<<"v4">>]}
        ]},
        {<<"only_ipv6">>, [
            {ip, <<"v6">>}
        ]},
        {<<"only_ipv6_embedded_ipv4">>, [
            {ip, <<"v6">>}
        ]},
        {<<"empty_field">>, ip},
        {<<"null_field">>, ip},
        {<<"missing_field">>, ip}
    ]},
    {input, [
        {<<"ipv4">>, <<"192.0.2.1">>},
        {<<"ipv4_rule_list">>, <<"198.51.100.255">>},
        {<<"ipv4_empty_arguments">>, <<"203.0.113.0">>},
        {<<"ipv4_zeros">>, <<"0.0.0.0">>},
        {<<"ipv4_max">>, <<"255.255.255.255">>},
        {<<"ipv6">>, <<"2001:db8::1">>},
        {<<"ipv6_full">>, <<"2001:DB8:0:0:8:800:200C:417A">>},
        {<<"ipv6_leading_zeros">>, <<"2001:0db8:0000:0000:0000:0000:0000:0001">>},
        {<<"ipv6_unspecified">>, <<"::">>},
        {<<"ipv6_loopback">>, <<"::1">>},
        {<<"ipv6_trailing_double_colon">>, <<"2001:db8::">>},
        {<<"ipv6_double_colon_one_group">>, <<"2001:db8:1:2:3:4:5::">>},
        {<<"ipv6_double_colon_one_group_middle">>, <<"2001:db8:1:2::4:5:6">>},
        {<<"ipv6_mixed_case">>, <<"2001:Db8::aBcD">>},
        {<<"ipv6_embedded_ipv4">>, <<"::ffff:192.0.2.1">>},
        {<<"ipv6_embedded_ipv4_compatible">>, <<"::192.0.2.1">>},
        {<<"ipv6_embedded_ipv4_full">>, <<"0:0:0:0:0:ffff:192.0.2.1">>},
        {<<"ipv6_embedded_ipv4_prefix">>, <<"64:ff9b::192.0.2.33">>},
        {<<"only_ipv4">>, <<"192.0.2.1">>},
        {<<"only_ipv4_in_list">>, <<"192.0.2.2">>},
        {<<"only_ipv6">>, <<"2001:db8::1">>},
        {<<"only_ipv6_embedded_ipv4">>, <<"::ffff:192.0.2.1">>},
        {<<"empty_field">>, <<>>},
        {<<"null_field">>, null},
        {<<"extra_field">>, <<"extra">>}
    ]},
    {output, [
        {<<"ipv4">>, <<"192.0.2.1">>},
        {<<"ipv4_rule_list">>, <<"198.51.100.255">>},
        {<<"ipv4_empty_arguments">>, <<"203.0.113.0">>},
        {<<"ipv4_zeros">>, <<"0.0.0.0">>},
        {<<"ipv4_max">>, <<"255.255.255.255">>},
        {<<"ipv6">>, <<"2001:db8::1">>},
        {<<"ipv6_full">>, <<"2001:DB8:0:0:8:800:200C:417A">>},
        {<<"ipv6_leading_zeros">>, <<"2001:0db8:0000:0000:0000:0000:0000:0001">>},
        {<<"ipv6_unspecified">>, <<"::">>},
        {<<"ipv6_loopback">>, <<"::1">>},
        {<<"ipv6_trailing_double_colon">>, <<"2001:db8::">>},
        {<<"ipv6_double_colon_one_group">>, <<"2001:db8:1:2:3:4:5::">>},
        {<<"ipv6_double_colon_one_group_middle">>, <<"2001:db8:1:2::4:5:6">>},
        {<<"ipv6_mixed_case">>, <<"2001:Db8::aBcD">>},
        {<<"ipv6_embedded_ipv4">>, <<"::ffff:192.0.2.1">>},
        {<<"ipv6_embedded_ipv4_compatible">>, <<"::192.0.2.1">>},
        {<<"ipv6_embedded_ipv4_full">>, <<"0:0:0:0:0:ffff:192.0.2.1">>},
        {<<"ipv6_embedded_ipv4_prefix">>, <<"64:ff9b::192.0.2.33">>},
        {<<"only_ipv4">>, <<"192.0.2.1">>},
        {<<"only_ipv4_in_list">>, <<"192.0.2.2">>},
        {<<"only_ipv6">>, <<"2001:db8::1">>},
        {<<"only_ipv6_embedded_ipv4">>, <<"::ffff:192.0.2.1">>},
        {<<"empty_field">>, <<>>},
        {<<"null_field">>, null}
    ]}
