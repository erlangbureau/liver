%% LIVR positive/21-cidr (case: cidr, form: proplists)
%% Source: https://github.com/koorchik/LIVR/tree/44955f198e7cbd2d6ec2fb1926c9fe8bd2e5628d/test_suite_2.5/positive/21-cidr
%% Imported for liver; iso_date outputs use Erlang {Y,M,D} dates.
%% Proplist fixtures preserve JSON key order from json:decode/3.

[
    {name, cidr},
    {rules, [
        {<<"ipv4">>, cidr},
        {<<"ipv4_host_bits">>, [cidr]},
        {<<"ipv4_zero_prefix">>, [
            {cidr, []}
        ]},
        {<<"ipv4_host">>, cidr},
        {<<"ipv6">>, cidr},
        {<<"ipv6_zero_prefix">>, cidr},
        {<<"ipv6_host">>, cidr},
        {<<"ipv6_host_bits">>, cidr},
        {<<"ipv6_embedded_ipv4">>, cidr},
        {<<"only_ipv4">>, [
            {cidr, <<"v4">>}
        ]},
        {<<"only_ipv6">>, [
            {cidr, <<"v6">>}
        ]},
        {<<"only_ipv6_in_list">>, [
            {cidr, [<<"v6">>]}
        ]},
        {<<"empty_field">>, cidr},
        {<<"null_field">>, cidr},
        {<<"missing_field">>, cidr}
    ]},
    {input, [
        {<<"ipv4">>, <<"192.0.2.0/24">>},
        {<<"ipv4_host_bits">>, <<"10.0.0.1/8">>},
        {<<"ipv4_zero_prefix">>, <<"0.0.0.0/0">>},
        {<<"ipv4_host">>, <<"192.0.2.1/32">>},
        {<<"ipv6">>, <<"2001:db8::/32">>},
        {<<"ipv6_zero_prefix">>, <<"::/0">>},
        {<<"ipv6_host">>, <<"2001:db8::1/128">>},
        {<<"ipv6_host_bits">>, <<"2001:DB8::1/64">>},
        {<<"ipv6_embedded_ipv4">>, <<"::ffff:192.0.2.0/120">>},
        {<<"only_ipv4">>, <<"192.0.2.0/24">>},
        {<<"only_ipv6">>, <<"2001:db8::/48">>},
        {<<"only_ipv6_in_list">>, <<"2001:db8::/100">>},
        {<<"empty_field">>, <<>>},
        {<<"null_field">>, null},
        {<<"extra_field">>, <<"extra">>}
    ]},
    {output, [
        {<<"ipv4">>, <<"192.0.2.0/24">>},
        {<<"ipv4_host_bits">>, <<"10.0.0.1/8">>},
        {<<"ipv4_zero_prefix">>, <<"0.0.0.0/0">>},
        {<<"ipv4_host">>, <<"192.0.2.1/32">>},
        {<<"ipv6">>, <<"2001:db8::/32">>},
        {<<"ipv6_zero_prefix">>, <<"::/0">>},
        {<<"ipv6_host">>, <<"2001:db8::1/128">>},
        {<<"ipv6_host_bits">>, <<"2001:DB8::1/64">>},
        {<<"ipv6_embedded_ipv4">>, <<"::ffff:192.0.2.0/120">>},
        {<<"only_ipv4">>, <<"192.0.2.0/24">>},
        {<<"only_ipv6">>, <<"2001:db8::/48">>},
        {<<"only_ipv6_in_list">>, <<"2001:db8::/100">>},
        {<<"empty_field">>, <<>>},
        {<<"null_field">>, null}
    ]}
].
