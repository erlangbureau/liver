%% LIVR positive/36-url (case: url, form: proplists)
%% Source: https://github.com/koorchik/LIVR/tree/44955f198e7cbd2d6ec2fb1926c9fe8bd2e5628d/test_suite_2.5/positive/36-url
%% Imported for liver; iso_date outputs use Erlang {Y,M,D} dates.
%% Proplist fixtures preserve JSON key order from json:decode/3.

[
    {name, url},
    {rules, [
        {<<"port_one_digit">>, url},
        {<<"port_one_digit_path">>, [url]},
        {<<"port_max">>, [
            {url, []}
        ]},
        {<<"ipv4_port_one_digit">>, url},
        {<<"label_63">>, url},
        {<<"tld_63">>, url},
        {<<"dot_in_path">>, url},
        {<<"dot_in_query">>, url},
        {<<"empty_field">>, url}
    ]},
    {input, [
        {<<"port_one_digit">>, <<"https://example.com:8">>},
        {<<"port_one_digit_path">>, <<"http://example.com:8/path?q=1#top">>},
        {<<"port_max">>, <<"https://example.com:65535/">>},
        {<<"ipv4_port_one_digit">>, <<"http://192.0.2.1:8/">>},
        {<<"label_63">>, <<"https://aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.example.com/">>},
        {<<"tld_63">>, <<"https://example.aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa">>},
        {<<"dot_in_path">>, <<"https://example.com/file.">>},
        {<<"dot_in_query">>, <<"https://example.com/?q=a.">>},
        {<<"empty_field">>, <<>>},
        {<<"extra_field">>, <<"aaaa">>}
    ]},
    {output, [
        {<<"port_one_digit">>, <<"https://example.com:8">>},
        {<<"port_one_digit_path">>, <<"http://example.com:8/path?q=1#top">>},
        {<<"port_max">>, <<"https://example.com:65535/">>},
        {<<"ipv4_port_one_digit">>, <<"http://192.0.2.1:8/">>},
        {<<"label_63">>, <<"https://aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.example.com/">>},
        {<<"tld_63">>, <<"https://example.aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa">>},
        {<<"dot_in_path">>, <<"https://example.com/file.">>},
        {<<"dot_in_query">>, <<"https://example.com/?q=a.">>},
        {<<"empty_field">>, <<>>}
    ]}
].
