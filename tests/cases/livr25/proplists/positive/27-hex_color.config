%% LIVR positive/27-hex_color (case: hex_color, form: proplists)
%% Source: https://github.com/koorchik/LIVR/tree/14e5a1b19011d3e9bf6ab5a6a0dd4444bea8b280/test_suite_2.5/positive/27-hex_color
%% Imported for liver; iso_date outputs use Erlang {Y,M,D} dates.
%% Proplist fixtures preserve JSON key order from json:decode/3.

[
    {name, hex_color},
    {rules, [
        {<<"three">>, hex_color},
        {<<"four">>, [hex_color]},
        {<<"six">>, [
            {hex_color, []}
        ]},
        {<<"eight">>, hex_color},
        {<<"empty_field">>, hex_color},
        {<<"null_field">>, hex_color},
        {<<"missing_field">>, hex_color}
    ]},
    {input, [
        {<<"three">>, <<"#fff">>},
        {<<"four">>, <<"#FFFA">>},
        {<<"six">>, <<"#a1b2c3">>},
        {<<"eight">>, <<"#A1B2c3D4">>},
        {<<"empty_field">>, <<>>},
        {<<"null_field">>, null},
        {<<"extra_field">>, <<"extra">>}
    ]},
    {output, [
        {<<"three">>, <<"#fff">>},
        {<<"four">>, <<"#FFFA">>},
        {<<"six">>, <<"#a1b2c3">>},
        {<<"eight">>, <<"#A1B2c3D4">>},
        {<<"empty_field">>, <<>>},
        {<<"null_field">>, null}
    ]}
].
