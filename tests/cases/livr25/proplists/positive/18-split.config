%% LIVR positive/18-split (case: split, form: proplists)
%% Source: https://github.com/koorchik/LIVR/tree/14e5a1b19011d3e9bf6ab5a6a0dd4444bea8b280/test_suite_2.5/positive/18-split
%% Imported for liver; iso_date outputs use Erlang {Y,M,D} dates.
%% Proplist fixtures preserve JSON key order from json:decode/3.

[
    {name, split},
    {rules, [
        {<<"ids">>, [
            [
                {split, <<",">>}
            ],
            [
                {list_of, positive_integer}
            ]
        ]},
        {<<"ids_list">>, [
            [
                {split, <<",">>}
            ],
            [
                {list_of, positive_integer}
            ]
        ]},
        {<<"ids_single">>, [
            [
                {split, <<",">>}
            ],
            [
                {list_of, positive_integer}
            ]
        ]},
        {<<"ids_number">>, [
            [
                {split, <<",">>}
            ],
            [
                {list_of, positive_integer}
            ]
        ]},
        {<<"split_only">>, [
            {split, <<",">>}
        ]},
        {<<"split_argument_in_list">>, [
            {split, [<<",">>]}
        ]},
        {<<"single_value">>, [
            {split, <<",">>}
        ]},
        {<<"empty_parts">>, [
            {split, <<",">>}
        ]},
        {<<"leading_and_trailing_separators">>, [
            {split, <<",">>}
        ]},
        {<<"only_separator">>, [
            {split, <<",">>}
        ]},
        {<<"spaces_kept">>, [
            {split, <<",">>}
        ]},
        {<<"multi_char_separator">>, [
            {split, <<", ">>}
        ]},
        {<<"regexp_char_separator">>, [
            {split, <<".">>}
        ]},
        {<<"pipe_separator">>, [
            {split, <<"|">>}
        ]},
        {<<"list_unchanged">>, [
            {split, <<",">>}
        ]},
        {<<"empty_list_unchanged">>, [
            {split, <<",">>}
        ]},
        {<<"number">>, [
            {split, <<",">>}
        ]},
        {<<"decimal_number">>, [
            {split, <<".">>}
        ]},
        {<<"integral_decimal_number">>, [
            {split, <<".">>}
        ]},
        {<<"boolean">>, [
            {split, <<",">>}
        ]},
        {<<"boolean_false">>, [
            {split, <<",">>}
        ]},
        {<<"number_argument">>, [
            {split, 1}
        ]},
        {<<"number_argument_number_value">>, [
            {split, 1}
        ]},
        {<<"object_unchanged">>, [
            {split, <<",">>}
        ]},
        {<<"empty_object_unchanged">>, [
            {split, <<",">>}
        ]},
        {<<"empty_field">>, [
            {split, <<",">>}
        ]},
        {<<"null_field">>, [
            {split, <<",">>}
        ]},
        {<<"missing_field">>, [
            {split, <<",">>}
        ]}
    ]},
    {input, [
        {<<"ids">>, <<"1,2,3">>},
        {<<"ids_list">>, [<<"5">>, <<"6">>]},
        {<<"ids_single">>, <<"5">>},
        {<<"ids_number">>, 5},
        {<<"split_only">>, <<"1,2,3">>},
        {<<"split_argument_in_list">>, <<"a,b">>},
        {<<"single_value">>, <<"5">>},
        {<<"empty_parts">>, <<"a,,b">>},
        {<<"leading_and_trailing_separators">>, <<",a,">>},
        {<<"only_separator">>, <<",">>},
        {<<"spaces_kept">>, <<"a, b">>},
        {<<"multi_char_separator">>, <<"a, b,c">>},
        {<<"regexp_char_separator">>, <<"a.b.c">>},
        {<<"pipe_separator">>, <<"a|b">>},
        {<<"list_unchanged">>, [<<"a,b">>, <<"c">>]},
        {<<"empty_list_unchanged">>, []},
        {<<"number">>, 5},
        {<<"decimal_number">>, 1.5},
        {<<"integral_decimal_number">>, 1.0},
        {<<"boolean">>, true},
        {<<"boolean_false">>, false},
        {<<"number_argument">>, <<"a1b1c">>},
        {<<"number_argument_number_value">>, 515},
        {<<"object_unchanged">>, [
            {<<"a">>, <<"1,2">>}
        ]},
        {<<"empty_object_unchanged">>, [{}]},
        {<<"empty_field">>, <<>>},
        {<<"null_field">>, null},
        {<<"extra_field">>, <<"extra">>}
    ]},
    {output, [
        {<<"ids">>, [1, 2, 3]},
        {<<"ids_list">>, [5, 6]},
        {<<"ids_single">>, [5]},
        {<<"ids_number">>, [5]},
        {<<"split_only">>, [<<"1">>, <<"2">>, <<"3">>]},
        {<<"split_argument_in_list">>, [<<"a">>, <<"b">>]},
        {<<"single_value">>, [<<"5">>]},
        {<<"empty_parts">>, [<<"a">>, <<>>, <<"b">>]},
        {<<"leading_and_trailing_separators">>, [<<>>, <<"a">>, <<>>]},
        {<<"only_separator">>, [<<>>, <<>>]},
        {<<"spaces_kept">>, [<<"a">>, <<" b">>]},
        {<<"multi_char_separator">>, [<<"a">>, <<"b,c">>]},
        {<<"regexp_char_separator">>, [<<"a">>, <<"b">>, <<"c">>]},
        {<<"pipe_separator">>, [<<"a">>, <<"b">>]},
        {<<"list_unchanged">>, [<<"a,b">>, <<"c">>]},
        {<<"empty_list_unchanged">>, []},
        {<<"number">>, [<<"5">>]},
        {<<"decimal_number">>, [<<"1">>, <<"5">>]},
        {<<"integral_decimal_number">>, [<<"1">>]},
        {<<"boolean">>, [<<"true">>]},
        {<<"boolean_false">>, [<<"false">>]},
        {<<"number_argument">>, [<<"a">>, <<"b">>, <<"c">>]},
        {<<"number_argument_number_value">>, [<<"5">>, <<"5">>]},
        {<<"object_unchanged">>, [
            {<<"a">>, <<"1,2">>}
        ]},
        {<<"empty_object_unchanged">>, [{}]},
        {<<"empty_field">>, <<>>},
        {<<"null_field">>, null}
    ]}
].
