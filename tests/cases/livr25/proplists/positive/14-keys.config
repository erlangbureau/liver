%% LIVR positive/14-keys (case: keys, form: proplists)
%% Source: https://github.com/koorchik/LIVR/tree/44955f198e7cbd2d6ec2fb1926c9fe8bd2e5628d/test_suite_2.5/positive/14-keys
%% Imported for liver; iso_date outputs use Erlang {Y,M,D} dates.
%% Proplist fixtures preserve JSON key order from json:decode/3.

[
    {name, keys},
    {rules, [
        {<<"translations">>, [
            [
                {keys, [
                    {one_of, [<<"uk">>, <<"en">>, <<"de">>]}
                ]}
            ],
            [
                {values, [
                    required,
                    string,
                    [
                        {max_length, 200}
                    ]
                ]}
            ]
        ]},
        {<<"like_keys">>, [
            {keys, [
                {like, <<"^[a-z_]+$">>}
            ]}
        ]},
        {<<"modifier_output_ignored">>, [
            {keys, to_uc}
        ]},
        {<<"rule_list">>, [
            {keys, [
                required,
                [
                    {max_length, 2}
                ]
            ]}
        ]},
        {<<"values_not_validated">>, [
            {keys, string}
        ]},
        {<<"empty_field">>, [
            [
                {keys, [
                    {one_of, [<<"uk">>, <<"en">>, <<"de">>]}
                ]}
            ],
            [
                {values, [
                    required,
                    string,
                    [
                        {max_length, 200}
                    ]
                ]}
            ]
        ]},
        {<<"null_field">>, [
            [
                {keys, [
                    {one_of, [<<"uk">>, <<"en">>, <<"de">>]}
                ]}
            ],
            [
                {values, [
                    required,
                    string,
                    [
                        {max_length, 200}
                    ]
                ]}
            ]
        ]},
        {<<"missing_field">>, [
            [
                {keys, [
                    {one_of, [<<"uk">>, <<"en">>, <<"de">>]}
                ]}
            ],
            [
                {values, [
                    required,
                    string,
                    [
                        {max_length, 200}
                    ]
                ]}
            ]
        ]}
    ]},
    {input, [
        {<<"translations">>, [
            {<<"uk">>, <<"Привіт"/utf8>>},
            {<<"en">>, <<"Hello">>}
        ]},
        {<<"like_keys">>, [
            {<<"first_name">>, 1},
            {<<"last_name">>, [
                {<<"x">>, [1]}
            ]}
        ]},
        {<<"modifier_output_ignored">>, [
            {<<"ab">>, <<"cd">>}
        ]},
        {<<"rule_list">>, [
            {<<"uk">>, 1},
            {<<"en">>, 2}
        ]},
        {<<"values_not_validated">>, [
            {<<"a">>, [
                {<<"b">>, <<"c">>}
            ]},
            {<<"d">>, null}
        ]},
        {<<"empty_field">>, <<>>},
        {<<"null_field">>, null},
        {<<"extra_field">>, <<"extra">>}
    ]},
    {output, [
        {<<"translations">>, [
            {<<"uk">>, <<"Привіт"/utf8>>},
            {<<"en">>, <<"Hello">>}
        ]},
        {<<"like_keys">>, [
            {<<"first_name">>, 1},
            {<<"last_name">>, [
                {<<"x">>, [1]}
            ]}
        ]},
        {<<"modifier_output_ignored">>, [
            {<<"ab">>, <<"cd">>}
        ]},
        {<<"rule_list">>, [
            {<<"uk">>, 1},
            {<<"en">>, 2}
        ]},
        {<<"values_not_validated">>, [
            {<<"a">>, [
                {<<"b">>, <<"c">>}
            ]},
            {<<"d">>, null}
        ]},
        {<<"empty_field">>, <<>>},
        {<<"null_field">>, null}
    ]}
].
