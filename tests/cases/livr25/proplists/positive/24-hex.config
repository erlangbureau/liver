%% LIVR positive/24-hex (case: hex, form: proplists)
%% Source: https://github.com/koorchik/LIVR/tree/14e5a1b19011d3e9bf6ab5a6a0dd4444bea8b280/test_suite_2.5/positive/24-hex
%% Imported for liver; iso_date outputs use Erlang {Y,M,D} dates.
%% Proplist fixtures preserve JSON key order from json:decode/3.

[
    {name, hex},
    {rules, [
        {<<"mixed_case">>, hex},
        {<<"single_digit">>, [hex]},
        {<<"all_digits">>, [
            {hex, []}
        ]},
        {<<"odd_length">>, hex},
        {<<"number">>, hex},
        {<<"one_point_zero_number">>, hex},
        {<<"minus_zero_number">>, hex},
        {<<"hundred_number">>, hex},
        {<<"exponent_number">>, hex},
        {<<"big_integer">>, hex},
        {<<"empty_field">>, hex},
        {<<"null_field">>, hex},
        {<<"missing_field">>, hex}
    ]},
    {input, [
        {<<"mixed_case">>, <<"deadBEEF">>},
        {<<"single_digit">>, <<"0">>},
        {<<"all_digits">>, <<"0123456789abcdefABCDEF">>},
        {<<"odd_length">>, <<"abc">>},
        {<<"number">>, 123},
        {<<"one_point_zero_number">>, 1.0},
        {<<"minus_zero_number">>, -0.0},
        {<<"hundred_number">>, 100},
        {<<"exponent_number">>, 1.0e3},
        {<<"big_integer">>, 123456789012345},
        {<<"empty_field">>, <<>>},
        {<<"null_field">>, null},
        {<<"extra_field">>, <<"extra">>}
    ]},
    {output, [
        {<<"mixed_case">>, <<"deadBEEF">>},
        {<<"single_digit">>, <<"0">>},
        {<<"all_digits">>, <<"0123456789abcdefABCDEF">>},
        {<<"odd_length">>, <<"abc">>},
        {<<"number">>, <<"123">>},
        {<<"one_point_zero_number">>, <<"1">>},
        {<<"minus_zero_number">>, <<"0">>},
        {<<"hundred_number">>, <<"100">>},
        {<<"exponent_number">>, <<"1000">>},
        {<<"big_integer">>, <<"123456789012345">>},
        {<<"empty_field">>, <<>>},
        {<<"null_field">>, null}
    ]}
].
