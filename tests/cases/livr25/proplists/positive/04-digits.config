%% LIVR positive/04-digits (case: digits, form: proplists)
%% Source: https://github.com/koorchik/LIVR/tree/14e5a1b19011d3e9bf6ab5a6a0dd4444bea8b280/test_suite_2.5/positive/04-digits
%% Imported for liver; iso_date outputs use Erlang {Y,M,D} dates.
%% Proplist fixtures preserve JSON key order from json:decode/3.

[
    {name, digits},
    {rules, [
        {<<"zip">>, digits},
        {<<"leading_zeros">>, [digits]},
        {<<"number">>, [
            {digits, []}
        ]},
        {<<"zero_string">>, digits},
        {<<"zero_number">>, digits},
        {<<"all_digits">>, digits},
        {<<"otp">>, [
            digits,
            [
                {length_equal, 6}
            ]
        ]},
        {<<"otp_number">>, [
            digits,
            [
                {length_equal, 6}
            ]
        ]},
        {<<"one_point_zero">>, digits},
        {<<"minus_zero">>, digits},
        {<<"hundred">>, digits},
        {<<"exponent">>, digits},
        {<<"big_integer">>, digits},
        {<<"empty_field">>, digits},
        {<<"null_field">>, digits},
        {<<"missing_field">>, digits}
    ]},
    {input, [
        {<<"zip">>, <<"01001">>},
        {<<"leading_zeros">>, <<"007">>},
        {<<"number">>, 7},
        {<<"zero_string">>, <<"0">>},
        {<<"zero_number">>, 0},
        {<<"all_digits">>, <<"0123456789">>},
        {<<"otp">>, <<"000123">>},
        {<<"otp_number">>, 123456},
        {<<"one_point_zero">>, 1.0},
        {<<"minus_zero">>, -0.0},
        {<<"hundred">>, 100},
        {<<"exponent">>, 1.0e3},
        {<<"big_integer">>, 123456789012345},
        {<<"empty_field">>, <<>>},
        {<<"null_field">>, null},
        {<<"extra_field">>, <<"extra">>}
    ]},
    {output, [
        {<<"zip">>, <<"01001">>},
        {<<"leading_zeros">>, <<"007">>},
        {<<"number">>, <<"7">>},
        {<<"zero_string">>, <<"0">>},
        {<<"zero_number">>, <<"0">>},
        {<<"all_digits">>, <<"0123456789">>},
        {<<"otp">>, <<"000123">>},
        {<<"otp_number">>, <<"123456">>},
        {<<"one_point_zero">>, <<"1">>},
        {<<"minus_zero">>, <<"0">>},
        {<<"hundred">>, <<"100">>},
        {<<"exponent">>, <<"1000">>},
        {<<"big_integer">>, <<"123456789012345">>},
        {<<"empty_field">>, <<>>},
        {<<"null_field">>, null}
    ]}
].
