%% Imported for liver; iso_date outputs use Erlang {Y,M,D} dates.
%% Proplist fixtures preserve JSON key order from json:decode/3.

[
    {name, e164},
    {rules, [
        {<<"phone">>, e164},
        {<<"min_length">>, [e164]},
        {<<"max_length">>, [
            {e164, []}
        ]},
        {<<"zeros_after_first">>, e164},
        {<<"empty_field">>, e164},
        {<<"null_field">>, e164},
        {<<"missing_field">>, e164}
    ]},
    {input, [
        {<<"phone">>, <<"+15555550100">>},
        {<<"min_length">>, <<"+1234567">>},
        {<<"max_length">>, <<"+123456789012345">>},
        {<<"zeros_after_first">>, <<"+10000000">>},
        {<<"empty_field">>, <<>>},
        {<<"null_field">>, null},
        {<<"extra_field">>, <<"extra">>}
    ]},
    {output, [
        {<<"phone">>, <<"+15555550100">>},
        {<<"min_length">>, <<"+1234567">>},
        {<<"max_length">>, <<"+123456789012345">>},
        {<<"zeros_after_first">>, <<"+10000000">>},
        {<<"empty_field">>, <<>>},
        {<<"null_field">>, null}
    ]}
].
