%% LIVR aliases_negative/02-contact (case: contact, form: proplists)
%% Source: https://github.com/koorchik/LIVR/tree/44955f198e7cbd2d6ec2fb1926c9fe8bd2e5628d/test_suite_2.5/aliases_negative/02-contact
%% Imported for liver; iso_date outputs use Erlang {Y,M,D} dates.
%% Proplist fixtures preserve JSON key order from json:decode/3.

[
    {name, contact},
    {rules, [
        {<<"contact1">>, <<"contact">>},
        {<<"contact2">>, [required, <<"contact">>]},
        {<<"contact3">>, <<"contact_with_custom_error">>}
    ]},
    {input, [
        {<<"contact1">>, [{}]},
        {<<"contact2">>, [
            {<<"email">>, <<"user@example.com">>},
            {<<"phone">>, <<"555-0100">>}
        ]},
        {<<"contact3">>, [
            {<<"email">>, <<>>},
            {<<"phone">>, null}
        ]}
    ]},
    {errors, [
        {<<"contact1">>, [
            {<<"email">>, <<"REQUIRED">>},
            {<<"phone">>, <<"REQUIRED">>}
        ]},
        {<<"contact2">>, [
            {<<"phone">>, <<"WRONG_E164">>}
        ]},
        {<<"contact3">>, <<"WRONG_CONTACT">>}
    ]},
    {opts, [
        {aliased_rules, [
            [
                {name, contact},
                {rules, [
                    {nested_object, [
                        {<<"email">>, [
                            {'when', [
                                <<"phone">>,
                                not_empty,
                                email,
                                [required, email]
                            ]}
                        ]},
                        {<<"phone">>, [
                            {'when', [
                                <<"email">>,
                                not_empty,
                                e164,
                                [required, e164]
                            ]}
                        ]}
                    ]}
                ]}
            ],
            [
                {name, contact_with_custom_error},
                {rules, <<"contact">>},
                {error, <<"WRONG_CONTACT">>}
            ]
        ]}
    ]}
].
