%% LIVR aliases_negative/01-ulid (case: ulid, form: proplists)
%% Source: https://github.com/koorchik/LIVR/tree/14e5a1b19011d3e9bf6ab5a6a0dd4444bea8b280/test_suite_2.5/aliases_negative/01-ulid
%% Imported for liver; iso_date outputs use Erlang {Y,M,D} dates.
%% Proplist fixtures preserve JSON key order from json:decode/3.

[
    {name, ulid},
    {rules, [
        {<<"id1">>, <<"ulid">>},
        {<<"id2">>, [required, <<"ulid">>]},
        {<<"empty_id">>, <<"ulid">>}
    ]},
    {input, [
        {<<"id1">>, <<"81ARZ3NDEKTSV4RRFFQ69G5FAV">>},
        {<<"id2">>, <<"01ARZ3NDEKTSV4RRFFQ69G5FAI">>},
        {<<"empty_id">>, <<>>}
    ]},
    {errors, [
        {<<"id1">>, <<"WRONG_ULID">>},
        {<<"id2">>, <<"WRONG_ULID">>}
    ]},
    {opts, [
        {aliased_rules, [
            [
                {name, ulid},
                {rules, [
                    {like, <<"^[0-7][0-9A-HJKMNP-TV-Z]{25}$">>}
                ]},
                {error, <<"WRONG_ULID">>}
            ]
        ]}
    ]}
].
