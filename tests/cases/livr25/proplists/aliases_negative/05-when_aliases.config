%% LIVR aliases_negative/05-when_aliases (case: when_aliases, form: proplists)
%% Source: https://github.com/koorchik/LIVR/tree/44955f198e7cbd2d6ec2fb1926c9fe8bd2e5628d/test_suite_2.5/aliases_negative/05-when_aliases
%% Imported for liver; iso_date outputs use Erlang {Y,M,D} dates.
%% Proplist fixtures preserve JSON key order from json:decode/3.

[
    {name, when_aliases},
    {rules, [
        {<<"type">>, string},
        {<<"vat_number">>, <<"vat_by_type">>},
        {<<"pay_type">>, [
            required,
            [
                {one_of, [<<"card">>, <<"bank">>]}
            ]
        ]},
        {<<"data">>, <<"required_payment_data">>},
        {<<"person">>, [
            {nested_object, [
                {<<"type">>, required},
                {<<"vat_number">>, <<"vat_by_type">>}
            ]}
        ]},
        {<<"orders">>, [
            {list_of_objects, [
                {<<"data">>, <<"payment_data">>}
            ]}
        ]},
        {<<"payments">>, [
            {list_of, <<"payment_data">>}
        ]},
        {<<"either">>, [
            {'or', [
                [
                    required,
                    [
                        {eq, <<"none">>}
                    ]
                ],
                <<"vat_by_type">>
            ]}
        ]}
    ]},
    {input, [
        {<<"type">>, <<"company">>},
        {<<"pay_type">>, <<"card">>},
        {<<"data">>, [
            {<<"number">>, <<"4111111111111112">>}
        ]},
        {<<"person">>, [
            {<<"type">>, <<"person">>},
            {<<"vat_number">>, <<"UA12345678">>}
        ]},
        {<<"orders">>, [
            [
                {<<"data">>, [
                    {<<"number">>, <<"4111111111111111">>}
                ]}
            ],
            [
                {<<"data">>, <<>>}
            ]
        ]},
        {<<"payments">>, [
            [
                {<<"number">>, <<"4111111111111111">>}
            ]
        ]}
    ]},
    {errors, [
        {<<"vat_number">>, <<"REQUIRED">>},
        {<<"data">>, [
            {<<"number">>, <<"WRONG_CREDIT_CARD_NUMBER">>}
        ]},
        {<<"person">>, [
            {<<"vat_number">>, <<"NOT_ALLOWED_VALUE">>}
        ]},
        {<<"orders">>, [
            [
                {<<"data">>, <<"NOT_ALLOWED_VALUE">>}
            ],
            null
        ]},
        {<<"payments">>, [<<"NOT_ALLOWED_VALUE">>]},
        {<<"either">>, <<"REQUIRED">>}
    ]},
    {opts, [
        {aliased_rules, [
            [
                {name, vat_by_type},
                {rules, [
                    {'when', [
                        <<"type">>,
                        [
                            {eq, <<"company">>}
                        ],
                        [
                            required,
                            [
                                {like, <<"^[A-Z]{2}[0-9]{8,12}$">>}
                            ]
                        ],
                        [
                            {eq, <<>>}
                        ]
                    ]}
                ]}
            ],
            [
                {name, case_by_mode},
                {rules, [
                    {'when', [
                        <<"mode">>,
                        [
                            {eq, <<"upper">>}
                        ],
                        to_uc,
                        to_lc
                    ]}
                ]}
            ],
            [
                {name, payment_data},
                {rules, [
                    {'when', [
                        <<"pay_type">>,
                        [
                            {<<"card">>, [
                                {nested_object, [
                                    {<<"number">>, [required, credit_card]}
                                ]}
                            ]},
                            {<<"bank">>, [
                                {nested_object, [
                                    {<<"iban">>, [required, iban]}
                                ]}
                            ]}
                        ]
                    ]}
                ]}
            ],
            [
                {name, required_payment_data},
                {rules, [required, <<"payment_data">>]}
            ]
        ]}
    ]}
].
