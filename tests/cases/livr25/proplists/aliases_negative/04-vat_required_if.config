%% LIVR aliases_negative/04-vat_required_if (case: vat_required_if, form: proplists)
%% Source: https://github.com/koorchik/LIVR/tree/44955f198e7cbd2d6ec2fb1926c9fe8bd2e5628d/test_suite_2.5/aliases_negative/04-vat_required_if
%% Imported for liver; iso_date outputs use Erlang {Y,M,D} dates.
%% Proplist fixtures preserve JSON key order from json:decode/3.

[
    {name, vat_required_if},
    {rules, [
        {<<"type">>, [
            required,
            [
                {one_of, [<<"person">>, <<"company">>, <<"ngo">>]}
            ]
        ]},
        {<<"vat_number">>, <<"vat">>},
        {<<"strict_vat_number">>, <<"strict_vat">>},
        {<<"bad_strict_vat_number">>, <<"strict_vat">>},
        {<<"person">>, [
            {nested_object, [
                {<<"type">>, required},
                {<<"vat_number">>, <<"vat">>}
            ]}
        ]},
        {<<"company">>, [
            {nested_object, [
                {<<"type">>, required},
                {<<"vat_number">>, <<"strict_vat">>}
            ]}
        ]},
        {<<"members">>, [
            {list_of_objects, [
                {<<"type">>, required},
                {<<"vat_number">>, <<"vat_with_custom_error">>}
            ]}
        ]}
    ]},
    {input, [
        {<<"type">>, <<"company">>},
        {<<"strict_vat_number">>, <<>>},
        {<<"bad_strict_vat_number">>, <<"ua12345678">>},
        {<<"person">>, [
            {<<"type">>, <<"company">>},
            {<<"vat_number">>, null}
        ]},
        {<<"company">>, [
            {<<"type">>, <<"company">>}
        ]},
        {<<"members">>, [
            [
                {<<"type">>, <<"company">>}
            ],
            [
                {<<"type">>, <<"person">>}
            ],
            [
                {<<"type">>, <<"company">>},
                {<<"vat_number">>, <<>>}
            ]
        ]}
    ]},
    {errors, [
        {<<"vat_number">>, <<"REQUIRED">>},
        {<<"strict_vat_number">>, <<"REQUIRED">>},
        {<<"bad_strict_vat_number">>, <<"WRONG_FORMAT">>},
        {<<"person">>, [
            {<<"vat_number">>, <<"REQUIRED">>}
        ]},
        {<<"company">>, [
            {<<"vat_number">>, <<"REQUIRED">>}
        ]},
        {<<"members">>, [
            [
                {<<"vat_number">>, <<"VAT_REQUIRED">>}
            ],
            null,
            [
                {<<"vat_number">>, <<"VAT_REQUIRED">>}
            ]
        ]}
    ]},
    {opts, [
        {aliased_rules, [
            [
                {name, vat},
                {rules, [
                    {required_if, [
                        {<<"type">>, <<"company">>}
                    ]}
                ]}
            ],
            [
                {name, strict_vat},
                {rules, [
                    <<"vat">>,
                    [
                        {like, <<"^[A-Z]{2}[0-9]{8,12}$">>}
                    ]
                ]}
            ],
            [
                {name, vat_with_custom_error},
                {rules, [
                    {required_if, [
                        {<<"type">>, <<"company">>}
                    ]}
                ]},
                {error, <<"VAT_REQUIRED">>}
            ]
        ]}
    ]}
].
