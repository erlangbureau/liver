%% LIVR negative/04-digits (case: digits, form: proplists)
%% Source: https://github.com/koorchik/LIVR/tree/44955f198e7cbd2d6ec2fb1926c9fe8bd2e5628d/test_suite_2.5/negative/04-digits
%% Imported for liver; iso_date outputs use Erlang {Y,M,D} dates.
%% Proplist fixtures preserve JSON key order from json:decode/3.

[
    {name, digits},
    {rules, [
        {<<"with_letter">>, digits},
        {<<"minus_string">>, [digits]},
        {<<"minus_number">>, digits},
        {<<"plus_string">>, digits},
        {<<"decimal_number">>, digits},
        {<<"decimal_string">>, digits},
        {<<"inner_space">>, digits},
        {<<"leading_space">>, digits},
        {<<"trailing_newline">>, digits},
        {<<"space_only">>, digits},
        {<<"non_ascii_digits">>, digits},
        {<<"fullwidth_digits">>, digits},
        {<<"boolean">>, digits},
        {<<"otp_too_short">>, [
            digits,
            [
                {length_equal, 6}
            ]
        ]},
        {<<"otp_not_digits">>, [
            digits,
            [
                {length_equal, 6}
            ]
        ]},
        {<<"fraction">>, digits},
        {<<"negative_fraction">>, digits},
        {<<"negative_integral_number">>, digits},
        {<<"mixed_ascii_and_arabic_indic">>, digits},
        {<<"devanagari_digits">>, digits},
        {<<"leading_newline">>, digits},
        {<<"trailing_crlf">>, digits},
        {<<"empty_field">>, digits},
        {<<"null_field">>, digits},
        {<<"value_is_hash">>, digits},
        {<<"value_is_empty_hash">>, digits},
        {<<"value_is_array">>, digits},
        {<<"value_is_empty_array">>, digits}
    ]},
    {input, [
        {<<"with_letter">>, <<"12a">>},
        {<<"minus_string">>, <<"-1">>},
        {<<"minus_number">>, -1},
        {<<"plus_string">>, <<"+1">>},
        {<<"decimal_number">>, 1.5},
        {<<"decimal_string">>, <<"1.0">>},
        {<<"inner_space">>, <<"1 2">>},
        {<<"leading_space">>, <<" 12">>},
        {<<"trailing_newline">>, <<"123\n">>},
        {<<"space_only">>, <<" ">>},
        {<<"non_ascii_digits">>, <<"١٢٣"/utf8>>},
        {<<"fullwidth_digits">>, <<"１２３"/utf8>>},
        {<<"boolean">>, true},
        {<<"otp_too_short">>, <<"12345">>},
        {<<"otp_not_digits">>, <<"12345a">>},
        {<<"fraction">>, 0.1},
        {<<"negative_fraction">>, -12.25},
        {<<"negative_integral_number">>, -3.0},
        {<<"mixed_ascii_and_arabic_indic">>, <<"12١"/utf8>>},
        {<<"devanagari_digits">>, <<"१२३"/utf8>>},
        {<<"leading_newline">>, <<"\n123">>},
        {<<"trailing_crlf">>, <<"123\r\n">>},
        {<<"empty_field">>, <<>>},
        {<<"null_field">>, null},
        {<<"extra_field">>, <<"extra">>},
        {<<"value_is_hash">>, [
            {<<"test">>, 1}
        ]},
        {<<"value_is_empty_hash">>, [{}]},
        {<<"value_is_array">>, [<<"test">>, 1]},
        {<<"value_is_empty_array">>, []}
    ]},
    {errors, [
        {<<"with_letter">>, <<"NOT_DIGITS">>},
        {<<"minus_string">>, <<"NOT_DIGITS">>},
        {<<"minus_number">>, <<"NOT_DIGITS">>},
        {<<"plus_string">>, <<"NOT_DIGITS">>},
        {<<"decimal_number">>, <<"NOT_DIGITS">>},
        {<<"decimal_string">>, <<"NOT_DIGITS">>},
        {<<"inner_space">>, <<"NOT_DIGITS">>},
        {<<"leading_space">>, <<"NOT_DIGITS">>},
        {<<"trailing_newline">>, <<"NOT_DIGITS">>},
        {<<"space_only">>, <<"NOT_DIGITS">>},
        {<<"non_ascii_digits">>, <<"NOT_DIGITS">>},
        {<<"fullwidth_digits">>, <<"NOT_DIGITS">>},
        {<<"boolean">>, <<"NOT_DIGITS">>},
        {<<"otp_too_short">>, <<"TOO_SHORT">>},
        {<<"otp_not_digits">>, <<"NOT_DIGITS">>},
        {<<"fraction">>, <<"NOT_DIGITS">>},
        {<<"negative_fraction">>, <<"NOT_DIGITS">>},
        {<<"negative_integral_number">>, <<"NOT_DIGITS">>},
        {<<"mixed_ascii_and_arabic_indic">>, <<"NOT_DIGITS">>},
        {<<"devanagari_digits">>, <<"NOT_DIGITS">>},
        {<<"leading_newline">>, <<"NOT_DIGITS">>},
        {<<"trailing_crlf">>, <<"NOT_DIGITS">>},
        {<<"value_is_hash">>, <<"FORMAT_ERROR">>},
        {<<"value_is_empty_hash">>, <<"FORMAT_ERROR">>},
        {<<"value_is_array">>, <<"FORMAT_ERROR">>},
        {<<"value_is_empty_array">>, <<"FORMAT_ERROR">>}
    ]}
].
