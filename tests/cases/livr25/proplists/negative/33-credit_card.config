%% LIVR negative/33-credit_card (case: credit_card, form: proplists)
%% Source: https://github.com/koorchik/LIVR/tree/44955f198e7cbd2d6ec2fb1926c9fe8bd2e5628d/test_suite_2.5/negative/33-credit_card
%% Imported for liver; iso_date outputs use Erlang {Y,M,D} dates.
%% Proplist fixtures preserve JSON key order from json:decode/3.

[
    {name, credit_card},
    {rules, [
        {<<"wrong_checksum">>, credit_card},
        {<<"eleven_digits">>, [credit_card]},
        {<<"twenty_digits">>, [
            {credit_card, []}
        ]},
        {<<"spaces">>, credit_card},
        {<<"dashes">>, credit_card},
        {<<"letter">>, credit_card},
        {<<"number">>, credit_card},
        {<<"trailing_newline">>, credit_card},
        {<<"leading_space">>, credit_card},
        {<<"arabic_indic_digits">>, credit_card},
        {<<"fullwidth_digit">>, credit_card},
        {<<"fraction_number">>, credit_card},
        {<<"boolean_true">>, credit_card},
        {<<"boolean_false">>, credit_card},
        {<<"empty_field">>, credit_card},
        {<<"null_field">>, credit_card},
        {<<"value_is_hash">>, credit_card},
        {<<"value_is_empty_hash">>, credit_card},
        {<<"value_is_array">>, credit_card},
        {<<"value_is_empty_array">>, credit_card}
    ]},
    {input, [
        {<<"wrong_checksum">>, <<"4111111111111112">>},
        {<<"eleven_digits">>, <<"40000000006">>},
        {<<"twenty_digits">>, <<"50000000000000000009">>},
        {<<"spaces">>, <<"4111 1111 1111 1111">>},
        {<<"dashes">>, <<"4111-1111-1111-1111">>},
        {<<"letter">>, <<"411111111111111a">>},
        {<<"number">>, 4111111111111112},
        {<<"trailing_newline">>, <<"4111111111111111\n">>},
        {<<"leading_space">>, <<" 4111111111111111">>},
        {<<"arabic_indic_digits">>, <<"٤١١١١١١١١١١١١١١١"/utf8>>},
        {<<"fullwidth_digit">>, <<"411111111111111１"/utf8>>},
        {<<"fraction_number">>, 4111111111111.5},
        {<<"boolean_true">>, true},
        {<<"boolean_false">>, false},
        {<<"empty_field">>, <<>>},
        {<<"null_field">>, null},
        {<<"extra_field">>, <<"extra">>},
        {<<"value_is_hash">>, [
            {<<"test">>, 1}
        ]},
        {<<"value_is_empty_hash">>, [{}]},
        {<<"value_is_array">>, [<<"test">>, 1]},
        {<<"value_is_empty_array">>, []}
    ]},
    {errors, [
        {<<"wrong_checksum">>, <<"WRONG_CREDIT_CARD_NUMBER">>},
        {<<"eleven_digits">>, <<"WRONG_CREDIT_CARD_NUMBER">>},
        {<<"twenty_digits">>, <<"WRONG_CREDIT_CARD_NUMBER">>},
        {<<"spaces">>, <<"WRONG_CREDIT_CARD_NUMBER">>},
        {<<"dashes">>, <<"WRONG_CREDIT_CARD_NUMBER">>},
        {<<"letter">>, <<"WRONG_CREDIT_CARD_NUMBER">>},
        {<<"number">>, <<"WRONG_CREDIT_CARD_NUMBER">>},
        {<<"trailing_newline">>, <<"WRONG_CREDIT_CARD_NUMBER">>},
        {<<"leading_space">>, <<"WRONG_CREDIT_CARD_NUMBER">>},
        {<<"arabic_indic_digits">>, <<"WRONG_CREDIT_CARD_NUMBER">>},
        {<<"fullwidth_digit">>, <<"WRONG_CREDIT_CARD_NUMBER">>},
        {<<"fraction_number">>, <<"WRONG_CREDIT_CARD_NUMBER">>},
        {<<"boolean_true">>, <<"WRONG_CREDIT_CARD_NUMBER">>},
        {<<"boolean_false">>, <<"WRONG_CREDIT_CARD_NUMBER">>},
        {<<"value_is_hash">>, <<"FORMAT_ERROR">>},
        {<<"value_is_empty_hash">>, <<"FORMAT_ERROR">>},
        {<<"value_is_array">>, <<"FORMAT_ERROR">>},
        {<<"value_is_empty_array">>, <<"FORMAT_ERROR">>}
    ]}
].
