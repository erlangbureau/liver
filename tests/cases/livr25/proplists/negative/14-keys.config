%% LIVR negative/14-keys (case: keys, form: proplists)
%% Source: https://github.com/koorchik/LIVR/tree/14e5a1b19011d3e9bf6ab5a6a0dd4444bea8b280/test_suite_2.5/negative/14-keys
%% Imported for liver; iso_date outputs use Erlang {Y,M,D} dates.
%% Proplist fixtures preserve JSON key order from json:decode/3.

[
    {name, keys},
    {rules, [
        {<<"translations">>, [
            [
                {keys, [
                    {one_of, [<<"uk">>, <<"en">>, <<"de">>]}
                ]}
            ],
            [
                {values, [
                    required,
                    string,
                    [
                        {max_length, 200}
                    ]
                ]}
            ]
        ]},
        {<<"keys_before_values">>, [
            [
                {keys, [
                    {one_of, [<<"uk">>, <<"en">>, <<"de">>]}
                ]}
            ],
            [
                {values, [
                    required,
                    string,
                    [
                        {max_length, 200}
                    ]
                ]}
            ]
        ]},
        {<<"values_after_keys">>, [
            [
                {keys, [
                    {one_of, [<<"uk">>, <<"en">>, <<"de">>]}
                ]}
            ],
            [
                {values, [
                    required,
                    string,
                    [
                        {max_length, 200}
                    ]
                ]}
            ]
        ]},
        {<<"like_keys">>, [
            [
                {keys, [
                    {like, <<"^[a-z_]+$">>}
                ]}
            ]
        ]},
        {<<"empty_key">>, [
            {keys, required}
        ]},
        {<<"value_is_array">>, [
            [
                {keys, [
                    {one_of, [<<"uk">>, <<"en">>, <<"de">>]}
                ]}
            ],
            [
                {values, [
                    required,
                    string,
                    [
                        {max_length, 200}
                    ]
                ]}
            ]
        ]},
        {<<"value_is_string">>, [
            [
                {keys, [
                    {one_of, [<<"uk">>, <<"en">>, <<"de">>]}
                ]}
            ],
            [
                {values, [
                    required,
                    string,
                    [
                        {max_length, 200}
                    ]
                ]}
            ]
        ]},
        {<<"value_is_number">>, [
            [
                {keys, [
                    {one_of, [<<"uk">>, <<"en">>, <<"de">>]}
                ]}
            ],
            [
                {values, [
                    required,
                    string,
                    [
                        {max_length, 200}
                    ]
                ]}
            ]
        ]},
        {<<"empty_field">>, [
            [
                {keys, [
                    {one_of, [<<"uk">>, <<"en">>, <<"de">>]}
                ]}
            ],
            [
                {values, [
                    required,
                    string,
                    [
                        {max_length, 200}
                    ]
                ]}
            ]
        ]},
        {<<"null_field">>, [
            [
                {keys, [
                    {one_of, [<<"uk">>, <<"en">>, <<"de">>]}
                ]}
            ],
            [
                {values, [
                    required,
                    string,
                    [
                        {max_length, 200}
                    ]
                ]}
            ]
        ]}
    ]},
    {input, [
        {<<"translations">>, [
            {<<"uk">>, <<"Привіт"/utf8>>},
            {<<"fr">>, <<"Bonjour">>}
        ]},
        {<<"keys_before_values">>, [
            {<<"fr">>, <<"Bonjour">>},
            {<<"en">>, <<>>}
        ]},
        {<<"values_after_keys">>, [
            {<<"uk">>, <<"Привіт"/utf8>>},
            {<<"en">>, <<>>}
        ]},
        {<<"like_keys">>, [
            {<<"firstName">>, 1},
            {<<"last_name">>, 2}
        ]},
        {<<"empty_key">>, [
            {<<>>, 1},
            {<<"a">>, 2}
        ]},
        {<<"value_is_array">>, [<<"uk">>]},
        {<<"value_is_string">>, <<"uk">>},
        {<<"value_is_number">>, 5},
        {<<"empty_field">>, <<>>},
        {<<"null_field">>, null},
        {<<"extra_field">>, <<"extra">>}
    ]},
    {errors, [
        {<<"translations">>, [
            {<<"fr">>, <<"WRONG_KEY">>}
        ]},
        {<<"keys_before_values">>, [
            {<<"fr">>, <<"WRONG_KEY">>}
        ]},
        {<<"values_after_keys">>, [
            {<<"en">>, <<"REQUIRED">>}
        ]},
        {<<"like_keys">>, [
            {<<"firstName">>, <<"WRONG_KEY">>}
        ]},
        {<<"empty_key">>, [
            {<<>>, <<"WRONG_KEY">>}
        ]},
        {<<"value_is_array">>, <<"FORMAT_ERROR">>},
        {<<"value_is_string">>, <<"FORMAT_ERROR">>},
        {<<"value_is_number">>, <<"FORMAT_ERROR">>}
    ]}
].
