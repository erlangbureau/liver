%% LIVR negative/07-contains (case: contains, form: proplists)
%% Source: https://github.com/koorchik/LIVR/tree/14e5a1b19011d3e9bf6ab5a6a0dd4444bea8b280/test_suite_2.5/negative/07-contains
%% Imported for liver; iso_date outputs use Erlang {Y,M,D} dates.
%% Proplist fixtures preserve JSON key order from json:decode/3.

[
    {name, contains},
    {rules, [
        {<<"missing_at">>, [
            {contains, <<"@">>}
        ]},
        {<<"none_of_several">>, [
            [
                {contains, [<<"foo">>, <<"bar">>]}
            ]
        ]},
        {<<"case_sensitive">>, [
            {contains, [<<"foo">>, <<"bar">>]}
        ]},
        {<<"number">>, [
            {contains, <<".">>}
        ]},
        {<<"boolean">>, [
            {contains, <<"ru">>}
        ]},
        {<<"exponent">>, [
            {contains, <<"e">>}
        ]},
        {<<"minus_zero">>, [
            {contains, <<"-">>}
        ]},
        {<<"one_point_zero">>, [
            {contains, <<".">>}
        ]},
        {<<"empty_field">>, [
            {contains, <<"@">>}
        ]},
        {<<"null_field">>, [
            {contains, <<"@">>}
        ]},
        {<<"value_is_hash">>, [
            {contains, <<"@">>}
        ]},
        {<<"value_is_empty_hash">>, [
            {contains, <<"@">>}
        ]},
        {<<"value_is_array">>, [
            {contains, <<"@">>}
        ]},
        {<<"value_is_empty_array">>, [
            {contains, <<"@">>}
        ]}
    ]},
    {input, [
        {<<"missing_at">>, <<"user.example.com">>},
        {<<"none_of_several">>, <<"baz">>},
        {<<"case_sensitive">>, <<"FOO">>},
        {<<"number">>, 2.0},
        {<<"boolean">>, false},
        {<<"exponent">>, 1.0e3},
        {<<"minus_zero">>, -0.0},
        {<<"one_point_zero">>, 1.0},
        {<<"empty_field">>, <<>>},
        {<<"null_field">>, null},
        {<<"extra_field">>, <<"extra">>},
        {<<"value_is_hash">>, [
            {<<"test">>, 1}
        ]},
        {<<"value_is_empty_hash">>, [{}]},
        {<<"value_is_array">>, [<<"test">>, 1]},
        {<<"value_is_empty_array">>, []}
    ]},
    {errors, [
        {<<"missing_at">>, <<"WRONG_FORMAT">>},
        {<<"none_of_several">>, <<"WRONG_FORMAT">>},
        {<<"case_sensitive">>, <<"WRONG_FORMAT">>},
        {<<"number">>, <<"WRONG_FORMAT">>},
        {<<"boolean">>, <<"WRONG_FORMAT">>},
        {<<"exponent">>, <<"WRONG_FORMAT">>},
        {<<"minus_zero">>, <<"WRONG_FORMAT">>},
        {<<"one_point_zero">>, <<"WRONG_FORMAT">>},
        {<<"value_is_hash">>, <<"FORMAT_ERROR">>},
        {<<"value_is_empty_hash">>, <<"FORMAT_ERROR">>},
        {<<"value_is_array">>, <<"FORMAT_ERROR">>},
        {<<"value_is_empty_array">>, <<"FORMAT_ERROR">>}
    ]}
].
