%% LIVR negative/15-any (case: any, form: proplists)
%% Source: https://github.com/koorchik/LIVR/tree/14e5a1b19011d3e9bf6ab5a6a0dd4444bea8b280/test_suite_2.5/negative/15-any
%% Imported for liver; iso_date outputs use Erlang {Y,M,D} dates.
%% Proplist fixtures preserve JSON key order from json:decode/3.

[
    {name, any},
    {rules, [
        {<<"metadata">>, any},
        {<<"required_missing">>, [required, any]},
        {<<"required_null">>, [required, any]},
        {<<"required_empty">>, [required, any]},
        {<<"empty_kept_for_next_rule">>, [any, required]},
        {<<"null_kept_for_next_rule">>, [any, required]},
        {<<"object_to_nested_object">>, [
            any,
            [
                {nested_object, [
                    {<<"a">>, required}
                ]}
            ]
        ]},
        {<<"list_to_list_of">>, [
            any,
            [
                {list_of, positive_integer}
            ]
        ]},
        {<<"object_to_string">>, [any, string]}
    ]},
    {input, [
        {<<"metadata">>, [
            {<<"a">>, [
                {<<"b">>, [1]}
            ]}
        ]},
        {<<"required_null">>, null},
        {<<"required_empty">>, <<>>},
        {<<"empty_kept_for_next_rule">>, <<>>},
        {<<"null_kept_for_next_rule">>, null},
        {<<"object_to_nested_object">>, [
            {<<"b">>, 1}
        ]},
        {<<"list_to_list_of">>, [1, <<"x">>]},
        {<<"object_to_string">>, [
            {<<"a">>, 1}
        ]},
        {<<"extra_field">>, <<"extra">>}
    ]},
    {errors, [
        {<<"required_missing">>, <<"REQUIRED">>},
        {<<"required_null">>, <<"REQUIRED">>},
        {<<"required_empty">>, <<"REQUIRED">>},
        {<<"empty_kept_for_next_rule">>, <<"REQUIRED">>},
        {<<"null_kept_for_next_rule">>, <<"REQUIRED">>},
        {<<"object_to_nested_object">>, [
            {<<"a">>, <<"REQUIRED">>}
        ]},
        {<<"list_to_list_of">>, [null, <<"NOT_POSITIVE_INTEGER">>]},
        {<<"object_to_string">>, <<"FORMAT_ERROR">>}
    ]}
].
