%% LIVR negative/06-ends_with (case: ends_with, form: proplists)
%% Source: https://github.com/koorchik/LIVR/tree/44955f198e7cbd2d6ec2fb1926c9fe8bd2e5628d/test_suite_2.5/negative/06-ends_with
%% Imported for liver; iso_date outputs use Erlang {Y,M,D} dates.
%% Proplist fixtures preserve JSON key order from json:decode/3.

[
    {name, ends_with},
    {rules, [
        {<<"other_extension">>, [
            {ends_with, <<".pdf">>}
        ]},
        {<<"uppercase">>, [
            [
                {ends_with, <<".pdf">>}
            ]
        ]},
        {<<"trailing_space">>, [
            {ends_with, <<".pdf">>}
        ]},
        {<<"suffix_in_the_middle">>, [
            {ends_with, <<".pdf">>}
        ]},
        {<<"image">>, [
            {ends_with, [<<".jpg">>, <<".png">>]}
        ]},
        {<<"number_string_form">>, [
            {ends_with, <<"0">>}
        ]},
        {<<"boolean">>, [
            {ends_with, <<"se">>}
        ]},
        {<<"one_point_zero">>, [
            {ends_with, <<".0">>}
        ]},
        {<<"exponent">>, [
            {ends_with, <<"e3">>}
        ]},
        {<<"trailing_newline">>, [
            {ends_with, <<".pdf">>}
        ]},
        {<<"empty_field">>, [
            {ends_with, <<".pdf">>}
        ]},
        {<<"null_field">>, [
            {ends_with, <<".pdf">>}
        ]},
        {<<"value_is_hash">>, [
            {ends_with, <<".pdf">>}
        ]},
        {<<"value_is_empty_hash">>, [
            {ends_with, <<".pdf">>}
        ]},
        {<<"value_is_array">>, [
            {ends_with, <<".pdf">>}
        ]},
        {<<"value_is_empty_array">>, [
            {ends_with, <<".pdf">>}
        ]}
    ]},
    {input, [
        {<<"other_extension">>, <<"report.doc">>},
        {<<"uppercase">>, <<"report.PDF">>},
        {<<"trailing_space">>, <<"report.pdf ">>},
        {<<"suffix_in_the_middle">>, <<"report.pdf.exe">>},
        {<<"image">>, <<"photo.gif">>},
        {<<"number_string_form">>, 1.5},
        {<<"boolean">>, true},
        {<<"one_point_zero">>, 1.0},
        {<<"exponent">>, 1.0e3},
        {<<"trailing_newline">>, <<"report.pdf\n">>},
        {<<"empty_field">>, <<>>},
        {<<"null_field">>, null},
        {<<"extra_field">>, <<"extra">>},
        {<<"value_is_hash">>, [
            {<<"test">>, 1}
        ]},
        {<<"value_is_empty_hash">>, [{}]},
        {<<"value_is_array">>, [<<"test">>, 1]},
        {<<"value_is_empty_array">>, []}
    ]},
    {errors, [
        {<<"other_extension">>, <<"WRONG_FORMAT">>},
        {<<"uppercase">>, <<"WRONG_FORMAT">>},
        {<<"trailing_space">>, <<"WRONG_FORMAT">>},
        {<<"suffix_in_the_middle">>, <<"WRONG_FORMAT">>},
        {<<"image">>, <<"WRONG_FORMAT">>},
        {<<"number_string_form">>, <<"WRONG_FORMAT">>},
        {<<"boolean">>, <<"WRONG_FORMAT">>},
        {<<"one_point_zero">>, <<"WRONG_FORMAT">>},
        {<<"exponent">>, <<"WRONG_FORMAT">>},
        {<<"trailing_newline">>, <<"WRONG_FORMAT">>},
        {<<"value_is_hash">>, <<"FORMAT_ERROR">>},
        {<<"value_is_empty_hash">>, <<"FORMAT_ERROR">>},
        {<<"value_is_array">>, <<"FORMAT_ERROR">>},
        {<<"value_is_empty_array">>, <<"FORMAT_ERROR">>}
    ]}
].
