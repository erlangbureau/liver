%% LIVR negative/32-luhn (case: luhn, form: proplists)
%% Source: https://github.com/koorchik/LIVR/tree/44955f198e7cbd2d6ec2fb1926c9fe8bd2e5628d/test_suite_2.5/negative/32-luhn
%% Imported for liver; iso_date outputs use Erlang {Y,M,D} dates.
%% Proplist fixtures preserve JSON key order from json:decode/3.

[
    {name, luhn},
    {rules, [
        {<<"wrong_checksum">>, luhn},
        {<<"one_digit">>, [luhn]},
        {<<"spaces">>, [
            {luhn, []}
        ]},
        {<<"dashes">>, luhn},
        {<<"letter">>, luhn},
        {<<"leading_space">>, luhn},
        {<<"non_ascii_digits">>, luhn},
        {<<"negative_number">>, luhn},
        {<<"number">>, luhn},
        {<<"trailing_newline">>, luhn},
        {<<"fullwidth_digits">>, luhn},
        {<<"arabic_indic_digit_mixed">>, luhn},
        {<<"fraction_number">>, luhn},
        {<<"minus_zero_number">>, luhn},
        {<<"boolean_true">>, luhn},
        {<<"boolean_false">>, luhn},
        {<<"empty_field">>, luhn},
        {<<"null_field">>, luhn},
        {<<"value_is_hash">>, luhn},
        {<<"value_is_empty_hash">>, luhn},
        {<<"value_is_array">>, luhn},
        {<<"value_is_empty_array">>, luhn}
    ]},
    {input, [
        {<<"wrong_checksum">>, <<"79927398710">>},
        {<<"one_digit">>, <<"0">>},
        {<<"spaces">>, <<"7992 7398 713">>},
        {<<"dashes">>, <<"7992-7398-713">>},
        {<<"letter">>, <<"7992739871a">>},
        {<<"leading_space">>, <<" 18">>},
        {<<"non_ascii_digits">>, <<"١٨"/utf8>>},
        {<<"negative_number">>, -18},
        {<<"number">>, 79927398710},
        {<<"trailing_newline">>, <<"79927398713\n">>},
        {<<"fullwidth_digits">>, <<"１８"/utf8>>},
        {<<"arabic_indic_digit_mixed">>, <<"7992739871٣"/utf8>>},
        {<<"fraction_number">>, 1.8},
        {<<"minus_zero_number">>, -0.0},
        {<<"boolean_true">>, true},
        {<<"boolean_false">>, false},
        {<<"empty_field">>, <<>>},
        {<<"null_field">>, null},
        {<<"extra_field">>, <<"extra">>},
        {<<"value_is_hash">>, [
            {<<"test">>, 1}
        ]},
        {<<"value_is_empty_hash">>, [{}]},
        {<<"value_is_array">>, [<<"test">>, 1]},
        {<<"value_is_empty_array">>, []}
    ]},
    {errors, [
        {<<"wrong_checksum">>, <<"WRONG_CHECKSUM">>},
        {<<"one_digit">>, <<"WRONG_CHECKSUM">>},
        {<<"spaces">>, <<"WRONG_CHECKSUM">>},
        {<<"dashes">>, <<"WRONG_CHECKSUM">>},
        {<<"letter">>, <<"WRONG_CHECKSUM">>},
        {<<"leading_space">>, <<"WRONG_CHECKSUM">>},
        {<<"non_ascii_digits">>, <<"WRONG_CHECKSUM">>},
        {<<"negative_number">>, <<"WRONG_CHECKSUM">>},
        {<<"number">>, <<"WRONG_CHECKSUM">>},
        {<<"trailing_newline">>, <<"WRONG_CHECKSUM">>},
        {<<"fullwidth_digits">>, <<"WRONG_CHECKSUM">>},
        {<<"arabic_indic_digit_mixed">>, <<"WRONG_CHECKSUM">>},
        {<<"fraction_number">>, <<"WRONG_CHECKSUM">>},
        {<<"minus_zero_number">>, <<"WRONG_CHECKSUM">>},
        {<<"boolean_true">>, <<"WRONG_CHECKSUM">>},
        {<<"boolean_false">>, <<"WRONG_CHECKSUM">>},
        {<<"value_is_hash">>, <<"FORMAT_ERROR">>},
        {<<"value_is_empty_hash">>, <<"FORMAT_ERROR">>},
        {<<"value_is_array">>, <<"FORMAT_ERROR">>},
        {<<"value_is_empty_array">>, <<"FORMAT_ERROR">>}
    ]}
].
