%% LIVR negative/18-split (case: split, form: proplists)
%% Source: https://github.com/koorchik/LIVR/tree/14e5a1b19011d3e9bf6ab5a6a0dd4444bea8b280/test_suite_2.5/negative/18-split
%% Imported for liver; iso_date outputs use Erlang {Y,M,D} dates.
%% Proplist fixtures preserve JSON key order from json:decode/3.

[
    {name, split},
    {rules, [
        {<<"ids">>, [
            [
                {split, <<",">>}
            ],
            [
                {list_of, positive_integer}
            ]
        ]},
        {<<"ids_wrong_item">>, [
            [
                {split, <<",">>}
            ],
            [
                {list_of, positive_integer}
            ]
        ]},
        {<<"ids_empty_part">>, [
            [
                {split, <<",">>}
            ],
            [
                {list_of, [required, positive_integer]}
            ]
        ]},
        {<<"ids_trailing_separator">>, [
            [
                {split, <<",">>}
            ],
            [
                {list_of, [required, positive_integer]}
            ]
        ]},
        {<<"ids_list_kept">>, [
            [
                {split, <<",">>}
            ],
            [
                {list_of, positive_integer}
            ]
        ]},
        {<<"ids_list_not_split">>, [
            [
                {split, <<",">>}
            ],
            [
                {list_of, positive_integer}
            ]
        ]},
        {<<"number_one_item">>, [
            [
                {split, <<",">>}
            ],
            [
                {list_of, [
                    {min_number, 10}
                ]}
            ]
        ]},
        {<<"object_kept">>, [
            [
                {split, <<",">>}
            ],
            [
                {list_of, string}
            ]
        ]},
        {<<"empty_kept">>, [
            [
                {split, <<",">>}
            ],
            required
        ]},
        {<<"null_kept">>, [
            [
                {split, <<",">>}
            ],
            required
        ]},
        {<<"missing_kept">>, [
            [
                {split, <<",">>}
            ],
            required
        ]},
        {<<"too_few_parts">>, [
            [
                {split, <<",">>}
            ],
            [
                {list_length, 3}
            ]
        ]},
        {<<"multi_char_separator">>, [
            [
                {split, <<", ">>}
            ],
            [
                {list_length, 3}
            ]
        ]},
        {<<"regexp_char_separator">>, [
            [
                {split, <<".">>}
            ],
            [
                {list_length, 3}
            ]
        ]}
    ]},
    {input, [
        {<<"ids">>, <<"1,2">>},
        {<<"ids_wrong_item">>, <<"1,x,3">>},
        {<<"ids_empty_part">>, <<"1,,2">>},
        {<<"ids_trailing_separator">>, <<"1,2,">>},
        {<<"ids_list_kept">>, [<<"1">>, <<"x">>]},
        {<<"ids_list_not_split">>, [<<"1,2">>]},
        {<<"number_one_item">>, 5},
        {<<"object_kept">>, [
            {<<"a">>, <<"1,2">>}
        ]},
        {<<"empty_kept">>, <<>>},
        {<<"null_kept">>, null},
        {<<"too_few_parts">>, <<"a,b">>},
        {<<"multi_char_separator">>, <<"a, b,c">>},
        {<<"regexp_char_separator">>, <<"abc">>},
        {<<"extra_field">>, <<"extra">>}
    ]},
    {errors, [
        {<<"ids_wrong_item">>, [null, <<"NOT_POSITIVE_INTEGER">>, null]},
        {<<"ids_empty_part">>, [null, <<"REQUIRED">>, null]},
        {<<"ids_trailing_separator">>, [null, null, <<"REQUIRED">>]},
        {<<"ids_list_kept">>, [null, <<"NOT_POSITIVE_INTEGER">>]},
        {<<"ids_list_not_split">>, [<<"NOT_POSITIVE_INTEGER">>]},
        {<<"number_one_item">>, [<<"TOO_LOW">>]},
        {<<"object_kept">>, <<"FORMAT_ERROR">>},
        {<<"empty_kept">>, <<"REQUIRED">>},
        {<<"null_kept">>, <<"REQUIRED">>},
        {<<"missing_kept">>, <<"REQUIRED">>},
        {<<"too_few_parts">>, <<"TOO_FEW_ITEMS">>},
        {<<"multi_char_separator">>, <<"TOO_FEW_ITEMS">>},
        {<<"regexp_char_separator">>, <<"TOO_FEW_ITEMS">>}
    ]}
].
