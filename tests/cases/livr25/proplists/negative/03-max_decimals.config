%% LIVR negative/03-max_decimals (case: max_decimals, form: proplists)
%% Source: https://github.com/koorchik/LIVR/tree/14e5a1b19011d3e9bf6ab5a6a0dd4444bea8b280/test_suite_2.5/negative/03-max_decimals
%% Imported for liver; iso_date outputs use Erlang {Y,M,D} dates.
%% Proplist fixtures preserve JSON key order from json:decode/3.

[
    {name, max_decimals},
    {rules, [
        {<<"too_many">>, [
            {max_decimals, 2}
        ]},
        {<<"too_many_string">>, [
            [
                {max_decimals, 2}
            ]
        ]},
        {<<"string_trailing_zero_still_too_many">>, [
            {max_decimals, 2}
        ]},
        {<<"long_string_decimals">>, [
            {max_decimals, 19}
        ]},
        {<<"zero_decimals_fraction">>, [
            {max_decimals, 0}
        ]},
        {<<"negative">>, [
            {max_decimals, 1}
        ]},
        {<<"comma_decimal">>, [
            {max_decimals, 2}
        ]},
        {<<"not_a_number">>, [
            {max_decimals, 2}
        ]},
        {<<"trailing_dot">>, [
            {max_decimals, 2}
        ]},
        {<<"exponent_string">>, [
            {max_decimals, 2}
        ]},
        {<<"boolean">>, [
            {max_decimals, 2}
        ]},
        {<<"fraction_number">>, [
            {max_decimals, 0}
        ]},
        {<<"negative_two_decimals">>, [
            {max_decimals, 1}
        ]},
        {<<"small_exponent">>, [
            {max_decimals, 2}
        ]},
        {<<"trailing_newline">>, [
            {max_decimals, 2}
        ]},
        {<<"non_ascii_digits">>, [
            {max_decimals, 2}
        ]},
        {<<"too_large_for_double">>, [
            {max_decimals, 2}
        ]},
        {<<"string_argument">>, [
            {max_decimals, <<"2">>}
        ]},
        {<<"empty_field">>, [
            {max_decimals, 2}
        ]},
        {<<"null_field">>, [
            {max_decimals, 2}
        ]},
        {<<"value_is_hash">>, [
            {max_decimals, 2}
        ]},
        {<<"value_is_empty_hash">>, [
            {max_decimals, 2}
        ]},
        {<<"value_is_array">>, [
            {max_decimals, 2}
        ]},
        {<<"value_is_empty_array">>, [
            {max_decimals, 2}
        ]}
    ]},
    {input, [
        {<<"too_many">>, 1.234},
        {<<"too_many_string">>, <<"1.234">>},
        {<<"string_trailing_zero_still_too_many">>, <<"1.2340">>},
        {<<"long_string_decimals">>, <<"0.10000000000000000001">>},
        {<<"zero_decimals_fraction">>, 0.5},
        {<<"negative">>, <<"-1.25">>},
        {<<"comma_decimal">>, <<"1,5">>},
        {<<"not_a_number">>, <<"abc">>},
        {<<"trailing_dot">>, <<"1.">>},
        {<<"exponent_string">>, <<"1e-3">>},
        {<<"boolean">>, true},
        {<<"fraction_number">>, 0.1},
        {<<"negative_two_decimals">>, -12.25},
        {<<"small_exponent">>, 0.001},
        {<<"trailing_newline">>, <<"1.5\n">>},
        {<<"non_ascii_digits">>, <<"١.٥"/utf8>>},
        {<<"too_large_for_double">>, <<"">>},
        {<<"string_argument">>, 1.234},
        {<<"empty_field">>, <<>>},
        {<<"null_field">>, null},
        {<<"extra_field">>, <<"extra">>},
        {<<"value_is_hash">>, [
            {<<"test">>, 1}
        ]},
        {<<"value_is_empty_hash">>, [{}]},
        {<<"value_is_array">>, [<<"test">>, 1]},
        {<<"value_is_empty_array">>, []}
    ]},
    {errors, [
        {<<"too_many">>, <<"TOO_MANY_DECIMALS">>},
        {<<"too_many_string">>, <<"TOO_MANY_DECIMALS">>},
        {<<"string_trailing_zero_still_too_many">>, <<"TOO_MANY_DECIMALS">>},
        {<<"long_string_decimals">>, <<"TOO_MANY_DECIMALS">>},
        {<<"zero_decimals_fraction">>, <<"TOO_MANY_DECIMALS">>},
        {<<"negative">>, <<"TOO_MANY_DECIMALS">>},
        {<<"comma_decimal">>, <<"NOT_NUMBER">>},
        {<<"not_a_number">>, <<"NOT_NUMBER">>},
        {<<"trailing_dot">>, <<"NOT_NUMBER">>},
        {<<"exponent_string">>, <<"NOT_NUMBER">>},
        {<<"boolean">>, <<"NOT_NUMBER">>},
        {<<"fraction_number">>, <<"TOO_MANY_DECIMALS">>},
        {<<"negative_two_decimals">>, <<"TOO_MANY_DECIMALS">>},
        {<<"small_exponent">>, <<"TOO_MANY_DECIMALS">>},
        {<<"trailing_newline">>, <<"NOT_NUMBER">>},
        {<<"non_ascii_digits">>, <<"NOT_NUMBER">>},
        {<<"too_large_for_double">>, <<"NOT_NUMBER">>},
        {<<"string_argument">>, <<"TOO_MANY_DECIMALS">>},
        {<<"value_is_hash">>, <<"FORMAT_ERROR">>},
        {<<"value_is_empty_hash">>, <<"FORMAT_ERROR">>},
        {<<"value_is_array">>, <<"FORMAT_ERROR">>},
        {<<"value_is_empty_array">>, <<"FORMAT_ERROR">>}
    ]}
].
