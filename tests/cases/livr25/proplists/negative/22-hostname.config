%% LIVR negative/22-hostname (case: hostname, form: proplists)
%% Source: https://github.com/koorchik/LIVR/tree/14e5a1b19011d3e9bf6ab5a6a0dd4444bea8b280/test_suite_2.5/negative/22-hostname
%% Imported for liver; iso_date outputs use Erlang {Y,M,D} dates.
%% Proplist fixtures preserve JSON key order from json:decode/3.

[
    {name, hostname},
    {rules, [
        {<<"leading_hyphen">>, hostname},
        {<<"trailing_hyphen">>, [hostname]},
        {<<"tld_trailing_hyphen">>, hostname},
        {<<"underscore">>, [
            {hostname, []}
        ]},
        {<<"trailing_dot">>, hostname},
        {<<"leading_dot">>, hostname},
        {<<"empty_label">>, hostname},
        {<<"only_dot">>, hostname},
        {<<"label_64">>, hostname},
        {<<"total_254">>, hostname},
        {<<"space">>, hostname},
        {<<"unicode">>, hostname},
        {<<"port">>, hostname},
        {<<"url">>, hostname},
        {<<"wildcard">>, hostname},
        {<<"trailing_newline">>, hostname},
        {<<"negative_number">>, hostname},
        {<<"negative_fraction_number">>, hostname},
        {<<"ipv4">>, hostname},
        {<<"all_digit_single_label">>, hostname},
        {<<"all_digit_last_label">>, hostname},
        {<<"number">>, hostname},
        {<<"exponent_number">>, hostname},
        {<<"fraction_number">>, hostname},
        {<<"one_point_zero_number">>, hostname},
        {<<"big_integer">>, hostname},
        {<<"boolean_true">>, hostname},
        {<<"boolean_false">>, [hostname]},
        {<<"arabic_indic_digits">>, hostname},
        {<<"fullwidth_letters">>, hostname},
        {<<"leading_newline">>, hostname},
        {<<"trailing_crlf">>, hostname},
        {<<"empty_field">>, hostname},
        {<<"null_field">>, hostname},
        {<<"value_is_hash">>, hostname},
        {<<"value_is_empty_hash">>, hostname},
        {<<"value_is_array">>, hostname},
        {<<"value_is_empty_array">>, hostname}
    ]},
    {input, [
        {<<"leading_hyphen">>, <<"-example.com">>},
        {<<"trailing_hyphen">>, <<"example-.com">>},
        {<<"tld_trailing_hyphen">>, <<"example.com-">>},
        {<<"underscore">>, <<"exa_mple.com">>},
        {<<"trailing_dot">>, <<"example.com.">>},
        {<<"leading_dot">>, <<".example.com">>},
        {<<"empty_label">>, <<"example..com">>},
        {<<"only_dot">>, <<".">>},
        {<<"label_64">>, <<"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.com">>},
        {<<"total_254">>, <<"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb.ccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc.dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd">>},
        {<<"space">>, <<"exa mple.com">>},
        {<<"unicode">>, <<"приклад.com"/utf8>>},
        {<<"port">>, <<"example.com:80">>},
        {<<"url">>, <<"http://example.com">>},
        {<<"wildcard">>, <<"*.example.com">>},
        {<<"trailing_newline">>, <<"example.com\n">>},
        {<<"negative_number">>, -1},
        {<<"negative_fraction_number">>, -12.25},
        {<<"ipv4">>, <<"192.0.2.1">>},
        {<<"all_digit_single_label">>, <<"123">>},
        {<<"all_digit_last_label">>, <<"a.123">>},
        {<<"number">>, 123},
        {<<"exponent_number">>, 1.0e3},
        {<<"fraction_number">>, 0.1},
        {<<"one_point_zero_number">>, 1.0},
        {<<"big_integer">>, 123456789012345},
        {<<"boolean_true">>, true},
        {<<"boolean_false">>, false},
        {<<"arabic_indic_digits">>, <<"١٢٣.example"/utf8>>},
        {<<"fullwidth_letters">>, <<"ｅxample.com"/utf8>>},
        {<<"leading_newline">>, <<"\nexample.com">>},
        {<<"trailing_crlf">>, <<"example.com\r\n">>},
        {<<"empty_field">>, <<>>},
        {<<"null_field">>, null},
        {<<"extra_field">>, <<"extra">>},
        {<<"value_is_hash">>, [
            {<<"test">>, 1}
        ]},
        {<<"value_is_empty_hash">>, [{}]},
        {<<"value_is_array">>, [<<"test">>, 1]},
        {<<"value_is_empty_array">>, []}
    ]},
    {errors, [
        {<<"leading_hyphen">>, <<"WRONG_HOSTNAME">>},
        {<<"trailing_hyphen">>, <<"WRONG_HOSTNAME">>},
        {<<"tld_trailing_hyphen">>, <<"WRONG_HOSTNAME">>},
        {<<"underscore">>, <<"WRONG_HOSTNAME">>},
        {<<"trailing_dot">>, <<"WRONG_HOSTNAME">>},
        {<<"leading_dot">>, <<"WRONG_HOSTNAME">>},
        {<<"empty_label">>, <<"WRONG_HOSTNAME">>},
        {<<"only_dot">>, <<"WRONG_HOSTNAME">>},
        {<<"label_64">>, <<"WRONG_HOSTNAME">>},
        {<<"total_254">>, <<"WRONG_HOSTNAME">>},
        {<<"space">>, <<"WRONG_HOSTNAME">>},
        {<<"unicode">>, <<"WRONG_HOSTNAME">>},
        {<<"port">>, <<"WRONG_HOSTNAME">>},
        {<<"url">>, <<"WRONG_HOSTNAME">>},
        {<<"wildcard">>, <<"WRONG_HOSTNAME">>},
        {<<"trailing_newline">>, <<"WRONG_HOSTNAME">>},
        {<<"negative_number">>, <<"WRONG_HOSTNAME">>},
        {<<"negative_fraction_number">>, <<"WRONG_HOSTNAME">>},
        {<<"ipv4">>, <<"WRONG_HOSTNAME">>},
        {<<"all_digit_single_label">>, <<"WRONG_HOSTNAME">>},
        {<<"all_digit_last_label">>, <<"WRONG_HOSTNAME">>},
        {<<"number">>, <<"WRONG_HOSTNAME">>},
        {<<"exponent_number">>, <<"WRONG_HOSTNAME">>},
        {<<"fraction_number">>, <<"WRONG_HOSTNAME">>},
        {<<"one_point_zero_number">>, <<"WRONG_HOSTNAME">>},
        {<<"big_integer">>, <<"WRONG_HOSTNAME">>},
        {<<"boolean_true">>, <<"WRONG_HOSTNAME">>},
        {<<"boolean_false">>, <<"WRONG_HOSTNAME">>},
        {<<"arabic_indic_digits">>, <<"WRONG_HOSTNAME">>},
        {<<"fullwidth_letters">>, <<"WRONG_HOSTNAME">>},
        {<<"leading_newline">>, <<"WRONG_HOSTNAME">>},
        {<<"trailing_crlf">>, <<"WRONG_HOSTNAME">>},
        {<<"value_is_hash">>, <<"FORMAT_ERROR">>},
        {<<"value_is_empty_hash">>, <<"FORMAT_ERROR">>},
        {<<"value_is_array">>, <<"FORMAT_ERROR">>},
        {<<"value_is_empty_array">>, <<"FORMAT_ERROR">>}
    ]}
].
