%% LIVR negative/28-mac (case: mac, form: proplists)
%% Source: https://github.com/koorchik/LIVR/tree/44955f198e7cbd2d6ec2fb1926c9fe8bd2e5628d/test_suite_2.5/negative/28-mac
%% Imported for liver; iso_date outputs use Erlang {Y,M,D} dates.
%% Proplist fixtures preserve JSON key order from json:decode/3.

[
    {name, mac},
    {rules, [
        {<<"mixed_separators">>, mac},
        {<<"mixed_separators_last">>, [mac]},
        {<<"dots">>, [
            {mac, []}
        ]},
        {<<"without_separators">>, mac},
        {<<"five_pairs">>, mac},
        {<<"seven_pairs">>, mac},
        {<<"single_digit">>, mac},
        {<<"three_digits">>, mac},
        {<<"not_hex">>, mac},
        {<<"trailing_separator">>, mac},
        {<<"space_separator">>, mac},
        {<<"number">>, mac},
        {<<"trailing_newline">>, mac},
        {<<"eui64_trailing_newline">>, [
            {mac, 64}
        ]},
        {<<"arabic_indic_digit">>, mac},
        {<<"fullwidth_letter">>, mac},
        {<<"big_integer">>, mac},
        {<<"empty_field">>, mac},
        {<<"null_field">>, mac},
        {<<"value_is_hash">>, mac},
        {<<"value_is_empty_hash">>, mac},
        {<<"value_is_array">>, mac},
        {<<"value_is_empty_array">>, mac},
        {<<"mac48_given_eui64">>, mac},
        {<<"eui64_given_mac48">>, [
            {mac, 64}
        ]},
        {<<"eui64_seven_pairs">>, [
            {mac, 64}
        ]},
        {<<"eui64_nine_pairs">>, [
            {mac, 64}
        ]},
        {<<"eui64_mixed_separators">>, [
            {mac, 64}
        ]},
        {<<"eui64_without_separators">>, [
            {mac, 64}
        ]},
        {<<"eui64_value_is_array">>, [
            {mac, 64}
        ]},
        {<<"boolean_true">>, mac},
        {<<"eui64_boolean_false">>, [
            {mac, 64}
        ]},
        {<<"string_argument">>, [
            {mac, <<"64">>}
        ]}
    ]},
    {input, [
        {<<"mixed_separators">>, <<"00:1a-2b:3c:4d:5e">>},
        {<<"mixed_separators_last">>, <<"00:1a:2b:3c:4d-5e">>},
        {<<"dots">>, <<"001a.2b3c.4d5e">>},
        {<<"without_separators">>, <<"001a2b3c4d5e">>},
        {<<"five_pairs">>, <<"00:1a:2b:3c:4d">>},
        {<<"seven_pairs">>, <<"00:1a:2b:3c:4d:5e:6f">>},
        {<<"single_digit">>, <<"0:1a:2b:3c:4d:5e">>},
        {<<"three_digits">>, <<"000:1a:2b:3c:4d:5e">>},
        {<<"not_hex">>, <<"00:1a:2b:3c:4d:5g">>},
        {<<"trailing_separator">>, <<"00:1a:2b:3c:4d:5e:">>},
        {<<"space_separator">>, <<"00 1a 2b 3c 4d 5e">>},
        {<<"number">>, 1},
        {<<"trailing_newline">>, <<"00:1a:2b:3c:4d:5e\n">>},
        {<<"eui64_trailing_newline">>, <<"00:1a:2b:3c:4d:5e:6f:70\n">>},
        {<<"arabic_indic_digit">>, <<"00:1a:2b:3c:4d:5١"/utf8>>},
        {<<"fullwidth_letter">>, <<"00:1a:2b:3c:4d:5ｅ"/utf8>>},
        {<<"big_integer">>, 123456789012345},
        {<<"empty_field">>, <<>>},
        {<<"null_field">>, null},
        {<<"extra_field">>, <<"extra">>},
        {<<"value_is_hash">>, [
            {<<"test">>, 1}
        ]},
        {<<"value_is_empty_hash">>, [{}]},
        {<<"value_is_array">>, [<<"test">>, 1]},
        {<<"value_is_empty_array">>, []},
        {<<"mac48_given_eui64">>, <<"00:1a:2b:3c:4d:5e:6f:70">>},
        {<<"eui64_given_mac48">>, <<"00:1a:2b:3c:4d:5e">>},
        {<<"eui64_seven_pairs">>, <<"00:1a:2b:3c:4d:5e:6f">>},
        {<<"eui64_nine_pairs">>, <<"00:1a:2b:3c:4d:5e:6f:70:81">>},
        {<<"eui64_mixed_separators">>, <<"00:1a:2b:3c-4d:5e:6f:70">>},
        {<<"eui64_without_separators">>, <<"001a2b3c4d5e6f70">>},
        {<<"eui64_value_is_array">>, [<<"00:1a:2b:3c:4d:5e:6f:70">>]},
        {<<"boolean_true">>, true},
        {<<"eui64_boolean_false">>, false},
        {<<"string_argument">>, <<"00:1a:2b:3c:4d:5e">>}
    ]},
    {errors, [
        {<<"mixed_separators">>, <<"WRONG_MAC">>},
        {<<"mixed_separators_last">>, <<"WRONG_MAC">>},
        {<<"dots">>, <<"WRONG_MAC">>},
        {<<"without_separators">>, <<"WRONG_MAC">>},
        {<<"five_pairs">>, <<"WRONG_MAC">>},
        {<<"seven_pairs">>, <<"WRONG_MAC">>},
        {<<"single_digit">>, <<"WRONG_MAC">>},
        {<<"three_digits">>, <<"WRONG_MAC">>},
        {<<"not_hex">>, <<"WRONG_MAC">>},
        {<<"trailing_separator">>, <<"WRONG_MAC">>},
        {<<"space_separator">>, <<"WRONG_MAC">>},
        {<<"number">>, <<"WRONG_MAC">>},
        {<<"trailing_newline">>, <<"WRONG_MAC">>},
        {<<"eui64_trailing_newline">>, <<"WRONG_MAC">>},
        {<<"arabic_indic_digit">>, <<"WRONG_MAC">>},
        {<<"fullwidth_letter">>, <<"WRONG_MAC">>},
        {<<"big_integer">>, <<"WRONG_MAC">>},
        {<<"value_is_hash">>, <<"FORMAT_ERROR">>},
        {<<"value_is_empty_hash">>, <<"FORMAT_ERROR">>},
        {<<"value_is_array">>, <<"FORMAT_ERROR">>},
        {<<"value_is_empty_array">>, <<"FORMAT_ERROR">>},
        {<<"mac48_given_eui64">>, <<"WRONG_MAC">>},
        {<<"eui64_given_mac48">>, <<"WRONG_MAC">>},
        {<<"eui64_seven_pairs">>, <<"WRONG_MAC">>},
        {<<"eui64_nine_pairs">>, <<"WRONG_MAC">>},
        {<<"eui64_mixed_separators">>, <<"WRONG_MAC">>},
        {<<"eui64_without_separators">>, <<"WRONG_MAC">>},
        {<<"eui64_value_is_array">>, <<"FORMAT_ERROR">>},
        {<<"boolean_true">>, <<"WRONG_MAC">>},
        {<<"eui64_boolean_false">>, <<"WRONG_MAC">>},
        {<<"string_argument">>, <<"WRONG_MAC">>}
    ]}
].
