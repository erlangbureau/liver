%% LIVR negative/13-values (case: values, form: proplists)
%% Source: https://github.com/koorchik/LIVR/tree/14e5a1b19011d3e9bf6ab5a6a0dd4444bea8b280/test_suite_2.5/negative/13-values
%% Imported for liver; iso_date outputs use Erlang {Y,M,D} dates.
%% Proplist fixtures preserve JSON key order from json:decode/3.

[
    {name, values},
    {rules, [
        {<<"stock">>, [
            {values, [required, positive_integer]}
        ]},
        {<<"several_failing">>, [
            [
                {values, [required, positive_integer]}
            ]
        ]},
        {<<"null_inside">>, [
            {values, [required, positive_integer]}
        ]},
        {<<"single_list_form">>, [
            {values, [
                [required, positive_integer]
            ]}
        ]},
        {<<"prototype_keys">>, [
            {values, [required, positive_integer]}
        ]},
        {<<"nested_objects">>, [
            {values, [
                {nested_object, [
                    {<<"name">>, required}
                ]}
            ]}
        ]},
        {<<"lists">>, [
            {values, [
                {list_of, positive_integer}
            ]}
        ]},
        {<<"value_is_array">>, [
            {values, [required, positive_integer]}
        ]},
        {<<"value_is_string">>, [
            {values, [required, positive_integer]}
        ]},
        {<<"value_is_number">>, [
            {values, [required, positive_integer]}
        ]},
        {<<"value_is_boolean">>, [
            {values, [required, positive_integer]}
        ]},
        {<<"empty_field">>, [
            {values, [required, positive_integer]}
        ]},
        {<<"null_field">>, [
            {values, [required, positive_integer]}
        ]}
    ]},
    {input, [
        {<<"stock">>, [
            {<<"sku-1">>, <<"-5">>},
            {<<"sku-2">>, 10}
        ]},
        {<<"several_failing">>, [
            {<<"a">>, <<"x">>},
            {<<"b">>, <<>>},
            {<<"c">>, 3}
        ]},
        {<<"null_inside">>, [
            {<<"a">>, null}
        ]},
        {<<"single_list_form">>, [
            {<<"a">>, <<>>},
            {<<"b">>, 2}
        ]},
        {<<"prototype_keys">>, [
            {<<"__proto__">>, <<"x">>},
            {<<"constructor">>, <<"2">>},
            {<<"hasOwnProperty">>, <<>>}
        ]},
        {<<"nested_objects">>, [
            {<<"u1">>, [
                {<<"name">>, <<"Jane Doe">>}
            ]},
            {<<"u2">>, [
                {<<"email">>, <<"user@example.com">>}
            ]}
        ]},
        {<<"lists">>, [
            {<<"a">>, [<<"1">>, <<"x">>]},
            {<<"b">>, <<"y">>}
        ]},
        {<<"value_is_array">>, [<<"5">>, <<"6">>]},
        {<<"value_is_string">>, <<"abc">>},
        {<<"value_is_number">>, 5},
        {<<"value_is_boolean">>, true},
        {<<"empty_field">>, <<>>},
        {<<"null_field">>, null},
        {<<"extra_field">>, <<"extra">>}
    ]},
    {errors, [
        {<<"stock">>, [
            {<<"sku-1">>, <<"NOT_POSITIVE_INTEGER">>}
        ]},
        {<<"several_failing">>, [
            {<<"a">>, <<"NOT_POSITIVE_INTEGER">>},
            {<<"b">>, <<"REQUIRED">>}
        ]},
        {<<"null_inside">>, [
            {<<"a">>, <<"REQUIRED">>}
        ]},
        {<<"single_list_form">>, [
            {<<"a">>, <<"REQUIRED">>}
        ]},
        {<<"prototype_keys">>, [
            {<<"__proto__">>, <<"NOT_POSITIVE_INTEGER">>},
            {<<"hasOwnProperty">>, <<"REQUIRED">>}
        ]},
        {<<"nested_objects">>, [
            {<<"u2">>, [
                {<<"name">>, <<"REQUIRED">>}
            ]}
        ]},
        {<<"lists">>, [
            {<<"a">>, [null, <<"NOT_POSITIVE_INTEGER">>]},
            {<<"b">>, <<"FORMAT_ERROR">>}
        ]},
        {<<"value_is_array">>, <<"FORMAT_ERROR">>},
        {<<"value_is_string">>, <<"FORMAT_ERROR">>},
        {<<"value_is_number">>, <<"FORMAT_ERROR">>},
        {<<"value_is_boolean">>, <<"FORMAT_ERROR">>}
    ]}
].
