        {<<"number">>, jwt},
        {<<"arabic_indic_digit_in_signature">>, jwt},
        {<<"non_ascii_letter_in_payload">>, jwt},
        {<<"trailing_crlf">>, jwt},
        {<<"unsecured_trailing_newline">>, jwt},
        {<<"empty_field">>, jwt},
        {<<"null_field">>, jwt},
