        {<<"value_is_array">>, <<"FORMAT_ERROR">>},
        {<<"value_is_empty_array">>, <<"FORMAT_ERROR">>},
        {<<"dots_only">>, <<"WRONG_JWT">>},
        {<<"space_inside">>, <<"WRONG_JWT">>},
        {<<"trailing_newline">>, <<"WRONG_JWT">>},
