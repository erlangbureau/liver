        {<<"number">>, 123},
        {<<"arabic_indic_digit_in_signature">>, <<"eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiIxMjM0NTY3ODkwIn0.١VAmegkQOBsQ-iSZU96z6c8NY7QR9OhhYWYHwHTeGT4"/utf8>>},
