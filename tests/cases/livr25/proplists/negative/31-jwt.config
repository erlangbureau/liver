        {<<"boolean">>, true},
        {<<"extra_field">>, <<"extra">>},
        {<<"boolean_false">>, false}
    ]},
    {errors, [
        {<<"one_segment">>, <<"WRONG_JWT">>},
        {<<"two_segments">>, <<"WRONG_JWT">>},
        {<<"four_segments">>, <<"WRONG_JWT">>},
        {<<"jwe">>, <<"WRONG_JWT">>},
