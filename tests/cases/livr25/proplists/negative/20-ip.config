%% LIVR negative/20-ip (case: ip, form: proplists)
%% Source: https://github.com/koorchik/LIVR/tree/14e5a1b19011d3e9bf6ab5a6a0dd4444bea8b280/test_suite_2.5/negative/20-ip
%% Imported for liver; iso_date outputs use Erlang {Y,M,D} dates.
%% Proplist fixtures preserve JSON key order from json:decode/3.

[
    {name, ip},
    {rules, [
        {<<"ipv4_leading_zero">>, ip},
        {<<"ipv4_leading_zero_last">>, [ip]},
        {<<"ipv4_double_zero">>, ip},
        {<<"ipv4_too_big">>, ip},
        {<<"ipv4_three_parts">>, ip},
        {<<"ipv4_five_parts">>, ip},
        {<<"ipv4_negative">>, ip},
        {<<"ipv4_empty_part">>, ip},
        {<<"ipv4_trailing_dot">>, ip},
        {<<"ipv4_leading_space">>, ip},
        {<<"ipv4_trailing_newline">>, ip},
        {<<"ipv4_prefix_length">>, ip},
        {<<"ipv4_port">>, ip},
        {<<"ipv6_brackets">>, ip},
        {<<"ipv6_zone_id">>, ip},
        {<<"ipv6_prefix_length">>, ip},
        {<<"ipv6_two_double_colons">>, ip},
        {<<"ipv6_nine_groups">>, ip},
        {<<"ipv6_seven_groups">>, ip},
        {<<"ipv6_double_colon_with_eight_groups">>, ip},
        {<<"ipv6_five_hex_digits">>, ip},
        {<<"ipv6_not_hex">>, ip},
        {<<"ipv6_triple_colon">>, ip},
        {<<"ipv6_single_leading_colon">>, ip},
        {<<"ipv6_single_trailing_colon">>, ip},
        {<<"ipv6_embedded_ipv4_too_big">>, ip},
        {<<"ipv6_embedded_ipv4_leading_zero">>, ip},
        {<<"ipv6_embedded_ipv4_not_last">>, ip},
        {<<"ipv6_embedded_ipv4_too_many_groups">>, ip},
        {<<"number">>, ip},
        {<<"only_ipv4_given_ipv6">>, [
            {ip, <<"v4">>}
        ]},
        {<<"only_ipv4_given_embedded">>, [
            {ip, <<"v4">>}
        ]},
        {<<"only_ipv6_given_ipv4">>, [
            {ip, <<"v6">>}
        ]},
        {<<"ipv4_arabic_indic_digits">>, ip},
        {<<"ipv4_arabic_indic_digit_in_octet">>, ip},
        {<<"ipv4_fullwidth_digits">>, ip},
        {<<"ipv4_only_arabic_indic_digits">>, [
            {ip, <<"v4">>}
        ]},
        {<<"ipv6_arabic_indic_digits">>, ip},
        {<<"ipv6_embedded_arabic_indic_ipv4">>, [
            {ip, <<"v6">>}
        ]},
        {<<"ipv6_fullwidth_hex">>, ip},
        {<<"ipv6_trailing_newline">>, ip},
        {<<"ipv4_only_trailing_newline">>, [
            {ip, <<"v4">>}
        ]},
        {<<"fraction_number">>, ip},
        {<<"exponent_number">>, ip},
        {<<"boolean_true">>, ip},
        {<<"boolean_false">>, ip},
        {<<"empty_field">>, ip},
        {<<"null_field">>, ip},
        {<<"value_is_hash">>, ip},
        {<<"value_is_empty_hash">>, ip},
        {<<"value_is_array">>, ip},
        {<<"value_is_empty_array">>, ip}
    ]},
    {input, [
        {<<"ipv4_leading_zero">>, <<"010.0.0.1">>},
        {<<"ipv4_leading_zero_last">>, <<"192.0.2.01">>},
        {<<"ipv4_double_zero">>, <<"192.0.2.00">>},
        {<<"ipv4_too_big">>, <<"256.0.0.1">>},
        {<<"ipv4_three_parts">>, <<"192.0.2">>},
        {<<"ipv4_five_parts">>, <<"192.0.2.1.5">>},
        {<<"ipv4_negative">>, <<"192.0.2.-1">>},
        {<<"ipv4_empty_part">>, <<"192.0..1">>},
        {<<"ipv4_trailing_dot">>, <<"192.0.2.1.">>},
        {<<"ipv4_leading_space">>, <<" 192.0.2.1">>},
        {<<"ipv4_trailing_newline">>, <<"192.0.2.1\n">>},
        {<<"ipv4_prefix_length">>, <<"192.0.2.1/24">>},
        {<<"ipv4_port">>, <<"192.0.2.1:80">>},
        {<<"ipv6_brackets">>, <<"[2001:db8::1]">>},
        {<<"ipv6_zone_id">>, <<"fe80::1%eth0">>},
        {<<"ipv6_prefix_length">>, <<"2001:db8::/32">>},
        {<<"ipv6_two_double_colons">>, <<"2001:db8::1::1">>},
        {<<"ipv6_nine_groups">>, <<"2001:db8:0:0:0:0:0:0:1">>},
        {<<"ipv6_seven_groups">>, <<"2001:db8:0:0:0:0:1">>},
        {<<"ipv6_double_colon_with_eight_groups">>, <<"2001:db8:0:0:0:0:0::1">>},
        {<<"ipv6_five_hex_digits">>, <<"12345::1">>},
        {<<"ipv6_not_hex">>, <<"2001:db8::g">>},
        {<<"ipv6_triple_colon">>, <<":::">>},
        {<<"ipv6_single_leading_colon">>, <<":2001:db8::1">>},
        {<<"ipv6_single_trailing_colon">>, <<"2001:db8::1:">>},
        {<<"ipv6_embedded_ipv4_too_big">>, <<"::ffff:192.0.2.256">>},
        {<<"ipv6_embedded_ipv4_leading_zero">>, <<"::ffff:192.0.2.01">>},
        {<<"ipv6_embedded_ipv4_not_last">>, <<"::192.0.2.1:ffff">>},
        {<<"ipv6_embedded_ipv4_too_many_groups">>, <<"0:0:0:0:0:0:ffff:192.0.2.1">>},
        {<<"number">>, 1},
        {<<"only_ipv4_given_ipv6">>, <<"2001:db8::1">>},
        {<<"only_ipv4_given_embedded">>, <<"::ffff:192.0.2.1">>},
        {<<"only_ipv6_given_ipv4">>, <<"192.0.2.1">>},
        {<<"ipv4_arabic_indic_digits">>, <<"١٩٢.٠.٢.١"/utf8>>},
        {<<"ipv4_arabic_indic_digit_in_octet">>, <<"192.0.2.١"/utf8>>},
        {<<"ipv4_fullwidth_digits">>, <<"１９２.0.2.1"/utf8>>},
        {<<"ipv4_only_arabic_indic_digits">>, <<"١٩٢.٠.٢.١"/utf8>>},
        {<<"ipv6_arabic_indic_digits">>, <<"2001:db8::١"/utf8>>},
        {<<"ipv6_embedded_arabic_indic_ipv4">>, <<"::ffff:192.0.2.١"/utf8>>},
        {<<"ipv6_fullwidth_hex">>, <<"2001:db8::ａ"/utf8>>},
        {<<"ipv6_trailing_newline">>, <<"2001:db8::1\n">>},
        {<<"ipv4_only_trailing_newline">>, <<"192.0.2.1\n">>},
        {<<"fraction_number">>, 0.1},
        {<<"exponent_number">>, 1.0e3},
        {<<"boolean_true">>, true},
        {<<"boolean_false">>, false},
        {<<"empty_field">>, <<>>},
        {<<"null_field">>, null},
        {<<"extra_field">>, <<"extra">>},
        {<<"value_is_hash">>, [
            {<<"test">>, 1}
        ]},
        {<<"value_is_empty_hash">>, [{}]},
        {<<"value_is_array">>, [<<"test">>, 1]},
        {<<"value_is_empty_array">>, []}
    ]},
    {errors, [
        {<<"ipv4_leading_zero">>, <<"WRONG_IP">>},
        {<<"ipv4_leading_zero_last">>, <<"WRONG_IP">>},
        {<<"ipv4_double_zero">>, <<"WRONG_IP">>},
        {<<"ipv4_too_big">>, <<"WRONG_IP">>},
        {<<"ipv4_three_parts">>, <<"WRONG_IP">>},
        {<<"ipv4_five_parts">>, <<"WRONG_IP">>},
        {<<"ipv4_negative">>, <<"WRONG_IP">>},
        {<<"ipv4_empty_part">>, <<"WRONG_IP">>},
        {<<"ipv4_trailing_dot">>, <<"WRONG_IP">>},
        {<<"ipv4_leading_space">>, <<"WRONG_IP">>},
        {<<"ipv4_trailing_newline">>, <<"WRONG_IP">>},
        {<<"ipv4_prefix_length">>, <<"WRONG_IP">>},
        {<<"ipv4_port">>, <<"WRONG_IP">>},
        {<<"ipv6_brackets">>, <<"WRONG_IP">>},
        {<<"ipv6_zone_id">>, <<"WRONG_IP">>},
        {<<"ipv6_prefix_length">>, <<"WRONG_IP">>},
        {<<"ipv6_two_double_colons">>, <<"WRONG_IP">>},
        {<<"ipv6_nine_groups">>, <<"WRONG_IP">>},
        {<<"ipv6_seven_groups">>, <<"WRONG_IP">>},
        {<<"ipv6_double_colon_with_eight_groups">>, <<"WRONG_IP">>},
        {<<"ipv6_five_hex_digits">>, <<"WRONG_IP">>},
        {<<"ipv6_not_hex">>, <<"WRONG_IP">>},
        {<<"ipv6_triple_colon">>, <<"WRONG_IP">>},
        {<<"ipv6_single_leading_colon">>, <<"WRONG_IP">>},
        {<<"ipv6_single_trailing_colon">>, <<"WRONG_IP">>},
        {<<"ipv6_embedded_ipv4_too_big">>, <<"WRONG_IP">>},
        {<<"ipv6_embedded_ipv4_leading_zero">>, <<"WRONG_IP">>},
        {<<"ipv6_embedded_ipv4_not_last">>, <<"WRONG_IP">>},
        {<<"ipv6_embedded_ipv4_too_many_groups">>, <<"WRONG_IP">>},
        {<<"number">>, <<"WRONG_IP">>},
        {<<"only_ipv4_given_ipv6">>, <<"WRONG_IP">>},
        {<<"only_ipv4_given_embedded">>, <<"WRONG_IP">>},
        {<<"only_ipv6_given_ipv4">>, <<"WRONG_IP">>},
        {<<"ipv4_arabic_indic_digits">>, <<"WRONG_IP">>},
        {<<"ipv4_arabic_indic_digit_in_octet">>, <<"WRONG_IP">>},
        {<<"ipv4_fullwidth_digits">>, <<"WRONG_IP">>},
        {<<"ipv4_only_arabic_indic_digits">>, <<"WRONG_IP">>},
        {<<"ipv6_arabic_indic_digits">>, <<"WRONG_IP">>},
        {<<"ipv6_embedded_arabic_indic_ipv4">>, <<"WRONG_IP">>},
        {<<"ipv6_fullwidth_hex">>, <<"WRONG_IP">>},
        {<<"ipv6_trailing_newline">>, <<"WRONG_IP">>},
        {<<"ipv4_only_trailing_newline">>, <<"WRONG_IP">>},
        {<<"fraction_number">>, <<"WRONG_IP">>},
        {<<"exponent_number">>, <<"WRONG_IP">>},
        {<<"boolean_true">>, <<"WRONG_IP">>},
        {<<"boolean_false">>, <<"WRONG_IP">>},
        {<<"value_is_hash">>, <<"FORMAT_ERROR">>},
        {<<"value_is_empty_hash">>, <<"FORMAT_ERROR">>},
        {<<"value_is_array">>, <<"FORMAT_ERROR">>},
        {<<"value_is_empty_array">>, <<"FORMAT_ERROR">>}
    ]}
].
