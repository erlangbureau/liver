%% LIVR negative/24-hex (case: hex, form: proplists)
%% Source: https://github.com/koorchik/LIVR/tree/44955f198e7cbd2d6ec2fb1926c9fe8bd2e5628d/test_suite_2.5/negative/24-hex
%% Imported for liver; iso_date outputs use Erlang {Y,M,D} dates.
%% Proplist fixtures preserve JSON key order from json:decode/3.

[
    {name, hex},
    {rules, [
        {<<"prefix">>, hex},
        {<<"uppercase_prefix">>, [hex]},
        {<<"not_hex">>, [
            {hex, []}
        ]},
        {<<"g_letter">>, hex},
        {<<"space">>, hex},
        {<<"dash">>, hex},
        {<<"hash_sign">>, hex},
        {<<"trailing_newline">>, hex},
        {<<"negative_number">>, hex},
        {<<"decimal_number">>, hex},
        {<<"boolean">>, hex},
        {<<"boolean_false">>, hex},
        {<<"fraction_number">>, hex},
        {<<"negative_fraction_number">>, hex},
        {<<"arabic_indic_digits">>, hex},
        {<<"fullwidth_letters">>, hex},
        {<<"empty_field">>, hex},
        {<<"null_field">>, hex},
        {<<"value_is_hash">>, hex},
        {<<"value_is_empty_hash">>, hex},
        {<<"value_is_array">>, hex},
        {<<"value_is_empty_array">>, hex}
    ]},
    {input, [
        {<<"prefix">>, <<"0x1f">>},
        {<<"uppercase_prefix">>, <<"0X1F">>},
        {<<"not_hex">>, <<"xyz">>},
        {<<"g_letter">>, <<"abcdefg">>},
        {<<"space">>, <<"12 34">>},
        {<<"dash">>, <<"12-34">>},
        {<<"hash_sign">>, <<"#fff">>},
        {<<"trailing_newline">>, <<"ff\n">>},
        {<<"negative_number">>, -1},
        {<<"decimal_number">>, 1.5},
        {<<"boolean">>, true},
        {<<"boolean_false">>, false},
        {<<"fraction_number">>, 0.1},
        {<<"negative_fraction_number">>, -12.25},
        {<<"arabic_indic_digits">>, <<"١٢"/utf8>>},
        {<<"fullwidth_letters">>, <<"ＦＦ"/utf8>>},
        {<<"empty_field">>, <<>>},
        {<<"null_field">>, null},
        {<<"extra_field">>, <<"extra">>},
        {<<"value_is_hash">>, [
            {<<"test">>, 1}
        ]},
        {<<"value_is_empty_hash">>, [{}]},
        {<<"value_is_array">>, [<<"test">>, 1]},
        {<<"value_is_empty_array">>, []}
    ]},
    {errors, [
        {<<"prefix">>, <<"WRONG_HEX">>},
        {<<"uppercase_prefix">>, <<"WRONG_HEX">>},
        {<<"not_hex">>, <<"WRONG_HEX">>},
        {<<"g_letter">>, <<"WRONG_HEX">>},
        {<<"space">>, <<"WRONG_HEX">>},
        {<<"dash">>, <<"WRONG_HEX">>},
        {<<"hash_sign">>, <<"WRONG_HEX">>},
        {<<"trailing_newline">>, <<"WRONG_HEX">>},
        {<<"negative_number">>, <<"WRONG_HEX">>},
        {<<"decimal_number">>, <<"WRONG_HEX">>},
        {<<"boolean">>, <<"WRONG_HEX">>},
        {<<"boolean_false">>, <<"WRONG_HEX">>},
        {<<"fraction_number">>, <<"WRONG_HEX">>},
        {<<"negative_fraction_number">>, <<"WRONG_HEX">>},
        {<<"arabic_indic_digits">>, <<"WRONG_HEX">>},
        {<<"fullwidth_letters">>, <<"WRONG_HEX">>},
        {<<"value_is_hash">>, <<"FORMAT_ERROR">>},
        {<<"value_is_empty_hash">>, <<"FORMAT_ERROR">>},
        {<<"value_is_array">>, <<"FORMAT_ERROR">>},
        {<<"value_is_empty_array">>, <<"FORMAT_ERROR">>}
    ]}
].
