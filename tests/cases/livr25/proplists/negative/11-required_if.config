%% LIVR negative/11-required_if (case: required_if, form: proplists)
%% Source: https://github.com/koorchik/LIVR/tree/44955f198e7cbd2d6ec2fb1926c9fe8bd2e5628d/test_suite_2.5/negative/11-required_if
%% Imported for liver; iso_date outputs use Erlang {Y,M,D} dates.
%% Proplist fixtures preserve JSON key order from json:decode/3.

[
    {name, required_if},
    {rules, [
        {<<"send_me_emails">>, boolean},
        {<<"email">>, [
            {required_if, [
                {<<"send_me_emails">>, true}
            ]}
        ]},
        {<<"email_empty">>, [
            {required_if, [
                {<<"send_me_emails">>, true}
            ]}
        ]},
        {<<"email_null">>, [
            [
                {required_if, [
                    {<<"send_me_emails">>, true}
                ]}
            ],
            email
        ]},
        {<<"email_string_ref">>, [
            {required_if, [
                {<<"send_string">>, true}
            ]}
        ]},
        {<<"type">>, string},
        {<<"vat">>, [
            {required_if, [
                {<<"type">>, [<<"company">>, <<"ngo">>]}
            ]}
        ]},
        {<<"country">>, string},
        {<<"kind">>, string},
        {<<"company_code">>, [
            {required_if, [
                {<<"country">>, <<"UA">>},
                {<<"kind">>, <<"company">>}
            ]}
        ]},
        {<<"address">>, [
            {nested_object, [
                {<<"country">>, required}
            ]}
        ]},
        {<<"zip">>, [
            {required_if, [
                {<<"address/country">>, <<"UA">>}
            ]}
        ]},
        {<<"order_zip">>, [
            {required_if, [
                {<<"order/customer/address/country">>, <<"UA">>}
            ]}
        ]},
        {<<"items">>, [
            {list_of_objects, [
                {<<"id">>, required}
            ]}
        ]},
        {<<"second_item_note">>, [
            {required_if, [
                {<<"items/1/id">>, <<"2">>}
            ]}
        ]},
        {<<"second_tag_note">>, [
            {required_if, [
                {<<"tags/1">>, <<"b">>}
            ]}
        ]},
        {<<"count">>, integer},
        {<<"count_note">>, [
            {required_if, [
                {<<"count">>, <<"1">>}
            ]}
        ]},
        {<<"count_string_note">>, [
            {required_if, [
                {<<"count_string">>, 1}
            ]}
        ]},
        {<<"level_note">>, [
            {required_if, [
                {<<"level">>, [1, 2]}
            ]}
        ]},
        {<<"number_note">>, [
            {required_if, [
                {<<"number_one_point_zero">>, <<"1">>}
            ]}
        ]},
        {<<"flag_false_note">>, [
            {required_if, [
                {<<"flag_false">>, false}
            ]}
        ]},
        {<<"zero_ref_note">>, [
            {required_if, [
                {<<"zero_ref">>, 0}
            ]}
        ]},
        {<<"slash_note">>, [
            {required_if, [
                {<<"a~1b">>, <<"yes">>}
            ]}
        ]},
        {<<"tilde_note">>, [
            {required_if, [
                {<<"a~0b">>, <<"yes">>}
            ]}
        ]},
        {<<"escape_order_note">>, [
            {required_if, [
                {<<"x~01y">>, <<"yes">>}
            ]}
        ]},
        {<<"field_unruled_ref">>, [
            {required_if, [
                {<<"unruled_ref">>, <<"yes">>}
            ]}
        ]},
        {<<"padded_country">>, trim},
        {<<"padded_zip">>, [
            {required_if, [
                {<<"padded_country">>, <<" UA ">>}
            ]}
        ]},
        {<<"role">>, string},
        {<<"account">>, [
            {nested_object, [
                {<<"role">>, required},
                {<<"permissions">>, [
                    {required_if, [
                        {<<"role">>, <<"user">>}
                    ]}
                ]}
            ]}
        ]},
        {<<"contacts">>, [
            {list_of_objects, [
                {<<"type">>, required},
                {<<"email">>, [
                    {required_if, [
                        {<<"type">>, <<"email">>}
                    ]}
                ]}
            ]}
        ]},
        {<<"not_required">>, [
            {required_if, [
                {<<"send_me_emails">>, false}
            ]}
        ]},
        {<<"codes_padded_key">>, [
            {nested_object, [
                {<<"01">>, string}
            ]}
        ]},
        {<<"object_key_with_leading_zero_note">>, [
            {required_if, [
                {<<"codes_padded_key/01">>, <<"UA">>}
            ]}
        ]},
        {<<"first_tag_note">>, [
            {required_if, [
                {<<"tags/0">>, <<"a">>}
            ]}
        ]},
        {<<"tag_two_digit_index">>, [
            {list_of, string}
        ]},
        {<<"tag_two_digit_index_note">>, [
            {required_if, [
                {<<"tag_two_digit_index/10">>, <<"k">>}
            ]}
        ]},
        {<<"category_account">>, [
            {variable_object, [
                <<"category">>,
                [
                    {<<"company">>, [
                        {<<"category">>, required},
                        {<<"vat">>, [
                            {required_if, [
                                {<<"category">>, <<"company">>}
                            ]}
                        ]}
                    ]}
                ]
            ]}
        ]},
        {<<"members">>, [
            {list_of_different_objects, [
                <<"category">>,
                [
                    {<<"person">>, [
                        {<<"category">>, required},
                        {<<"vat">>, [
                            {required_if, [
                                {<<"category">>, <<"company">>}
                            ]}
                        ]}
                    ]},
                    {<<"company">>, [
                        {<<"category">>, required},
                        {<<"vat">>, [
                            {required_if, [
                                {<<"category">>, <<"company">>}
                            ]}
                        ]}
                    ]}
                ]
            ]}
        ]},
        {<<"partners">>, [
            {list_of, [
                {nested_object, [
                    {<<"category">>, required},
                    {<<"vat">>, [
                        {required_if, [
                            {<<"category">>, <<"company">>}
                        ]}
                    ]}
                ]}
            ]}
        ]},
        {<<"or_vat">>, [
            {'or', [
                [
                    required,
                    [
                        {eq, <<"N/A">>}
                    ]
                ],
                [
                    {required_if, [
                        {<<"type">>, <<"company">>}
                    ]}
                ]
            ]}
        ]},
        {<<"or_vat_empty">>, [
            {'or', [
                [
                    required,
                    [
                        {eq, <<"N/A">>}
                    ]
                ],
                [
                    {required_if, [
                        {<<"type">>, <<"company">>}
                    ]}
                ]
            ]}
        ]},
        {<<"kind_upper">>, to_lc},
        {<<"kind_upper_vat">>, [
            {required_if, [
                {<<"kind_upper">>, <<"COMPANY">>}
            ]}
        ]}
    ]},
    {input, [
        {<<"send_me_emails">>, true},
        {<<"email_empty">>, <<>>},
        {<<"email_null">>, null},
        {<<"send_string">>, <<"true">>},
        {<<"type">>, <<"company">>},
        {<<"country">>, <<"UA">>},
        {<<"kind">>, <<"company">>},
        {<<"address">>, [
            {<<"country">>, <<"UA">>}
        ]},
        {<<"order">>, [
            {<<"customer">>, [
                {<<"address">>, [
                    {<<"country">>, <<"UA">>}
                ]}
            ]}
        ]},
        {<<"items">>, [
            [
                {<<"id">>, 1}
            ],
            [
                {<<"id">>, 2}
            ]
        ]},
        {<<"tags">>, [<<"a">>, <<"b">>]},
        {<<"count">>, 1},
        {<<"count_string">>, <<"1">>},
        {<<"level">>, <<"2">>},
        {<<"number_one_point_zero">>, 1.0},
        {<<"flag_false">>, false},
        {<<"zero_ref">>, 0},
        {<<"a/b">>, <<"yes">>},
        {<<"a~1b">>, <<"no">>},
        {<<"a~b">>, <<"yes">>},
        {<<"a~0b">>, <<"no">>},
        {<<"x~1y">>, <<"yes">>},
        {<<"x/y">>, <<"no">>},
        {<<"unruled_ref">>, <<"yes">>},
        {<<"padded_country">>, <<" UA ">>},
        {<<"role">>, <<"admin">>},
        {<<"account">>, [
            {<<"role">>, <<"user">>}
        ]},
        {<<"contacts">>, [
            [
                {<<"type">>, <<"phone">>}
            ],
            [
                {<<"type">>, <<"email">>}
            ],
            [
                {<<"type">>, <<"email">>},
                {<<"email">>, <<"user@example.com">>}
            ]
        ]},
        {<<"codes_padded_key">>, [
            {<<"01">>, <<"UA">>}
        ]},
        {<<"tag_two_digit_index">>, [
            <<"a">>,
            <<"b">>,
            <<"c">>,
            <<"d">>,
            <<"e">>,
            <<"f">>,
            <<"g">>,
            <<"h">>,
            <<"i">>,
            <<"j">>,
            <<"k">>
        ]},
        {<<"category_account">>, [
            {<<"category">>, <<"company">>}
        ]},
        {<<"members">>, [
            [
                {<<"category">>, <<"person">>}
            ],
            [
                {<<"category">>, <<"company">>}
            ]
        ]},
        {<<"partners">>, [
            [
                {<<"category">>, <<"company">>}
            ],
            [
                {<<"category">>, <<"person">>}
            ]
        ]},
        {<<"or_vat_empty">>, <<>>},
        {<<"kind_upper">>, <<"COMPANY">>}
    ]},
    {errors, [
        {<<"email">>, <<"REQUIRED">>},
        {<<"email_empty">>, <<"REQUIRED">>},
        {<<"email_null">>, <<"REQUIRED">>},
        {<<"email_string_ref">>, <<"REQUIRED">>},
        {<<"vat">>, <<"REQUIRED">>},
        {<<"company_code">>, <<"REQUIRED">>},
        {<<"zip">>, <<"REQUIRED">>},
        {<<"order_zip">>, <<"REQUIRED">>},
        {<<"second_item_note">>, <<"REQUIRED">>},
        {<<"second_tag_note">>, <<"REQUIRED">>},
        {<<"count_note">>, <<"REQUIRED">>},
        {<<"count_string_note">>, <<"REQUIRED">>},
        {<<"level_note">>, <<"REQUIRED">>},
        {<<"number_note">>, <<"REQUIRED">>},
        {<<"flag_false_note">>, <<"REQUIRED">>},
        {<<"zero_ref_note">>, <<"REQUIRED">>},
        {<<"slash_note">>, <<"REQUIRED">>},
        {<<"tilde_note">>, <<"REQUIRED">>},
        {<<"escape_order_note">>, <<"REQUIRED">>},
        {<<"field_unruled_ref">>, <<"REQUIRED">>},
        {<<"padded_zip">>, <<"REQUIRED">>},
        {<<"account">>, [
            {<<"permissions">>, <<"REQUIRED">>}
        ]},
        {<<"contacts">>, [
            null,
            [
                {<<"email">>, <<"REQUIRED">>}
            ],
            null
        ]},
        {<<"object_key_with_leading_zero_note">>, <<"REQUIRED">>},
        {<<"first_tag_note">>, <<"REQUIRED">>},
        {<<"tag_two_digit_index_note">>, <<"REQUIRED">>},
        {<<"category_account">>, [
            {<<"vat">>, <<"REQUIRED">>}
        ]},
        {<<"members">>, [
