%% LIVR negative/01-boolean (case: boolean, form: proplists)
%% Source: https://github.com/koorchik/LIVR/tree/14e5a1b19011d3e9bf6ab5a6a0dd4444bea8b280/test_suite_2.5/negative/01-boolean
%% Imported for liver; iso_date outputs use Erlang {Y,M,D} dates.
%% Proplist fixtures preserve JSON key order from json:decode/3.

[
    {name, boolean},
    {rules, [
        {<<"capitalized_true">>, boolean},
        {<<"uppercase_false">>, boolean},
        {<<"yes_string">>, boolean},
        {<<"on_string">>, boolean},
        {<<"two_number">>, boolean},
        {<<"minus_one_number">>, boolean},
        {<<"decimal_string">>, boolean},
        {<<"one_with_space">>, boolean},
        {<<"true_with_space">>, boolean},
        {<<"space_string">>, boolean},
        {<<"null_string">>, boolean},
        {<<"required_missing">>, [required, boolean]},
        {<<"fraction_number">>, boolean},
        {<<"thousand_exponent">>, boolean},
        {<<"trailing_newline">>, boolean},
        {<<"empty_field">>, boolean},
        {<<"null_field">>, boolean},
        {<<"value_is_hash">>, boolean},
        {<<"value_is_empty_hash">>, boolean},
        {<<"value_is_array">>, boolean},
        {<<"value_is_empty_array">>, boolean}
    ]},
    {input, [
        {<<"capitalized_true">>, <<"True">>},
        {<<"uppercase_false">>, <<"FALSE">>},
        {<<"yes_string">>, <<"yes">>},
        {<<"on_string">>, <<"on">>},
        {<<"two_number">>, 2},
        {<<"minus_one_number">>, -1},
        {<<"decimal_string">>, <<"1.0">>},
        {<<"one_with_space">>, <<" 1">>},
        {<<"true_with_space">>, <<"true ">>},
        {<<"space_string">>, <<" ">>},
        {<<"null_string">>, <<"null">>},
        {<<"fraction_number">>, 0.1},
        {<<"thousand_exponent">>, 1.0e3},
        {<<"trailing_newline">>, <<"true\n">>},
        {<<"empty_field">>, <<>>},
        {<<"null_field">>, null},
        {<<"extra_field">>, <<"extra">>},
        {<<"value_is_hash">>, [
            {<<"test">>, 1}
        ]},
        {<<"value_is_empty_hash">>, [{}]},
        {<<"value_is_array">>, [<<"test">>, 1]},
        {<<"value_is_empty_array">>, []}
    ]},
    {errors, [
        {<<"capitalized_true">>, <<"NOT_BOOLEAN">>},
        {<<"uppercase_false">>, <<"NOT_BOOLEAN">>},
        {<<"yes_string">>, <<"NOT_BOOLEAN">>},
        {<<"on_string">>, <<"NOT_BOOLEAN">>},
        {<<"two_number">>, <<"NOT_BOOLEAN">>},
        {<<"minus_one_number">>, <<"NOT_BOOLEAN">>},
        {<<"decimal_string">>, <<"NOT_BOOLEAN">>},
        {<<"one_with_space">>, <<"NOT_BOOLEAN">>},
        {<<"true_with_space">>, <<"NOT_BOOLEAN">>},
        {<<"space_string">>, <<"NOT_BOOLEAN">>},
        {<<"null_string">>, <<"NOT_BOOLEAN">>},
        {<<"required_missing">>, <<"REQUIRED">>},
        {<<"fraction_number">>, <<"NOT_BOOLEAN">>},
        {<<"thousand_exponent">>, <<"NOT_BOOLEAN">>},
        {<<"trailing_newline">>, <<"NOT_BOOLEAN">>},
        {<<"value_is_hash">>, <<"FORMAT_ERROR">>},
        {<<"value_is_empty_hash">>, <<"FORMAT_ERROR">>},
        {<<"value_is_array">>, <<"FORMAT_ERROR">>},
        {<<"value_is_empty_array">>, <<"FORMAT_ERROR">>}
    ]}
].
