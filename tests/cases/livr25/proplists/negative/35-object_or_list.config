%% LIVR negative/35-object_or_list (case: object_or_list, form: proplists)
%% Source: https://github.com/koorchik/LIVR/tree/14e5a1b19011d3e9bf6ab5a6a0dd4444bea8b280/test_suite_2.5/negative/35-object_or_list
%% Imported for liver; iso_date outputs use Erlang {Y,M,D} dates.
%% Proplist fixtures preserve JSON key order from json:decode/3.

[
    {name, object_or_list},
    {rules, [
        {<<"values_empty_list">>, [
            {values, [required, positive_integer]}
        ]},
        {<<"keys_empty_list">>, [
            [
                {keys, [
                    {one_of, [<<"uk">>, <<"en">>, <<"de">>]}
                ]}
            ],
            [
                {values, [
                    required,
                    string,
                    [
                        {max_length, 200}
                    ]
                ]}
            ]
        ]},
        {<<"list_length_empty_list">>, [
            {list_length, [1, 10]}
        ]},
        {<<"list_length_min_empty_list">>, [
            {list_length, [
                {<<"min">>, 1}
            ]}
        ]},
        {<<"list_length_empty_object">>, [
            {list_length, [1, 10]}
        ]},
        {<<"unique_empty_object">>, unique},
        {<<"unique_with_key_empty_object">>, [
            {unique, <<"id">>}
        ]},
        {<<"keys_numeric_keys">>, [
            {keys, positive_integer}
        ]},
        {<<"required_if_digit_key_note">>, [
            {required_if, [
                {<<"required_if_codes/0">>, <<"UA">>}
            ]}
        ]}
    ]},
    {input, [
        {<<"values_empty_list">>, []},
        {<<"keys_empty_list">>, []},
        {<<"list_length_empty_list">>, []},
        {<<"list_length_min_empty_list">>, []},
        {<<"list_length_empty_object">>, [{}]},
        {<<"unique_empty_object">>, [{}]},
        {<<"unique_with_key_empty_object">>, [{}]},
        {<<"keys_numeric_keys">>, [
            {<<"0">>, 1},
            {<<"a">>, 2},
            {<<"5">>, 3}
        ]},
        {<<"required_if_codes">>, [
            {<<"0">>, <<"UA">>},
            {<<"1">>, <<"PL">>}
        ]},
        {<<"extra_field">>, <<"extra">>}
    ]},
    {errors, [
        {<<"values_empty_list">>, <<"FORMAT_ERROR">>},
        {<<"keys_empty_list">>, <<"FORMAT_ERROR">>},
        {<<"list_length_empty_list">>, <<"TOO_FEW_ITEMS">>},
        {<<"list_length_min_empty_list">>, <<"TOO_FEW_ITEMS">>},
        {<<"list_length_empty_object">>, <<"FORMAT_ERROR">>},
        {<<"unique_empty_object">>, <<"FORMAT_ERROR">>},
        {<<"unique_with_key_empty_object">>, <<"FORMAT_ERROR">>},
        {<<"keys_numeric_keys">>, [
            {<<"0">>, <<"WRONG_KEY">>},
            {<<"a">>, <<"WRONG_KEY">>}
        ]},
        {<<"required_if_digit_key_note">>, <<"REQUIRED">>}
    ]}
].
