        {<<"standard_extra_padding">>, <<"SGVsbG8===">>},
        {<<"standard_url_alphabet">>, <<"-_-_">>},
        {<<"standard_space">>, <<"SGVs bG8=">>},
        {<<"standard_line_break">>, <<"SGVs\nbG8=">>},
        {<<"standard_trailing_newline">>, <<"SGVsbG8=\n">>},
        {<<"standard_wrong_char">>, <<"SGVsbG8*">>},
        {<<"number">>, 123},
        {<<"url_standard_alphabet">>, <<"+/+/">>},
        {<<"url_mod_1">>, <<"SGVsb">>},
        {<<"url_padding_in_the_middle">>, <<"SG=sbG8">>},
        {<<"url_space">>, <<"SGVs bG8">>},
        {<<"standard_partial_padding">>, <<"SA=">>},
        {<<"url_partial_padding">>, <<"SA=">>},
        {<<"url_partial_padding_long">>, <<"a-_a-_=">>},
        {<<"url_extra_padding">>, <<"SGVsbG8==">>},
