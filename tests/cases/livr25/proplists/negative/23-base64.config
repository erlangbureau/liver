        {<<"url_one_char">>, <<"S">>},
        {<<"url_only_padding">>, <<"==">>},
        {<<"url_triple_padding">>, <<"S===">>},
        {<<"boolean_true">>, true},
        {<<"boolean_false">>, false},
        {<<"url_boolean_true">>, true},
        {<<"fullwidth_letters">>, <<"ＳＧＶｓ"/utf8>>},
