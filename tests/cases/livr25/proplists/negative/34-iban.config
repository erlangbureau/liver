%% LIVR negative/34-iban (case: iban, form: proplists)
%% Source: https://github.com/koorchik/LIVR/tree/44955f198e7cbd2d6ec2fb1926c9fe8bd2e5628d/test_suite_2.5/negative/34-iban
%% Imported for liver; iso_date outputs use Erlang {Y,M,D} dates.
%% Proplist fixtures preserve JSON key order from json:decode/3.

[
    {name, iban},
    {rules, [
        {<<"wrong_checksum">>, iban},
        {<<"wrong_check_digits">>, [iban]},
        {<<"lowercase">>, [
            {iban, []}
        ]},
        {<<"lowercase_bban">>, iban},
        {<<"spaces">>, iban},
        {<<"too_short_14">>, iban},
        {<<"too_long_35">>, iban},
        {<<"letter_in_check_digits">>, iban},
        {<<"digits_in_country">>, iban},
        {<<"dash">>, iban},
        {<<"trailing_newline">>, iban},
        {<<"number">>, iban},
        {<<"arabic_indic_check_digits">>, iban},
        {<<"fullwidth_letters">>, iban},
        {<<"leading_newline">>, iban},
        {<<"trailing_crlf">>, iban},
        {<<"boolean_true">>, iban},
        {<<"boolean_false">>, [iban]},
        {<<"empty_field">>, iban},
        {<<"null_field">>, iban},
        {<<"value_is_hash">>, iban},
        {<<"value_is_empty_hash">>, iban},
        {<<"value_is_array">>, iban},
        {<<"value_is_empty_array">>, iban}
    ]},
    {input, [
        {<<"wrong_checksum">>, <<"GB82WEST12345698765431">>},
        {<<"wrong_check_digits">>, <<"GB83WEST12345698765432">>},
        {<<"lowercase">>, <<"gb82west12345698765432">>},
        {<<"lowercase_bban">>, <<"GB82west12345698765432">>},
        {<<"spaces">>, <<"GB82 WEST 1234 5698 7654 32">>},
        {<<"too_short_14">>, <<"DE791234567890">>},
        {<<"too_long_35">>, <<"GB901111111111111111111111111111111">>},
        {<<"letter_in_check_digits">>, <<"GBX2WEST12345698765432">>},
        {<<"digits_in_country">>, <<"1282WEST12345698765432">>},
        {<<"dash">>, <<"GB82WEST1234569876543-">>},
        {<<"trailing_newline">>, <<"GB82WEST12345698765432\n">>},
        {<<"number">>, 12345},
        {<<"arabic_indic_check_digits">>, <<"GB٨٢WEST12345698765432"/utf8>>},
        {<<"fullwidth_letters">>, <<"ＧＢ82WEST12345698765432"/utf8>>},
        {<<"leading_newline">>, <<"\nGB82WEST12345698765432">>},
        {<<"trailing_crlf">>, <<"GB82WEST12345698765432\r\n">>},
        {<<"boolean_true">>, true},
        {<<"boolean_false">>, false},
        {<<"empty_field">>, <<>>},
        {<<"null_field">>, null},
        {<<"extra_field">>, <<"extra">>},
        {<<"value_is_hash">>, [
            {<<"test">>, 1}
        ]},
        {<<"value_is_empty_hash">>, [{}]},
        {<<"value_is_array">>, [<<"test">>, 1]},
        {<<"value_is_empty_array">>, []}
    ]},
    {errors, [
        {<<"wrong_checksum">>, <<"WRONG_IBAN">>},
        {<<"wrong_check_digits">>, <<"WRONG_IBAN">>},
        {<<"lowercase">>, <<"WRONG_IBAN">>},
        {<<"lowercase_bban">>, <<"WRONG_IBAN">>},
        {<<"spaces">>, <<"WRONG_IBAN">>},
        {<<"too_short_14">>, <<"WRONG_IBAN">>},
        {<<"too_long_35">>, <<"WRONG_IBAN">>},
        {<<"letter_in_check_digits">>, <<"WRONG_IBAN">>},
        {<<"digits_in_country">>, <<"WRONG_IBAN">>},
        {<<"dash">>, <<"WRONG_IBAN">>},
        {<<"trailing_newline">>, <<"WRONG_IBAN">>},
        {<<"number">>, <<"WRONG_IBAN">>},
        {<<"arabic_indic_check_digits">>, <<"WRONG_IBAN">>},
        {<<"fullwidth_letters">>, <<"WRONG_IBAN">>},
        {<<"leading_newline">>, <<"WRONG_IBAN">>},
        {<<"trailing_crlf">>, <<"WRONG_IBAN">>},
        {<<"boolean_true">>, <<"WRONG_IBAN">>},
        {<<"boolean_false">>, <<"WRONG_IBAN">>},
        {<<"value_is_hash">>, <<"FORMAT_ERROR">>},
        {<<"value_is_empty_hash">>, <<"FORMAT_ERROR">>},
        {<<"value_is_array">>, <<"FORMAT_ERROR">>},
        {<<"value_is_empty_array">>, <<"FORMAT_ERROR">>}
    ]}
].
