%% LIVR negative/05-starts_with (case: starts_with, form: proplists)
%% Source: https://github.com/koorchik/LIVR/tree/14e5a1b19011d3e9bf6ab5a6a0dd4444bea8b280/test_suite_2.5/negative/05-starts_with
%% Imported for liver; iso_date outputs use Erlang {Y,M,D} dates.
%% Proplist fixtures preserve JSON key order from json:decode/3.

[
    {name, starts_with},
    {rules, [
        {<<"other_scheme">>, [
            {starts_with, [<<"https://">>, <<"http://">>]}
        ]},
        {<<"uppercase">>, [
            [
                {starts_with, [<<"https://">>, <<"http://">>]}
            ]
        ]},
        {<<"leading_space">>, [
            {starts_with, [<<"https://">>, <<"http://">>]}
        ]},
        {<<"shorter_than_prefix">>, [
            {starts_with, [<<"https://">>, <<"http://">>]}
        ]},
        {<<"prefix_in_the_middle">>, [
            {starts_with, <<"ID-">>}
        ]},
        {<<"number">>, [
            {starts_with, <<"12">>}
        ]},
        {<<"number_string_form">>, [
            {starts_with, <<"1.0">>}
        ]},
        {<<"boolean">>, [
            {starts_with, <<"tr">>}
        ]},
        {<<"minus_zero">>, [
            {starts_with, <<"-">>}
        ]},
        {<<"exponent">>, [
            {starts_with, <<"1e">>}
        ]},
        {<<"fraction_without_leading_zero">>, [
            {starts_with, <<".">>}
        ]},
        {<<"number_argument">>, [
            {starts_with, 1}
        ]},
        {<<"empty_field">>, [
            {starts_with, [<<"https://">>, <<"http://">>]}
        ]},
        {<<"null_field">>, [
            {starts_with, [<<"https://">>, <<"http://">>]}
        ]},
        {<<"value_is_hash">>, [
            {starts_with, [<<"https://">>, <<"http://">>]}
        ]},
        {<<"value_is_empty_hash">>, [
            {starts_with, [<<"https://">>, <<"http://">>]}
        ]},
        {<<"value_is_array">>, [
            {starts_with, [<<"https://">>, <<"http://">>]}
        ]},
        {<<"value_is_empty_array">>, [
            {starts_with, [<<"https://">>, <<"http://">>]}
        ]}
    ]},
    {input, [
        {<<"other_scheme">>, <<"ftp://example.com">>},
        {<<"uppercase">>, <<"HTTPS://example.com">>},
        {<<"leading_space">>, <<" https://example.com">>},
        {<<"shorter_than_prefix">>, <<"http">>},
        {<<"prefix_in_the_middle">>, <<"X-ID-1">>},
        {<<"number">>, 312},
        {<<"number_string_form">>, 1.0},
        {<<"boolean">>, false},
        {<<"minus_zero">>, -0.0},
        {<<"exponent">>, 1.0e3},
        {<<"fraction_without_leading_zero">>, 0.1},
        {<<"number_argument">>, <<"21">>},
        {<<"empty_field">>, <<>>},
        {<<"null_field">>, null},
        {<<"extra_field">>, <<"extra">>},
        {<<"value_is_hash">>, [
            {<<"test">>, 1}
        ]},
        {<<"value_is_empty_hash">>, [{}]},
        {<<"value_is_array">>, [<<"test">>, 1]},
        {<<"value_is_empty_array">>, []}
    ]},
    {errors, [
        {<<"other_scheme">>, <<"WRONG_FORMAT">>},
        {<<"uppercase">>, <<"WRONG_FORMAT">>},
        {<<"leading_space">>, <<"WRONG_FORMAT">>},
        {<<"shorter_than_prefix">>, <<"WRONG_FORMAT">>},
        {<<"prefix_in_the_middle">>, <<"WRONG_FORMAT">>},
        {<<"number">>, <<"WRONG_FORMAT">>},
        {<<"number_string_form">>, <<"WRONG_FORMAT">>},
        {<<"boolean">>, <<"WRONG_FORMAT">>},
        {<<"minus_zero">>, <<"WRONG_FORMAT">>},
        {<<"exponent">>, <<"WRONG_FORMAT">>},
        {<<"fraction_without_leading_zero">>, <<"WRONG_FORMAT">>},
        {<<"number_argument">>, <<"WRONG_FORMAT">>},
        {<<"value_is_hash">>, <<"FORMAT_ERROR">>},
        {<<"value_is_empty_hash">>, <<"FORMAT_ERROR">>},
        {<<"value_is_array">>, <<"FORMAT_ERROR">>},
        {<<"value_is_empty_array">>, <<"FORMAT_ERROR">>}
    ]}
].
