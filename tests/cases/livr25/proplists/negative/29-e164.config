%% Imported for liver; iso_date outputs use Erlang {Y,M,D} dates.
%% Proplist fixtures preserve JSON key order from json:decode/3.

[
    {name, e164},
    {rules, [
        {<<"leading_zero">>, e164},
        {<<"too_short">>, [e164]},
        {<<"too_long">>, [
            {e164, []}
        ]},
        {<<"without_plus">>, e164},
        {<<"double_plus">>, e164},
        {<<"international_prefix">>, e164},
        {<<"spaces">>, e164},
        {<<"dashes">>, e164},
        {<<"parentheses">>, e164},
        {<<"letters">>, e164},
