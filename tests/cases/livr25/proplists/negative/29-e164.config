        {<<"arabic_indic_digits">>, e164},
        {<<"fullwidth_digit">>, e164},
        {<<"fullwidth_plus">>, e164},
        {<<"trailing_crlf">>, e164},
        {<<"leading_newline">>, e164},
        {<<"boolean_true">>, e164},
        {<<"boolean_false">>, e164},
        {<<"empty_field">>, e164},
        {<<"null_field">>, e164},
        {<<"value_is_hash">>, e164},
        {<<"value_is_empty_hash">>, e164},
        {<<"value_is_array">>, e164},
        {<<"value_is_empty_array">>, e164}
    ]},
    {input, [
        {<<"leading_zero">>, <<"+0123456">>},
        {<<"too_short">>, <<"+123456">>},
        {<<"too_long">>, <<"+1234567890123456">>},
        {<<"without_plus">>, <<"15555550100">>},
        {<<"double_plus">>, <<"++15555550100">>},
        {<<"international_prefix">>, <<"0015555550100">>},
        {<<"spaces">>, <<"+1 555 555 0100">>},
        {<<"dashes">>, <<"+1-555-555-0100">>},
        {<<"parentheses">>, <<"+1(555)5550100">>},
        {<<"letters">>, <<"+1555CALLNOW">>},
        {<<"trailing_newline">>, <<"+15555550100\n">>},
        {<<"number">>, 15555550100},
        {<<"arabic_indic_digits">>, <<"+١٥٥٥٥٥٥٠١٠٠"/utf8>>},
        {<<"fullwidth_digit">>, <<"+１5555550100"/utf8>>},
        {<<"fullwidth_plus">>, <<"＋15555550100"/utf8>>},
        {<<"trailing_crlf">>, <<"+15555550100\r\n">>},
        {<<"leading_newline">>, <<"\n+15555550100">>},
        {<<"boolean_true">>, true},
        {<<"boolean_false">>, false},
        {<<"empty_field">>, <<>>},
        {<<"null_field">>, null},
        {<<"extra_field">>, <<"extra">>},
        {<<"value_is_hash">>, [
            {<<"test">>, 1}
        ]},
        {<<"value_is_empty_hash">>, [{}]},
        {<<"value_is_array">>, [<<"test">>, 1]},
        {<<"value_is_empty_array">>, []}
    ]},
    {errors, [
        {<<"leading_zero">>, <<"WRONG_E164">>},
        {<<"too_short">>, <<"WRONG_E164">>},
        {<<"too_long">>, <<"WRONG_E164">>},
        {<<"without_plus">>, <<"WRONG_E164">>},
        {<<"double_plus">>, <<"WRONG_E164">>},
        {<<"international_prefix">>, <<"WRONG_E164">>},
        {<<"spaces">>, <<"WRONG_E164">>},
        {<<"dashes">>, <<"WRONG_E164">>},
        {<<"parentheses">>, <<"WRONG_E164">>},
        {<<"letters">>, <<"WRONG_E164">>},
        {<<"trailing_newline">>, <<"WRONG_E164">>},
        {<<"number">>, <<"WRONG_E164">>},
        {<<"arabic_indic_digits">>, <<"WRONG_E164">>},
        {<<"fullwidth_digit">>, <<"WRONG_E164">>},
        {<<"fullwidth_plus">>, <<"WRONG_E164">>},
        {<<"trailing_crlf">>, <<"WRONG_E164">>},
        {<<"leading_newline">>, <<"WRONG_E164">>},
        {<<"boolean_true">>, <<"WRONG_E164">>},
        {<<"boolean_false">>, <<"WRONG_E164">>},
        {<<"value_is_hash">>, <<"FORMAT_ERROR">>},
        {<<"value_is_empty_hash">>, <<"FORMAT_ERROR">>},
        {<<"value_is_array">>, <<"FORMAT_ERROR">>},
        {<<"value_is_empty_array">>, <<"FORMAT_ERROR">>}
    ]}
