%% LIVR negative/25-digest (case: digest, form: proplists)
%% Source: https://github.com/koorchik/LIVR/tree/14e5a1b19011d3e9bf6ab5a6a0dd4444bea8b280/test_suite_2.5/negative/25-digest
%% Imported for liver; iso_date outputs use Erlang {Y,M,D} dates.
%% Proplist fixtures preserve JSON key order from json:decode/3.

[
    {name, digest},
    {rules, [
        {<<"md5_given_sha1">>, [
            {digest, <<"md5">>}
        ]},
        {<<"md5_too_long">>, [
            [
                {digest, <<"md5">>}
            ]
        ]},
        {<<"md5_too_short">>, [
            {digest, <<"md5">>}
        ]},
        {<<"md5_not_hex">>, [
            {digest, <<"md5">>}
        ]},
        {<<"md5_prefix">>, [
            {digest, <<"md5">>}
        ]},
        {<<"sha1_given_md5">>, [
            {digest, <<"sha1">>}
        ]},
        {<<"sha256_given_sha512">>, [
            {digest, <<"sha256">>}
        ]},
        {<<"sha256_too_short">>, [
            {digest, <<"sha256">>}
        ]},
        {<<"sha384_given_sha256">>, [
            {digest, <<"sha384">>}
        ]},
        {<<"sha512_given_sha384">>, [
            {digest, <<"sha512">>}
        ]},
        {<<"md5_or_sha256_given_sha1">>, [
            {digest, [<<"md5">>, <<"sha256">>]}
        ]},
        {<<"number">>, [
            {digest, <<"md5">>}
        ]},
        {<<"md5_trailing_newline">>, [
            {digest, <<"md5">>}
        ]},
        {<<"sha1_trailing_newline">>, [
            {digest, [<<"md5">>, <<"sha1">>]}
        ]},
        {<<"md5_arabic_indic_digit">>, [
            {digest, <<"md5">>}
        ]},
        {<<"md5_fullwidth_letter">>, [
            {digest, <<"md5">>}
        ]},
        {<<"md5_with_spaces">>, [
            {digest, <<"md5">>}
        ]},
        {<<"all_algorithms_odd_length">>, [
            {digest, [<<"md5">>, <<"sha1">>, <<"sha256">>, <<"sha384">>, <<"sha512">>]}
        ]},
        {<<"boolean_true">>, [
            {digest, <<"md5">>}
        ]},
        {<<"boolean_false">>, [
            {digest, <<"md5">>}
        ]},
        {<<"empty_field">>, [
            {digest, <<"md5">>}
        ]},
        {<<"null_field">>, [
            {digest, <<"md5">>}
        ]},
        {<<"value_is_hash">>, [
            {digest, <<"md5">>}
        ]},
        {<<"value_is_empty_hash">>, [
            {digest, <<"md5">>}
        ]},
        {<<"value_is_array">>, [
            {digest, <<"md5">>}
        ]},
        {<<"value_is_empty_array">>, [
            {digest, <<"md5">>}
        ]}
    ]},
    {input, [
        {<<"md5_given_sha1">>, <<"aaf4c61ddcc5e8a2dabede0f3b482cd9aea9434d">>},
        {<<"md5_too_long">>, <<"5d41402abc4b2a76b9719d911017c592a">>},
        {<<"md5_too_short">>, <<"5d41402abc4b2a76b9719d911017c59">>},
        {<<"md5_not_hex">>, <<"5d41402abc4b2a76b9719d911017c59g">>},
        {<<"md5_prefix">>, <<"0x5d41402abc4b2a76b9719d911017c592">>},
        {<<"sha1_given_md5">>, <<"5d41402abc4b2a76b9719d911017c592">>},
        {<<"sha256_given_sha512">>, <<"9b71d224bd62f3785d96d46ad3ea3d73319bfbc2890caadae2dff72519673ca72323c3d99ba5c11d7c7acc6e14b8c5da0c4663475c2e5c3adef46f73bcdec043">>},
        {<<"sha256_too_short">>, <<"2cf24dba5fb0a30e26e83b2ac5b9e29e1b161e5c1fa7425e73043362938b982">>},
        {<<"sha384_given_sha256">>, <<"2cf24dba5fb0a30e26e83b2ac5b9e29e1b161e5c1fa7425e73043362938b9824">>},
        {<<"sha512_given_sha384">>, <<"59e1748777448c69de6b800d7a33bbfb9ff1b463e44354c3553bcdb9c666fa90125a3c79f90397bdf5f6a13de828684f">>},
        {<<"md5_or_sha256_given_sha1">>, <<"aaf4c61ddcc5e8a2dabede0f3b482cd9aea9434d">>},
        {<<"number">>, 12345},
        {<<"md5_trailing_newline">>, <<"5d41402abc4b2a76b9719d911017c592\n">>},
        {<<"sha1_trailing_newline">>, <<"aaf4c61ddcc5e8a2dabede0f3b482cd9aea9434d\n">>},
        {<<"md5_arabic_indic_digit">>, <<"5d41402abc4b2a76b9719d911017c٥92"/utf8>>},
        {<<"md5_fullwidth_letter">>, <<"5d41402abc4b2a76b9719d911017cｆ92"/utf8>>},
        {<<"md5_with_spaces">>, <<"5d41402a bc4b2a76 b9719d91 1017c592">>},
        {<<"all_algorithms_odd_length">>, <<"5d41402abc4b2a76b9719d911017c5925">>},
        {<<"boolean_true">>, true},
        {<<"boolean_false">>, false},
        {<<"empty_field">>, <<>>},
        {<<"null_field">>, null},
        {<<"extra_field">>, <<"extra">>},
        {<<"value_is_hash">>, [
            {<<"test">>, 1}
        ]},
        {<<"value_is_empty_hash">>, [{}]},
        {<<"value_is_array">>, [<<"test">>, 1]},
        {<<"value_is_empty_array">>, []}
    ]},
    {errors, [
        {<<"md5_given_sha1">>, <<"WRONG_DIGEST">>},
        {<<"md5_too_long">>, <<"WRONG_DIGEST">>},
        {<<"md5_too_short">>, <<"WRONG_DIGEST">>},
        {<<"md5_not_hex">>, <<"WRONG_DIGEST">>},
        {<<"md5_prefix">>, <<"WRONG_DIGEST">>},
        {<<"sha1_given_md5">>, <<"WRONG_DIGEST">>},
        {<<"sha256_given_sha512">>, <<"WRONG_DIGEST">>},
        {<<"sha256_too_short">>, <<"WRONG_DIGEST">>},
        {<<"sha384_given_sha256">>, <<"WRONG_DIGEST">>},
        {<<"sha512_given_sha384">>, <<"WRONG_DIGEST">>},
        {<<"md5_or_sha256_given_sha1">>, <<"WRONG_DIGEST">>},
        {<<"number">>, <<"WRONG_DIGEST">>},
        {<<"md5_trailing_newline">>, <<"WRONG_DIGEST">>},
        {<<"sha1_trailing_newline">>, <<"WRONG_DIGEST">>},
        {<<"md5_arabic_indic_digit">>, <<"WRONG_DIGEST">>},
        {<<"md5_fullwidth_letter">>, <<"WRONG_DIGEST">>},
        {<<"md5_with_spaces">>, <<"WRONG_DIGEST">>},
        {<<"all_algorithms_odd_length">>, <<"WRONG_DIGEST">>},
        {<<"boolean_true">>, <<"WRONG_DIGEST">>},
        {<<"boolean_false">>, <<"WRONG_DIGEST">>},
        {<<"value_is_hash">>, <<"FORMAT_ERROR">>},
        {<<"value_is_empty_hash">>, <<"FORMAT_ERROR">>},
        {<<"value_is_array">>, <<"FORMAT_ERROR">>},
        {<<"value_is_empty_array">>, <<"FORMAT_ERROR">>}
    ]}
].
