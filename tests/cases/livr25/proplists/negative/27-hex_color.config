%% LIVR negative/27-hex_color (case: hex_color, form: proplists)
%% Source: https://github.com/koorchik/LIVR/tree/14e5a1b19011d3e9bf6ab5a6a0dd4444bea8b280/test_suite_2.5/negative/27-hex_color
%% Imported for liver; iso_date outputs use Erlang {Y,M,D} dates.
%% Proplist fixtures preserve JSON key order from json:decode/3.

[
    {name, hex_color},
    {rules, [
        {<<"without_hash">>, hex_color},
        {<<"one">>, [hex_color]},
        {<<"two">>, [
            {hex_color, []}
        ]},
        {<<"five">>, hex_color},
        {<<"seven">>, hex_color},
        {<<"nine">>, hex_color},
        {<<"not_hex">>, hex_color},
        {<<"double_hash">>, hex_color},
        {<<"color_name">>, hex_color},
        {<<"only_hash">>, hex_color},
        {<<"number">>, hex_color},
        {<<"trailing_newline">>, hex_color},
        {<<"six_trailing_newline">>, hex_color},
        {<<"arabic_indic_digits">>, hex_color},
        {<<"fullwidth_letters">>, hex_color},
        {<<"leading_space">>, hex_color},
        {<<"boolean_true">>, hex_color},
        {<<"boolean_false">>, hex_color},
        {<<"empty_field">>, hex_color},
        {<<"null_field">>, hex_color},
        {<<"value_is_hash">>, hex_color},
        {<<"value_is_empty_hash">>, hex_color},
        {<<"value_is_array">>, hex_color},
        {<<"value_is_empty_array">>, hex_color}
    ]},
    {input, [
        {<<"without_hash">>, <<"fff">>},
        {<<"one">>, <<"#f">>},
        {<<"two">>, <<"#ff">>},
        {<<"five">>, <<"#fffff">>},
        {<<"seven">>, <<"#fffffff">>},
        {<<"nine">>, <<"#123456789">>},
        {<<"not_hex">>, <<"#ggg">>},
        {<<"double_hash">>, <<"##fff">>},
        {<<"color_name">>, <<"red">>},
        {<<"only_hash">>, <<"#">>},
        {<<"number">>, 123},
        {<<"trailing_newline">>, <<"#fff\n">>},
        {<<"six_trailing_newline">>, <<"#a1b2c3\n">>},
        {<<"arabic_indic_digits">>, <<"#١٢٣"/utf8>>},
        {<<"fullwidth_letters">>, <<"#ｆｆｆ"/utf8>>},
        {<<"leading_space">>, <<" #fff">>},
        {<<"boolean_true">>, true},
        {<<"boolean_false">>, false},
        {<<"empty_field">>, <<>>},
        {<<"null_field">>, null},
        {<<"extra_field">>, <<"extra">>},
        {<<"value_is_hash">>, [
            {<<"test">>, 1}
        ]},
        {<<"value_is_empty_hash">>, [{}]},
        {<<"value_is_array">>, [<<"test">>, 1]},
        {<<"value_is_empty_array">>, []}
    ]},
    {errors, [
        {<<"without_hash">>, <<"WRONG_HEX_COLOR">>},
        {<<"one">>, <<"WRONG_HEX_COLOR">>},
        {<<"two">>, <<"WRONG_HEX_COLOR">>},
        {<<"five">>, <<"WRONG_HEX_COLOR">>},
        {<<"seven">>, <<"WRONG_HEX_COLOR">>},
        {<<"nine">>, <<"WRONG_HEX_COLOR">>},
        {<<"not_hex">>, <<"WRONG_HEX_COLOR">>},
        {<<"double_hash">>, <<"WRONG_HEX_COLOR">>},
        {<<"color_name">>, <<"WRONG_HEX_COLOR">>},
        {<<"only_hash">>, <<"WRONG_HEX_COLOR">>},
        {<<"number">>, <<"WRONG_HEX_COLOR">>},
        {<<"trailing_newline">>, <<"WRONG_HEX_COLOR">>},
        {<<"six_trailing_newline">>, <<"WRONG_HEX_COLOR">>},
        {<<"arabic_indic_digits">>, <<"WRONG_HEX_COLOR">>},
        {<<"fullwidth_letters">>, <<"WRONG_HEX_COLOR">>},
        {<<"leading_space">>, <<"WRONG_HEX_COLOR">>},
        {<<"boolean_true">>, <<"WRONG_HEX_COLOR">>},
        {<<"boolean_false">>, <<"WRONG_HEX_COLOR">>},
        {<<"value_is_hash">>, <<"FORMAT_ERROR">>},
        {<<"value_is_empty_hash">>, <<"FORMAT_ERROR">>},
        {<<"value_is_array">>, <<"FORMAT_ERROR">>},
        {<<"value_is_empty_array">>, <<"FORMAT_ERROR">>}
    ]}
].
