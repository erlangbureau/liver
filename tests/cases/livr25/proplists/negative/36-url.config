%% LIVR negative/36-url (case: url, form: proplists)
%% Source: https://github.com/koorchik/LIVR/tree/44955f198e7cbd2d6ec2fb1926c9fe8bd2e5628d/test_suite_2.5/negative/36-url
%% Imported for liver; iso_date outputs use Erlang {Y,M,D} dates.
%% Proplist fixtures preserve JSON key order from json:decode/3.

[
    {name, url},
    {rules, [
        {<<"google_dot">>, url},
        {<<"trailing_dot">>, [url]},
        {<<"trailing_dot_path">>, [
            {url, []}
        ]},
        {<<"trailing_dot_port">>, url},
        {<<"trailing_dot_query">>, url},
        {<<"ipv4_trailing_dot">>, url},
        {<<"label_64">>, url},
        {<<"tld_64">>, url},
        {<<"port_65536">>, url},
        {<<"port_99999">>, url},
        {<<"port_six_digits">>, url},
        {<<"empty_field">>, url}
    ]},
    {input, [
        {<<"google_dot">>, <<"https://www.google.">>},
        {<<"trailing_dot">>, <<"https://example.com.">>},
        {<<"trailing_dot_path">>, <<"https://example.com./path">>},
        {<<"trailing_dot_port">>, <<"https://example.com.:8080">>},
        {<<"trailing_dot_query">>, <<"https://example.com.?q=1">>},
        {<<"ipv4_trailing_dot">>, <<"http://192.0.2.1./">>},
        {<<"label_64">>, <<"https://aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.example.com/">>},
        {<<"tld_64">>, <<"https://example.aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa">>},
        {<<"port_65536">>, <<"https://example.com:65536">>},
        {<<"port_99999">>, <<"https://example.com:99999/">>},
        {<<"port_six_digits">>, <<"https://example.com:123456">>},
        {<<"empty_field">>, <<>>},
        {<<"extra_field">>, <<"aaaa">>}
    ]},
    {errors, [
        {<<"google_dot">>, <<"WRONG_URL">>},
        {<<"trailing_dot">>, <<"WRONG_URL">>},
        {<<"trailing_dot_path">>, <<"WRONG_URL">>},
        {<<"trailing_dot_port">>, <<"WRONG_URL">>},
        {<<"trailing_dot_query">>, <<"WRONG_URL">>},
        {<<"ipv4_trailing_dot">>, <<"WRONG_URL">>},
        {<<"label_64">>, <<"WRONG_URL">>},
        {<<"tld_64">>, <<"WRONG_URL">>},
        {<<"port_65536">>, <<"WRONG_URL">>},
        {<<"port_99999">>, <<"WRONG_URL">>},
        {<<"port_six_digits">>, <<"WRONG_URL">>}
    ]}
].
