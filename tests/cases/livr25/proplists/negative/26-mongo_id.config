        {<<"object_id_call">>, <<"ObjectId(\"507f1f77bcf86cd799439011\")">>},
        {<<"number">>, 123},
        {<<"trailing_newline">>, <<"507f1f77bcf86cd799439011\n">>},
        {<<"arabic_indic_digit">>, <<"507f1f77bcf86cd79943901١"/utf8>>},
        {<<"fullwidth_letter">>, <<"507ｆ1f77bcf86cd799439011"/utf8>>},
        {<<"boolean_true">>, true},
        {<<"boolean_false">>, false},
        {<<"empty_field">>, <<>>},
        {<<"null_field">>, null},
        {<<"extra_field">>, <<"extra">>},
        {<<"value_is_hash">>, [
            {<<"test">>, 1}
        ]},
        {<<"value_is_empty_hash">>, [{}]},
        {<<"value_is_array">>, [<<"test">>, 1]},
        {<<"value_is_empty_array">>, []}
