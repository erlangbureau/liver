        {<<"value_is_empty_hash">>, mongo_id},
        {<<"value_is_array">>, mongo_id},
        {<<"value_is_empty_array">>, mongo_id}
    ]},
    {input, [
        {<<"too_short">>, <<"507f1f77bcf86cd79943901">>},
        {<<"too_long">>, <<"507f1f77bcf86cd7994390111">>},
        {<<"not_hex">>, <<"507f1f77bcf86cd79943901z">>},
